#!/bin/bash
# omabackup -- dotfile backup with verified coverage and a declared restore
# range. The heavy lifting lives here, outside QML: an error inside quickshell
# takes down the bar, the dock and the menu at once, and restoring has to work
# when there is no shell at all.
#
# Usage: omabackup <collect|verify|status> [--json] [--groups a,b]

set -uo pipefail

# Machine config, read by everyone rather than by systemd alone.
#
# OMABACKUP_REPO lives in ~/.config/omabackup/env, and until now only the units
# loaded it, through EnvironmentFile=. Every other caller got nothing: a human
# in a terminal, and the QML panel running `status --json`, both saw no repo --
# so no github destination and an empty repo field, on a machine that had been
# backing up hourly all day. One fact, loaded in one place, absent everywhere
# else.
#
# An allow-list, not "any OMABACKUP_*". The file may say WHERE this machine's
# backup lives; it may not say which rules apply to it or which binaries run.
# Without this, one line pointing OMABACKUP_SECRETS_DENY at a toothless
# deny-list disabled the secret scanner silently -- reproduced, with a private
# key reaching the remote. Not a privilege escalation (whoever can write that
# file can write ~/.bashrc), but a security control a config line switches off
# without a word is worth refusing on its own.
#
# Parsed as KEY=VALUE data, never sourced. systemd's EnvironmentFile is not a
# script, and sourcing it would hand anything able to write that path a shell
# running as the user, on a timer. An already-set variable always wins, so an
# explicit override still overrides.
# REPO and DESTINATIONS only: those name WHERE this machine's backup goes.
#
# GROUPS was admitted here on the reasoning that it is machine identity. It is
# not -- the manifest decides WHAT gets collected, which is policy, and an env
# line pointing at a wider manifest staged a private key. STATE is the same
# shape one step along: it is the parent of the staging directory that every
# collect clears with rm -rf. Both stay settable from the real environment,
# which is where the specs set them.
ENV_FILE_ALLOWED='OMABACKUP_REPO OMABACKUP_DESTINATIONS' 

_load_env_file() {
    local f="${OMABACKUP_ENV:-$HOME/.config/omabackup/env}" line k v
    [[ -r "$f" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*[#$] ]] && continue
        [[ "$line" =~ ^[[:space:]]*(OMABACKUP_[A-Z0-9_]+)=(.*)$ ]] || continue
        k="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
        if [[ ${#v} -ge 2 && ${v:0:1} == '"' && ${v: -1} == '"' ]]; then
            v="${v:1:${#v}-2}"
        elif [[ ${#v} -ge 2 && ${v:0:1} == "'" && ${v: -1} == "'" ]]; then
            v="${v:1:${#v}-2}"
        fi
        [[ " $ENV_FILE_ALLOWED " == *" $k "* ]] || {
            # Plain text, no colours and no _tilde: this runs before either
            # exists, and under `set -u` reaching for them would kill the CLI
            # on startup for every user with an unusual line in that file.
            printf 'omabackup: %s ignored in %s -- that file sets where the backup lives, not which rules apply\n' \
                "$k" "$f" >&2
            continue
        }
        [[ -n "${!k:-}" ]] && continue
        export "$k=$v"
    done <"$f"
}
_load_env_file

OMABACKUP_ROOT="${OMABACKUP_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OMABACKUP_STATE="${OMABACKUP_STATE:-$HOME/.local/state/omabackup}"
GROUPS_FILE="${OMABACKUP_GROUPS:-$OMABACKUP_ROOT/groups.default.json}"
# Machine identity, not project data: a NAS path or a drive UUID has no place
# in the public manifest. Same class as OMABACKUP_REPO.
DESTINATIONS_FILE="${OMABACKUP_DESTINATIONS:-$HOME/.config/omabackup/destinations.json}"
# Versioned, unlike destinations: secret shapes are generic, and §6 wants the
# exceptions reviewable by whoever reads the repo next.
SECRETS_DENY_FILE="${OMABACKUP_SECRETS_DENY:-$OMABACKUP_ROOT/secrets.deny.json}"
TOOL_MANIFEST="$OMABACKUP_ROOT/manifest.json"
STAGING="$OMABACKUP_STATE/staging"
LAST_SYNC_FILE="$OMABACKUP_STATE/last-sync"
# What each group actually covers, written by collect and read by verify --json
# for the panel's Grupos section. Written rather than recomputed: collect is
# what decides which files enter the backup -- excludes, tracked-only rules and
# all -- and counting them a second time elsewhere would be the same fact stated
# twice, which is how the scripts group once vanished and how retention once
# stopped. The number here is the staged set, by construction.
COVERAGE_FILE="$OMABACKUP_STATE/coverage.json"
# A day. DESIGN.md §4 offers schedules from 5 minutes to daily, and the CLI
# cannot see which one the timer uses -- but a full day with no successful run
# is worth surfacing on any of them, and it tolerates a laptop shut overnight.
STALE_AFTER_SEC=86400

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; DIM=$'\033[2m'; NC=$'\033[0m'

JSON=0; ONLY=""
FINDINGS=()   # level\tgroup\tcode\tmessage\tpath

die() { printf '%somabackup: %s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }

_tilde() { printf '%s' "${1/#$HOME/\~}"; }

# The manifest is the single source of truth for the installed plugin version.
# The panel reads it through `status --json`, so the UI never duplicates a
# version string in QML. A missing or malformed manifest is reported as
# unknown rather than turning a read-only status check into a false version.
_tool_version() {
    jq -er '.version | strings | select(length > 0)' "$TOOL_MANIFEST" 2>/dev/null \
        || printf 'unknown'
}
# A trailing slash on a declared path (an easy typo: "~/.local/bin/" instead
# of "~/.local/bin") used to ride straight through every consumer of this
# function's output. It broke restore's forward-move held check
# (".../omarchy//migrations", fixed in 23c300a) and, confirmed separately,
# silently dropped an entire trackedRepoPath group from publish: the prefix
# built from it became ".local/bin/" and every real file's rel path
# ("`.local/bin/foo`", one slash) failed to match ".local/bin//"* (two).
# publish_staging returned 0, published 0 files, and the repo stayed stale
# with no error. Stripped once, here, rather than at each of the many places
# that read this function's output -- the same reasoning DESIGN.md already
# gives for _path_contained being general instead of copied per caller.
_expand() {
    local e="${1/#\~/$HOME}"
    # ${e%/} strips exactly one trailing slash -- confirmed insufficient on
    # its own: "~/.local/bin//" (two) reproduced the identical silently-
    # dropped-group bug through the one slash ${e%/} left behind. Looped so
    # any number of trailing slashes is gone, not just the first.
    while [[ "$e" == */ ]]; do e="${e%/}"; done
    printf '%s' "$e"
}

# `uname -n`, never `hostname`: the latter ships in `inetutils`, which nothing
# on a stock Omarchy requires -- on this machine it is "Explicitly installed /
# Required By: None", present only because somebody typed it. `uname` is
# coreutils, which `base` requires, so it cannot be missing. This name goes into
# the bundle filename AND into the pattern retention deletes by, so a machine
# without inetutils would have written one name and pruned by another.
_hostname() { uname -n 2>/dev/null || printf 'unknown-host'; }

# §4: "the badge does not clear itself: a stale backup stays visible until it is
# dealt with." The panel could already say "nothing is scheduled"; it could not
# say "the timer exists and the last successful run was three days ago", which
# is the worse of the two because everything stays green while it happens.
#
# Recorded on any successful sync, not only on one that committed: a run that
# found nothing to do still proves the backup is working, and counting only
# commits would call a healthy idle machine stale.
# Returns non-zero when the marker could not be written. It used to swallow
# every failure and return success, so a backup announced itself as done while
# the thing that records "it happened" never changed -- and the next run would
# then call the machine stale for a backup that had actually run.
record_sync_success() {
    mkdir -p "$(dirname "$LAST_SYNC_FILE")" 2>/dev/null || return 1
    printf '%s' "$(date +%s)" >"$LAST_SYNC_FILE.tmp" 2>/dev/null || return 1
    mv "$LAST_SYNC_FILE.tmp" "$LAST_SYNC_FILE" 2>/dev/null || return 1
}

# The stamp itself, only when it is a number. Handing jq the file's raw
# contents meant a marker holding anything else killed jq and `status --json`
# emitted NOTHING -- and the panel, which only parses non-empty output, then
# kept showing whatever it had read last, indefinitely and without an error.
last_sync_stamp() {
    local at
    [[ -s "$LAST_SYNC_FILE" ]] || return 1
    at="$(cat "$LAST_SYNC_FILE" 2>/dev/null)"
    [[ "$at" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "$at"
}

# Prints the age in seconds, or nothing when it has never run.
last_sync_age() {
    local at
    [[ -s "$LAST_SYNC_FILE" ]] || return 1
    at="$(cat "$LAST_SYNC_FILE" 2>/dev/null)"
    [[ "$at" =~ ^[0-9]+$ ]] || return 1
    printf '%s' "$(( $(date +%s) - at ))"
}

is_stale() {
    local age
    # Never having run is stale. Reporting it as fresh would make a machine that
    # has never backed anything up look exactly like one that just did. A stamp
    # dated in the future is not freshness either -- a clock stepping backwards
    # would otherwise report a healthy backup indefinitely without one running.
    age="$(last_sync_age)" || return 0
    (( age < 0 )) && return 0
    (( age > STALE_AFTER_SEC ))
}

# What this tool needs that a stock Omarchy does not guarantee.
#
# `jq` and `git` are direct dependencies of the `omarchy` package itself, so
# they exist anywhere this plugin can be installed. coreutils, findutils, sed,
# gawk, tar and systemd come from Arch `base`. `rsync` and `zstd` come from
# neither -- no omarchy script uses either one -- so a clean install can lack
# them. Checked per command rather than up front: `verify` is the one that has
# to work on a recovery tty, and refusing to report coverage because the machine
# cannot compress an archive would be its own kind of nonsense.
_pkg_for() {
    case "$1" in
        rsync) printf 'rsync' ;;
        zstd)  printf 'zstd' ;;
        jq)    printf 'jq' ;;
        git)   printf 'git' ;;
        tar)   printf 'tar' ;;
        *)     printf '%s' "$1" ;;
    esac
}

require_tools() {
    local t missing=() pkgs=()
    for t in "$@"; do
        command -v "$t" >/dev/null 2>&1 || { missing+=("$t"); pkgs+=("$(_pkg_for "$t")"); }
    done
    (( ${#missing[@]} )) || return 0
    printf '%somabackup: missing required %s: %s%s\n' \
        "$RED" "$([[ ${#missing[@]} -gt 1 ]] && echo tools || echo tool)" "${missing[*]}" "$NC" >&2
    printf '  install with: %spacman -S %s%s\n' "$CYAN" "${pkgs[*]}" "$NC" >&2
    exit 1
}

finding() {
    FINDINGS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"${5:-}")
}

# ── group manifest ───────────────────────────────────────────────────────────
# _assert_groups_filter_understood
# --groups is a typo away from silently meaning "all groups excluded" once
# groups_ids matches by exact id: the old substring match let a near-miss like
# "compositr" still catch "compositor" by accident, which hid this. An id
# named in --groups that the manifest does not have is refused rather than
# quietly selecting nothing.
# Prints nothing and returns 0 when every requested id exists; on a miss,
# prints the offending id and returns 1 -- the caller decides how to die,
# since one call site needs to clean up an extraction first and the other does
# not.
_assert_groups_filter_understood() {
    [[ -n "$ONLY" ]] || return 0
    local want known_out
    local -a known=() wanted=()
    # Captured and checked before populating the array, not fed straight into
    # `mapfile -t known < <(...)` -- a process substitution's exit status is
    # not observable at the `<` that closes it, so a jq failure here (an
    # unreadable manifest, exactly the case this whole function exists to
    # gate on) used to leave `known` simply empty, indistinguishable from a
    # manifest that genuinely declares no groups. A review round's PoC (a jq
    # wrapper failing only this one query) confirmed the result: --groups
    # naming a real group still passed, because "unknown, could not check"
    # and "known, and it is there" both read as the loop finding nothing to
    # object to.
    known_out="$(jq -r '.groups[]?.id // empty' "$GROUPS_FILE" 2>/dev/null)" || {
        printf 'could not read this manifest'"'"'s own group ids at all'
        return 1
    }
    mapfile -t known <<<"$known_out"
    IFS=',' read -r -a wanted <<<"$ONLY"
    for want in "${wanted[@]}"; do
        [[ -n "$want" ]] || continue
        printf '%s\n' "${known[@]}" | grep -qxF "$want" || { printf '%s' "$want"; return 1; }
    done
    return 0
}

groups_ids() {
    # Split on comma and matched exactly, not `inside`. `.id | inside($only)`
    # asks whether the id is a SUBSTRING of the raw --groups value, which let
    # `--groups shellrc` also select `shell` (id "shell" is a substring of
    # "shellrc") -- restore inherited this the moment it started filtering by
    # $ONLY like every other command, and a filter meant to narrow one group
    # silently pulled in another.
    #
    # An id containing a tab or newline is refused here, in jq itself, before
    # any of them ever become a line of output -- restore_rows prints `$id`
    # unescaped as one field of a tab-separated row, and bin/omabackup's own
    # apply loop parses that row back with `read -r a g rel dest`. A PoC
    # confirmed the result: an id of "base<TAB>../../../../etc/hostname<TAB>
    # x/victim" turned ONE row into six fields instead of four, and the
    # attacker-chosen "../../../../etc/hostname" landed in `rel` -- the field
    # _restore_one uses to build its READ path. Checking for the embedded
    # byte after `jq -r` has already flattened everything to newline-
    # separated text is too late: an id with an embedded NEWLINE would
    # already look like two ordinary ids by then, indistinguishable from a
    # manifest that just happens to declare two groups. Checked here, against
    # the JSON string itself, before that flattening ever happens.
    jq -r --arg only "$ONLY" '
        if any(.groups[]?; (.enabled != false) and ((.id // "") | test("[\t\n]")))
        then error("a group id contains a tab or newline")
        else
            ($only | if . == "" then [] else split(",") end) as $ids
            | .groups
            | map(select(.enabled != false))
            | map(select(($ids | length) == 0 or (.id as $i | $ids | index($i) != null)))
            | .[].id
        end' "$GROUPS_FILE"
}
# `select(.enabled != false)` on all three -- the same filter groups_ids()
# already applies -- and not an accident of style: a review round found that
# without it, a manifest declaring two objects with the SAME id (one
# enabled, one not) made these functions return BOTH matches concatenated by
# jq -r's one-line-per-match output, silently merging a disabled group's
# `mode`/`paths` into whatever the caller expected to be a single enabled
# group's own value. A PoC artifact with an enabled group "g" and a second
# object also declaring "id":"g" but "enabled":false confirmed the result: a
# `restore` plan produced by the enabled group's compatible mode still
# included the DISABLED entry's paths, restoring content the manifest says
# should not participate at all. groups_ids() itself already filtered this
# way; these three never did, despite every caller assuming an id it got
# FROM groups_ids() names exactly one group.
group_field() { jq -r --arg id "$1" --arg f "$2" \
    '.groups[] | select(.id==$id and .enabled != false) | .[$f] // empty' "$GROUPS_FILE"; }
group_paths() {
    jq -r --arg id "$1" '.groups[] | select(.id==$id and .enabled != false) |
        (.paths // [])[] | if type=="object" then .live else . end' "$GROUPS_FILE"
}
# The repo subdirectory a trackedOnly path should be checked against, e.g.
# ~/.local/bin -> scripts/local-bin. Empty when the entry has no override.
group_tracked_repo_path() {
    jq -r --arg id "$1" --arg live "$2" '.groups[] | select(.id==$id and .enabled != false) |
        (.paths // [])[] | select(type=="object" and .live==$live) | .trackedRepoPath // empty' "$GROUPS_FILE"
}

# The staging -> repo mapping for every path the manifest gave a
# trackedRepoPath, as `<prefix-relative-to-HOME>\t<repo-path>` lines handed to
# publish_staging. The manifest is the single source of truth for where a
# tracked-only path lands: lib/publish.sh used to repeat one of these
# destinations as a literal and refuse the rest, which dropped the whole
# `scripts` group between staging and the repo without a word. `restore` needs
# the inverse of this table, and an inverse only exists if there is one table.
tracked_path_map() {
    local id p sub e
    # groups_ids/group_paths fed a process substitution directly used to mean
    # a jq failure (a manifest this cannot read at all) looked identical to
    # "no groups, no paths" -- silence, not a status <(...) exposes. Captured
    # into checked variables instead: the exact shape of the bug the comment
    # above already names once, reachable again through the query itself
    # failing rather than the manifest genuinely lacking any trackedRepoPath.
    local ids_out; ids_out="$(groups_ids)" || return 1
    while read -r id; do
        [[ -n "$id" ]] || continue
        local paths_out; paths_out="$(group_paths "$id")" || return 1
        while read -r p; do
            [[ -n "$p" ]] || continue
            sub="$(group_tracked_repo_path "$id" "$p")" || return 1
            [[ -n "$sub" ]] || continue
            e="$(_expand "$p")"
            printf '%s\t%s\n' "${e#$HOME/}" "$sub"
        done <<<"$paths_out"
    done <<<"$ids_out"
}

# Every path declared by any group, expanded. Probes use this to answer
# "is this file covered by anyone?".
#
# jq piped straight into `while read`, previously -- the pipeline's own exit
# status is the LAST command's (the while loop, which happily reads zero
# lines and exits 0), not jq's. A manifest jq could not read at all produced
# the same empty output as one that genuinely declares nothing, and every
# caller below read that silence as "nothing declared" rather than "this
# could not be answered". Captured first, checked, THEN looped.
all_declared_paths() {
    local out; out="$(jq -r '(.groups[] | (.paths // [])[])' "$GROUPS_FILE")" || return 1
    local p
    [[ -n "$out" ]] && while read -r p; do _expand "$p"; echo; done <<<"$out"
    return 0
}

# Deliberate exclusions: known dead weight, each with a versioned reason.
# Without this the checker starts out with a dozen warnings and teaches you to
# ignore it.
all_excluded_paths() {
    local out; out="$(jq -r '(.excluded // [])[].path' "$GROUPS_FILE")" || return 1
    local p
    [[ -n "$out" ]] && while read -r p; do _expand "$p"; echo; done <<<"$out"
    return 0
}

# Returns 2 for "the exclusion list itself could not be queried" -- distinct
# from 1, "queried fine, this path is not on it" -- the same distinction
# _restore_repo_prefix already draws for the same reason: a caller must not
# treat the two the same way. `< <(all_excluded_paths)` alone, previously,
# fed the loop from a process substitution whose own exit status has no `$?`
# slot to check at all; a query failure there was silence, indistinguishable
# from a manifest with no exclusions. A PoC confirmed the result: a manifest
# excluding ~/.config/secret, with the .excluded query itself failing,
# reported "not excluded" for that path -- collect_tree below used to take
# that at face value and staged the file.
is_excluded() {
    local target="$1" ex out
    out="$(all_excluded_paths)" || return 2
    [[ -n "$out" ]] || return 1
    while read -r ex; do
        [[ -n "$ex" ]] || continue
        [[ "$target" == "$ex" || "$target" == "$ex"/* ]] && return 0
    done <<<"$out"
    return 1
}

# Same distinction, same reason: 2 for "could not be queried", 1 for
# "queried fine, not covered".
is_covered() {
    local target="$1" decl out
    out="$(all_declared_paths)" || return 2
    [[ -n "$out" ]] || return 1
    while read -r decl; do
        [[ -n "$decl" ]] || continue
        [[ "$target" == "$decl" || "$target" == "$decl"/* ]] && return 0
    done <<<"$out"
    return 1
}

# ── verify ───────────────────────────────────────────────────────────────────
# A declared path that does not exist means the group reports "up to date" while
# covering zero bytes. That is how ~/.config/omarchy/current became a phantom
# after one of Omarchy's own migrations moved the directory.
probe_declared_paths() {
    local id p e
    # groups_ids/group_paths via <(...) directly discarded a jq failure the
    # same way restore_rows once did: an unreadable manifest ran this loop
    # zero times and probe_declared_paths reported nothing wrong, rather than
    # the one thing that actually IS wrong here.
    local ids_out; ids_out="$(groups_ids)" || { finding fail manifest manifest-unreadable "this machine's own group manifest could not be read" ""; return; }
    while read -r id; do
        [[ -n "$id" ]] || continue
        local paths_out; paths_out="$(group_paths "$id")" \
            || { finding fail "$id" manifest-unreadable "this group's paths could not be read from the manifest" ""; continue; }
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || finding warn "$id" path-missing "declared but missing: $p" "$e"
        done <<<"$paths_out"
    done <<<"$ids_out"
}

# A mode:link path that stopped being a symlink stopped feeding the repo, in
# silence. The repair is NEVER `ln -sf`: that would discard the very edit that
# broke the link. See docs/DESIGN.md §11.2.
probe_link_integrity() {
    local id p e linked plain
    local ids_out; ids_out="$(groups_ids)" || { finding fail manifest manifest-unreadable "this machine's own group manifest could not be read" ""; return; }
    while read -r id; do
        # group_field's own status, checked -- a bare `[[ "$(...)" ==
        # "link" ]] || continue` treated a failed query the same as a
        # group that genuinely is not mode:link: both are empty, neither
        # equals "link", and the loop just moved on. A PoC (jq failing
        # only the --arg f mode query, for a real mode:link group whose
        # declared path had stopped being a symlink) confirmed the result:
        # verify --json reported ok=true with an empty links findings
        # list -- the check that should have caught it never ran at all.
        local gmode2; gmode2="$(group_field "$id" mode)" \
            || { finding fail "$id" manifest-unreadable "this group's mode could not be read from the manifest" ""; continue; }
        [[ "$gmode2" == "link" ]] || continue
        linked=0; plain=0
        local paths_out; paths_out="$(group_paths "$id")" \
            || { finding fail "$id" manifest-unreadable "this group's paths could not be read from the manifest" ""; continue; }
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" ]] || continue
            if [[ -L "$e" ]]; then
                linked=$((linked + 1))
            else
                plain=$((plain + 1))
            fi
        done <<<"$paths_out"
        if (( linked > 0 && plain > 0 )); then
            finding fail "$id" link-broken "$plain of $((linked+plain)) stopped being links -- the repo stopped receiving" ""
        elif (( linked > 0 )); then
            finding pass "$id" linked "$linked paths linked to the repo" ""
        elif (( plain > 0 )); then
            finding info "$id" not-linked "$plain paths, link mode not applied yet" ""
        fi
    done <<<"$ids_out"
}

omarchy_identity() {
    local v c m mdir
    v="$(omarchy-version 2>/dev/null || echo unknown)"
    c="$(omarchy-channel-current 2>/dev/null || echo unknown)"
    mdir="$HOME/.local/state/omarchy/migrations"
    if [[ ! -d "$mdir" ]]; then
        # Legitimately nothing: a fresh install has not migrated at all yet,
        # and the directory does not exist until the first migration runs.
        # This is the "behind" case restore's verdict is built to handle.
        m=0
    else
        # The directory exists, so a find failure here means something else
        # went wrong reading it -- and `| tail -1` on a pipe with no pipefail
        # would have swallowed that: tail on empty input exits 0 same as it
        # would on a real answer, and the caller could not tell "no
        # migrations" from "could not check." Distinguished with a sentinel
        # no valid migration timestamp can equal, rather than defaulting to
        # 0 -- which restore's compatibility gate would have read as a fresh
        # install and applied coupled config against.
        local _had_pf=0; [[ -o pipefail ]] && _had_pf=1
        set -o pipefail
        m="$(find "$mdir" -maxdepth 1 -type f -name '*.sh' -printf '%f\n' 2>/dev/null \
             | sed 's/\.sh$//' | sort -n | tail -1)"
        local mrc=$?
        (( _had_pf )) || set +o pipefail
        (( mrc == 0 )) || m=unreadable
    fi
    printf '%s\t%s\t%s' "$v" "$c" "${m:-0}"
}

# Group-specific probes are dispatched from the group's `probe` field rather
# than called as a fixed block: a manifest that does not declare the `shell`
# group must not be failed for having no shell.json.
cmd_verify() {
    probe_declared_paths

    local id probe
    # A failure here is the same manifest probe_declared_paths just tried and
    # reported on above -- not repeated as a second finding. `|| true`, not
    # `|| return`: report() at the end of this function is what actually
    # prints probe_declared_paths' finding and sets the exit status; returning
    # early here would skip it and leave the user with a bare failure and no
    # explanation.
    local ids_out; ids_out="$(groups_ids)" || true
    while read -r id; do
        [[ -n "$id" ]] || continue
        # `|| continue` alone silently skipped this group's probe dispatch
        # on a query failure -- no finding, no trace in the exit status:
        # verify reported ok:true having never actually run whatever probe
        # this group declares. A finding, so the fact this group went
        # unchecked is itself something `report` counts.
        probe="$(group_field "$id" probe)" || { finding fail "$id" manifest-unreadable "this group's probe could not be read from the manifest" ""; continue; }
        case "$probe" in
            hypr-lua)   probe_hypr ;;
            shell-json) probe_shell_json ;;
            plugins)    probe_plugins ;;
            migrations) probe_migrations ;;
            packages)   probe_packages ;;
            "")         ;;
            *)          finding warn "$id" probe-unknown "probe declared but not implemented: $probe" "" ;;
        esac
    done <<<"$ids_out"

    probe_link_integrity
    probe_scheduled
    probe_stale
    report
}

# A backup nothing runs is a backup that does not happen. The plugin cannot
# install its own timers (omarchy runs no plugin hook, deliberately), so the
# gap between "installed" and "actually running" is real and silent -- the
# August incident one level up: the panel would report coverage and save
# nothing, forever.
#
# A warning, not a failure: `verify` has to keep working from inside a bundle
# and on a recovery tty, where no user session exists to ask.
probe_stale() {
    local age
    # Three different unknowns, three different messages. Collapsing them into
    # "never run" told someone whose marker was corrupt to start their first
    # backup, on a machine that had been backing up all week.
    if [[ ! -e "$LAST_SYNC_FILE" ]]; then
        finding warn schedule never-run \
            "never run: no backup has succeeded on this machine yet -- start one with: omabackup sync --commit" ""
    elif ! age="$(last_sync_age)"; then
        finding warn schedule unreadable \
            "the last-backup marker is unreadable: $(_tilde "$LAST_SYNC_FILE")" "$LAST_SYNC_FILE"
    elif (( age < 0 )); then
        finding warn schedule clock-skew \
            "the last backup is dated in the future by $(( -age / 60 ))m -- the clock moved, or this marker came from another machine" ""
    elif (( age > STALE_AFTER_SEC )); then
        finding warn schedule stale \
            "last successful backup was $(( age / 3600 ))h ago" ""
    else
        finding pass schedule fresh "last successful backup $(( age / 60 ))m ago" ""
    fi
}

probe_scheduled() {
    if scheduler_active; then
        finding pass scheduler scheduled "scheduled: the backup runs unattended" ""
    else
        finding warn scheduler not-scheduled \
            "nothing is scheduled to run the backup -- fix with: omabackup install" ""
    fi
}

report() {
    local pass=0 warn=0 fail=0 line lvl
    for line in "${FINDINGS[@]:-}"; do
        [[ -n "$line" ]] || continue
        lvl="${line%%$'\t'*}"
        case "$lvl" in pass) pass=$((pass+1));; warn) warn=$((warn+1));; fail) fail=$((fail+1));; esac
    done

    local ov oc om; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"

    if (( JSON )); then
        printf '%s\n' "${FINDINGS[@]:-}" | jq -R -s --arg v "$ov" --arg c "$oc" --arg m "$om" \
            --argjson groups "$(groups_json 2>/dev/null || echo '[]')" \
            --argjson pass "$pass" --argjson warn "$warn" --argjson fail "$fail" '
            split("\n") | map(select(length>0) | split("\t")
              | {level:.[0], group:.[1], code:.[2], message:.[3], path:(.[4] // "")})
            | {schemaVersion:1,
               omarchy:{version:$v, channel:$c, migrationWatermark:$m},
               groups:$groups,
               ok:($fail == 0),
               counts:{pass:$pass, warn:$warn, fail:$fail},
               findings:.}'
    else
        printf '%som%s %s - channel %s - migration %s\n\n' "$DIM" "$NC" "$ov" "$oc" "$om"
        for line in "${FINDINGS[@]:-}"; do
            [[ -n "$line" ]] || continue
            IFS=$'\t' read -r lvl grp code msg _ <<<"$line"
            case "$lvl" in
                pass) printf '  %s✓%s %-11s %s\n' "$GREEN" "$NC" "$grp" "$msg" ;;
                info) printf '  %s·%s %-11s %s%s%s\n' "$DIM" "$NC" "$grp" "$DIM" "$msg" "$NC" ;;
                warn) printf '  %s!%s %-11s %s\n' "$YELLOW" "$NC" "$grp" "$msg" ;;
                fail) printf '  %s✗%s %-11s %s\n' "$RED" "$NC" "$grp" "$msg" ;;
            esac
        done
        printf '\n  %d ok - %s%d warning%s - %s%d failure%s\n' \
            "$pass" "$YELLOW" "$warn" "$NC" "$RED" "$fail" "$NC"
    fi
    (( fail == 0 ))
}

# ── collect ──────────────────────────────────────────────────────────────────
# Manifest fields the collector knows how to honor. A field that is declared but
# not implemented gets ignored in silence -- that is how the first version
# copied 6.6MB of third-party plugin code despite mode:triple, and 62MB of
# node_modules despite exclude. Same shape as the bug recorded in
# docs/CONTEXT.md §4: "a generic loop overrides specific handling".
KNOWN_FIELDS='["id","label","mode","coupled","critical","paths","probe","enabled","exclude","generator","allowList","note"]'
KNOWN_MODES='["link","copy","gen","triple"]'

assert_manifest_understood() {
    local bad line
    local path_fields='["live","trackedRepoPath"]'
    # The duplicate-id check below exists because id is the primary key every
    # group_field/group_paths/groups_ids lookup trusts to name exactly one
    # group -- two objects sharing one id silently merge in those lookups
    # (jq -r prints one line per match), which is how a disabled duplicate
    # was found leaking its own paths into an enabled group's restore.
    bad="$(jq -r --argjson k "$KNOWN_FIELDS" --argjson m "$KNOWN_MODES" --argjson pf "$path_fields" '
        [ (.groups[] | . as $g | (keys[] | select(. as $f | $k | index($f) | not)
            | "unknown field \(.) in group \($g.id)"))
        , (.groups[] | select(.mode as $x | $m | index($x) | not)
            | "unknown mode \(.mode) in group \(.id)")
        , (.groups[] | . as $g | ((.paths // [])[] | select(type=="object") | keys[]
            | select(. as $f | $pf | index($f) | not))
            | "unknown path field \(.) in group \($g.id)")
        , (.groups | group_by(.id) | .[] | select(length > 1) | .[0].id
            | "duplicate group id \(.) -- two groups cannot share one id")
        # A tab or newline in a declared live/trackedRepoPath is a legal
        # filesystem byte but not a legal byte in this project own
        # tab-framed row format (restore_rows own action-group-rel-dest
        # rows, and the plan JSON built straight from it): a review round
        # found a live value containing an embedded newline turned ONE
        # declared path into what every downstream newline-based reader
        # treated as TWO, and a tab in one truncated the destination the
        # plan JSON reported -- the apply wrote the real, full name; the
        # plan described a different, shorter one. groups_ids already
        # refuses this for id, for the identical reason; extended here to
        # the path fields that feed the same pipeline.
        , (.groups[] | . as $g | ((.paths // [])[] | if type=="object" then .live else . end)
            | select(test("[\t\n]"))
            | "group \($g.id) declares a live path containing a tab or newline")
        , (.groups[] | . as $g | ((.paths // [])[] | select(type=="object") | .trackedRepoPath // empty)
            | select(test("[\t\n]"))
            | "group \($g.id) declares a trackedRepoPath containing a tab or newline")
        ] | .[]' "$GROUPS_FILE")"
    [[ -z "$bad" ]] && return 0
    printf '%somabackup: the manifest declares what the collector cannot honor:%s\n' "$RED" "$NC" >&2
    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<<"$bad"
    exit 1
}

# A pattern like "node_modules/**" drops the contents but rsync keeps the empty
# directory. Empty directories in a backup are noise, so the form without /**
# goes along with it.
_emit_exclude() {
    local pat="$1"
    [[ -n "$pat" ]] || return 0
    printf -- '--exclude\n%s\n' "$pat"
    [[ "$pat" == */\*\* ]] && printf -- '--exclude\n%s\n' "${pat%/\*\*}"
    return 0
}

# _rsync_excludes <group-id> <transfer-root>
# rsync matches exclude patterns against paths relative to the root of the
# transfer, so the root is required to translate anything written as a full
# path. A group's own `exclude` entries are already relative ("node_modules/**")
# and pass through untouched; the manifest-wide `excluded` list is written as
# full paths and used to be handed over with only the leading `~/` stripped,
# which produced patterns like `.config/nvim/lazy-lock.json` that could never
# match under a root of `~/.config/nvim`. The file the manifest called
# "constant diff noise" was therefore backed up on every single run.
_rsync_excludes() {
    local id="$1" root="${2:-}" pat ex out
    # Both jq queries below, captured and checked before anything reads
    # them -- a `while read < <(jq ...)` process substitution has no `$?`
    # slot a caller can check at all, so a failing query here used to be
    # silent: the pattern list for this transfer came back empty exactly as
    # it would for a group with genuinely nothing to exclude, and rsync
    # copied whatever those patterns existed to keep out.
    out="$(jq -r --arg id "$id" '.groups[]|select(.id==$id)|(.exclude // [])[]' "$GROUPS_FILE")" || return 1
    [[ -n "$out" ]] && while read -r pat; do _emit_exclude "$pat"; done <<<"$out"
    [[ -n "$root" ]] || return 0
    root="${root%/}"
    out="$(jq -r '(.excluded // [])[].path' "$GROUPS_FILE")" || return 1
    [[ -n "$out" ]] || return 0
    while read -r pat; do
        [[ -n "$pat" ]] || continue
        ex="$(_expand "$pat")"
        # Only what actually lives under this transfer, anchored with a leading
        # slash so it cannot also match a same-named file deeper in the tree.
        [[ "$ex" == "$root"/* ]] || continue
        _emit_exclude "/${ex#"$root"/}"
    done <<<"$out"
}

# Collects into staging, NEVER straight into the repo. This is the first of four
# beats (collect -> diff -> verify -> commit): without staging there is no diff
# for mode:copy groups, and the cycle would close on itself. See docs/DESIGN.md §11.1.
# The list names each generator writes, so coverage can attribute them. Kept
# beside collect_generated, which is what actually creates these.
_generated_files() {
    case "$1" in
        packages) printf 'pkgs-explicit.txt pkgs-aur.txt pkgs-arch.txt' ;;
        systemd)  printf 'systemd-user.txt systemd-system.txt' ;;
    esac
}

# _staged_size <dir> -> "<files>\t<bytes>" for what is under it right now.
_staged_size() {
    [[ -d "$1" || -f "$1" ]] || { printf '0\t0'; return 0; }
    local out
    # find's status is checked: a partial walk produced a partial count that was
    # written as though it were the whole truth.
    out="$(find "$1" \( -type f -o -type l \) -printf '%s\n' 2>/dev/null)" || return 1
    printf '%s' "$out" | awk '{n++; b+=$1} END{printf "%d\t%d", n+0, b+0}'
}

cmd_collect() {
    require_tools jq git rsync
    assert_manifest_understood
    # Staging represents "what should be backed up right now", not an
    # accumulating cache: without wiping it first, a path a group used to
    # declare (or a name a trackedOnly path used to match) lingers forever and
    # publish_staging happily republishes it. Proven by the desktop group's
    # first run, before trackedRepoPath existed, leaving 63 stray files behind
    # that a later, correct collect kept finding and republishing.
    # A partial wipe (one nested file this cannot remove) used to fall
    # straight through to mkdir -p, which merely confirms the directory
    # still exists and says nothing about what is left inside it. A PoC
    # (a stub rm that fails only for $STAGING) confirmed the result:
    # collect reported success, and a stale file from a group that no
    # longer declares that path stayed in staging alongside the new
    # collection -- exactly what this rm exists to prevent,
    # publish_staging happily republishing it on the next sync.
    #
    # rm's own status is not checked directly, though -- rm -rf can fail
    # to remove the now-empty directory SHELL itself (its parent lacking
    # write permission is enough) while still having cleared everything
    # actually inside it, which mkdir -p a line down handles fine either
    # way. What matters is whether anything is left INSIDE staging after
    # both have run, checked explicitly rather than inferred from rm's
    # exit code alone.
    rm -rf "$STAGING" 2>/dev/null
    mkdir -p "$STAGING" || die "could not create $(_tilde "$STAGING")"
    [[ -z "$(find "$STAGING" -mindepth 1 -print -quit 2>/dev/null)" ]] \
        || die "could not clear $(_tilde "$STAGING") before collecting into it -- stale files remain"
    local id mode p e dest n=0 excrc rc
    # groups_ids failing here is not a smaller problem than any other -- it is
    # a WORSE one: the manifest this machine's own trusted groups.default.json
    # could not be queried made this loop run zero times, staging (just wiped,
    # a few lines up) stayed empty, and n stayed 0 -- indistinguishable from a
    # genuinely empty manifest, all the way through to `sync --commit`
    # potentially committing that empty staging over real, previously-tracked
    # content. Died on outright, not merely skipped.
    local ids_out; ids_out="$(groups_ids)" || die "could not read this machine's own group manifest -- refusing to collect against an unreadable schema"
    while read -r id; do
        [[ -n "$id" ]] || continue
        mode="$(group_field "$id" mode)" || die "could not read group $id's mode from the manifest"
        case "$mode" in
            gen)    collect_generated "$id"; continue ;;
            triple) collect_triple "$id"; continue ;;
        esac

        local -a ex=()

        local paths_out; paths_out="$(group_paths "$id")" || die "could not read group $id's paths from the manifest"
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || continue
            # A path both declared by a group and listed in `excluded` is the
            # manifest contradicting itself. The exclusion wins: translating
            # patterns only ever covered descendants of the transfer root, so
            # naming the root itself used to be resolved silently in favour of
            # copying the whole thing.
            #
            # rc 2, checked separately from rc 1 -- "excluded" and "the
            # exclusion list itself could not be answered" used to look the
            # same to a bare `if is_excluded ...`, and a query failure fell
            # through to the copy below same as a genuine "no, not excluded"
            # would. A file this cannot answer for is refused, not copied.
            is_excluded "$e"; excrc=$?
            if (( excrc == 2 )); then
                die "could not check group $id's path $(_tilde "$e") against the exclusion list"
            elif (( excrc == 0 )); then
                finding info "$id" path-excluded "declared but excluded on purpose: $p" "$e"
                continue
            fi
            dest="$STAGING/${e#$HOME/}"
            mkdir -p "$(dirname "$dest")"
            # Per path, not per group: the exclude patterns have to be relative
            # to the directory rsync is about to walk.
            #
            # mapfile from a process substitution has no `$?` of its own to
            # check -- `wait "$!"` on the substitution's PID right after does.
            # A failing query inside _rsync_excludes used to be silent: `ex`
            # came back empty exactly as it would for a group with nothing to
            # exclude, and the rsync a few lines down copied whatever those
            # patterns existed to keep out.
            mapfile -t ex < <(_rsync_excludes "$id" "$e")
            wait "$!" || die "could not read group $id's exclude patterns"
            # Tracked-only is a per-path decision, not a per-group one: a
            # group can mix a directory that should only pull already-tracked
            # names (desktop entries) with a plain file that should always
            # copy (mimeapps.list).
            #
            # Status captured explicitly -- `[[ -n "$(...)" ]]` alone cannot
            # tell "no trackedRepoPath override" from "the query itself
            # failed": both are an empty string. A PoC confirmed the result:
            # a query that failed for a genuinely trackedRepoPath-declared
            # path fell through to the generic rsync branch below, which
            # copies both tracked AND untracked names into the same
            # directory -- exactly what collect_tracked_only exists to keep
            # separate for a group like `scripts`, whose whole point is that
            # ~/.local/bin is not entirely the repo's to own.
            local trp; trp="$(group_tracked_repo_path "$id" "$p")" || die "could not read group $id's trackedRepoPath override from the manifest"
            if [[ -n "$trp" ]]; then
                collect_tracked_only "$e" "$dest" "$id" "$p" || continue
            elif [[ -d "$e" && ! -L "$e" ]]; then
                # rsync's own status, checked -- neither call here was, and
                # `n` counted this path as collected regardless. A PoC (an
                # rsync wrapper that always fails, exit 1) confirmed the
                # result: collect reported success, staging held nothing for
                # this path, and the coverage file it wrote right after
                # recorded zero files/bytes for a group that looked, from
                # the exit code alone, like it had just been backed up.
                #
                # 23/24 are not that failure -- rsync's own codes for "some
                # files could not be transferred" (an unreadable
                # subdirectory it walked past) and "a source file vanished
                # mid-walk", both already tolerated by design: _staged_size
                # measures what actually landed afterward and reports THAT
                # gap on its own terms, rather than this collect aborting a
                # path that mostly succeeded over one unreadable corner of
                # it. Anything else -- rsync could not even start, a
                # destination it could not write to at all -- is not that
                # case, and is refused rather than counted as collected.
                rsync -a --exclude '.git/' "${ex[@]}" "$e/" "$dest/"; rc=$?
                (( rc == 0 || rc == 23 || rc == 24 )) \
                    || die "could not copy $(_tilde "$e") into staging"
            else
                rsync -a "$e" "$dest"; rc=$?
                (( rc == 0 || rc == 23 || rc == 24 )) \
                    || die "could not copy $(_tilde "$e") into staging"
            fi
            n=$((n + 1))
        done <<<"$paths_out"
        (( JSON )) || printf '  %s✓%s %s\n' "$GREEN" "$NC" "$id"
    done <<<"$ids_out"

    # Reported, not fatal: what was collected is on disk and valid either way.
    write_coverage || true

    if (( JSON )); then
        jq -n --arg s "$STAGING" --argjson n "$n" '{schemaVersion:1, staging:$s, entries:$n}'
    else
        printf '\n  %d paths in %s\n' "$n" "$(_tilde "$STAGING")"
    fi
}

# Counted off the staging tree, which is the backup's own content: whatever a
# group's paths, excludes and tracked-only rules produced, without asking a
# second implementation to agree.
# The record we could not replace describes an earlier collect, and nothing
# downstream distinguishes it from a current one: unknown counts print as "--",
# stale counts print as fact. Emptied before it is removed -- unlinking needs
# write permission on the DIRECTORY, which is exactly what is missing in the
# case that brings us here, so the delete failed and the stale record survived
# the branch written to retire it. Truncating needs only the file.
_retire_coverage() {  # _retire_coverage <why>
    : >"$COVERAGE_FILE" 2>/dev/null
    rm -f "$COVERAGE_FILE.tmp" "$COVERAGE_FILE" 2>/dev/null
    if [[ -s "$COVERAGE_FILE" ]]; then
        printf '%somabackup: %s, and the old record could not be retired either -- the counts shown describe an earlier collect%s\n' \
            "$RED" "$1" "$NC" >&2
    else
        printf '%somabackup: %s -- counts read as unknown until the next collect%s\n' \
            "$YELLOW" "$1" "$NC" >&2
    fi
}

write_coverage() {
    local id p e dest files bytes gf gb rows="" failed=0
    # groups_ids failing here fed the same "zero rows, no error" shape every
    # per-group measurement failure below is already careful to avoid --
    # closed the same way, through the SAME failed flag this function already
    # checks before ever writing a record.
    local ids_out; ids_out="$(groups_ids)" || failed=1
    while read -r id; do
        [[ -n "$id" ]] || continue
        gf=0; gb=0
        # group_field's own status, checked before it decides the case --
        # a failed query and a mode this switch does not recognize looked
        # identical (both empty, falling to the path-measurement branch
        # below with the wrong semantics for a gen/triple group).
        local gmode; gmode="$(group_field "$id" mode)" || { failed=1; break; }
        case "$gmode" in
            # Every generator writes into the same .generated/ directory, so
            # counting the directory gave each group the whole of it -- packages
            # and systemd both reporting a number neither of them owned. Counted
            # per generator instead, from the same names collect_generated writes.
            gen)    local gen_id f
                    # This query's own status, checked -- a failure here
                    # produced the same empty string _generated_files
                    # returns for an id with no entry, the for loop ran
                    # zero times, and this group's line was written with
                    # files=0 bytes=0 as though that were a real
                    # measurement rather than one that could not be taken.
                    gen_id="$(group_field "$id" generator)" || { failed=1; break; }
                    for f in $(_generated_files "$gen_id"); do
                        local gsz
                        gsz="$(_staged_size "$STAGING/.generated/$f")" || { failed=1; break; }
                        IFS=$'\t' read -r files bytes <<<"$gsz"
                        gf=$((gf + files)); gb=$((gb + bytes))
                    done ;;
            triple) dest="$STAGING/.plugins"
                    local tsz
                    if tsz="$(_staged_size "$dest")"; then
                        IFS=$'\t' read -r gf gb <<<"$tsz"
                    else failed=1; fi ;;
            *)      local gcp_paths; gcp_paths="$(group_paths "$id")" || { failed=1; break; }
                    while read -r p; do
                        [[ -n "$p" ]] || continue
                        e="$(_expand "$p")"
                        dest="$STAGING/${e#$HOME/}"
                        local sz
                        sz="$(_staged_size "$dest")" || { failed=1; break; }
                        IFS=$'\t' read -r files bytes <<<"$sz"
                        gf=$((gf + files)); gb=$((gb + bytes))
                    done <<<"$gcp_paths" ;;
        esac
        # A size this function could not measure is a row it cannot honestly
        # write, and every one of these paths used to leave quietly: two threw
        # the status away outright and the third returned before the record was
        # retired, so a measurement failure and a clean collect looked alike.
        (( failed )) && break
        rows+="$(printf '%s\t%s\t%s' "$id" "$gf" "$gb")"$'\n'
    done <<<"$ids_out"

    if (( failed )); then
        _retire_coverage "could not measure what was staged"
        return 1
    fi

    # The manifest's content hash rides along. Counts keyed by group id alone
    # survived a manifest edit that kept an id and changed what it covers, and
    # the stale numbers were then shown as if they described the new definition
    # -- five files reported for a group repointed at a directory holding one.
    #
    # A write that fails takes the old record with it. Every status this
    # function could return was discarded and every failure branch returned 0,
    # so a full disk left yesterday's counts in place and collect printed its
    # ticks over them -- and nothing downstream can tell a stale record from a
    # current one. Unknown counts print as "--"; stale counts print as fact.
    # This tool exists because coverage that reads as fact and is not is the
    # failure worth catching.
    # The manifest hash is what tells a later read whether these counts still
    # describe the same question. Computed inline, a sha256sum that failed wrote
    # an empty one -- and the reader, computing it the same way and failing the
    # same way, compared "" against "" and accepted stale counts as current.
    local mhash
    mhash="$(_manifest_hash)" || {
        _retire_coverage "could not hash $(_tilde "$GROUPS_FILE")"
        return 1
    }
    if ! mkdir -p "$(dirname "$COVERAGE_FILE")" 2>/dev/null \
    || ! printf '%s' "$rows" | jq -R -s --arg at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
           --arg manifest "$mhash" \
           '{schemaVersion:1, at:$at, manifest:$manifest,
             groups: (split("\n") | map(select(length>0) | split("\t")
                      | {id:.[0], files:(.[1]|tonumber), bytes:(.[2]|tonumber)}))}' \
           >"$COVERAGE_FILE.tmp" 2>/dev/null \
    || ! mv "$COVERAGE_FILE.tmp" "$COVERAGE_FILE" 2>/dev/null; then
        _retire_coverage "could not record coverage at $(_tilde "$COVERAGE_FILE")"
        return 1
    fi
    return 0
}

# The manifest's content hash, or nothing. Never an empty string passed off as
# one: two failures comparing equal is how stale counts were accepted as fresh.
_manifest_hash() {
    local h
    h="$(sha256sum "$GROUPS_FILE" 2>/dev/null | cut -c1-16)" || return 1
    [[ -n "$h" ]] || return 1
    printf '%s' "$h"
}

# The manifest's description of each group, joined to what collect measured.
# Counts are null when nothing has been collected yet -- verify has to run
# inside a bundle and on a recovery tty, where no staging exists, and an unknown
# count must not read as zero: zero means collect ran and found nothing, which
# is the phantom coverage this project was built after.
groups_json() {
    local cov='{"groups":[]}' recorded
    if [[ -s "$COVERAGE_FILE" ]]; then
        recorded="$(jq -r '.manifest // ""' "$COVERAGE_FILE" 2>/dev/null)"
        # Counts from a different manifest describe a different question.
        # Unknown is the honest answer until the next collect.
        local live
        if live="$(_manifest_hash)"; then
            [[ -n "$recorded" && "$recorded" == "$live" ]] \
                && cov="$(cat "$COVERAGE_FILE" 2>/dev/null)"
        fi
    fi
    # paths carries the actual declared live paths now (e.g. "~/.config/hypr"),
    # not just their count -- the panel's Groups tooltip reads this to show
    # what a group actually covers. `if type=="object" then .live else . end`
    # is the same normalization group_paths() itself already applies to a
    # path entry, since a path can be a bare string or {live,trackedRepoPath}.
    # generator rides along too: a mode:gen group (packages, systemd) has no
    # `paths` at all -- what it covers is the command named here instead --
    # so the tooltip has something to fall back to rather than showing
    # nothing for exactly the two groups a user asked about first.
    jq -n --argjson m "$(jq '[.groups[] | select(.enabled != false)
                             | {id, label, mode, coupled:(.coupled // false),
                                critical:(.critical // false),
                                paths:((.paths // []) | map(if type=="object" then .live else . end)),
                                generator:(.generator // null)}]' "$GROUPS_FILE")" \
          --argjson c "$cov" '
        [ $m[] as $g
        | ($c.groups // [] | map(select(.id == $g.id)) | first) as $x
        | $g + {files: ($x.files // null), bytes: ($x.bytes // null)} ]'
}

# The triple strategy: clean git -> URL+sha only; dirty git -> plus a patch;
# no remote -> full copy. Without it staging balloons with third-party code that
# already lives on GitHub, and the local customization (rosakodu.dock's
# slotSize) is lost.
collect_triple() {
    local id="$1" dir p pid n=0
    # group_paths' own status, checked directly -- nesting it inside
    # $(_expand "$(group_paths "$id" | head -1)") discarded it twice over:
    # once because `head -1` (its downstream reader) exits 0 regardless of
    # whether the pipe's own producer failed, and again because the inner
    # substitution's status, even correct, is not what the OUTER one
    # reports -- that one is _expand's own, which never fails. A query that
    # failed produced an empty $dir, [[ -d "$dir" ]] read that as "nothing
    # to collect" and returned 0 -- collect reported success for a plugin
    # group it never actually looked up.
    local gp; gp="$(group_paths "$id")" || die "could not read group $id's paths from the manifest"
    dir="$(_expand "$(head -1 <<<"$gp")")"
    [[ -d "$dir" ]] || return 0
    mkdir -p "$STAGING/.plugins/patches" "$STAGING/.plugins/local"
    : >"$STAGING/.plugins/manifest.txt" || die "could not create $(_tilde "$STAGING/.plugins/manifest.txt")"
    for p in "$dir"/*/; do
        [[ -d "$p" ]] || continue
        pid="$(basename "$p")"; [[ "$pid" == .* ]] && continue
        # capture_plugin's own status, checked -- its own rsync/git-patch
        # failures now propagate (lib/plugin-capture.sh), but this call
        # site discarded whatever reached it (>/dev/null on the
        # classification, no exit-code check at all) and counted the
        # plugin as collected regardless.
        capture_plugin "$p" "$STAGING/.plugins/patches" "$STAGING/.plugins/local" "$STAGING/.plugins/manifest.txt" >/dev/null \
            || die "could not capture plugin $(_tilde "$p")"
        n=$((n + 1))
    done
    (( JSON )) || printf '  %s✓%s %s %s(%d, triple strategy)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$n" "$NC"
}

# Directories like ~/.local/bin mix your own scripts with mise and npm binaries.
# Only what the destination repo already tracks comes back; with no repo
# configured there is nothing to infer, so it warns and skips instead of
# dragging in 15MB of shims.
#
# "Tracked" means tracked by git, asked of the index -- never `find` over the
# directory. Listing the directory counted anything that happened to land there
# (an editor backup, the output of an aborted run) as tracked, so junk in the
# repo pulled its live counterpart in and then perpetuated itself. Outside a git
# worktree the word has no meaning at all, so that warns and skips rather than
# quietly degrading back to the directory listing.
collect_tracked_only() {
    local live="$1" dest="$2" id="$3" declared="$4" repo="${OMABACKUP_REPO:-}" sub base f n=0
    if [[ -z "$repo" || ! -d "$repo" ]] || ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
        finding warn "$id" no-repo "trackedOnly needs OMABACKUP_REPO to be a git repo; skipped $(_tilde "$live")" "$live"
        (( JSON )) || printf '  %s!%s %s %s(trackedOnly without a git repo: skipped)%s\n' "$YELLOW" "$NC" "$(_tilde "$live")" "$DIM" "$NC"
        return 1
    fi
    sub="$(group_tracked_repo_path "$id" "$declared")"
    mkdir -p "$dest"
    # -z, always: without it git quotes anything outside ASCII, so a tracked
    # `ação.sh` comes back as "scripts/local-bin/a\303\247\303\243o.sh" -- quotes
    # included -- the direct-child test never matches, and the file quietly
    # stops being backed up.
    while IFS= read -r -d '' f; do
        [[ -n "$f" ]] || continue
        base="${f##*/}"
        [[ "$f" == "$sub/$base" ]] || continue   # direct children only: the repo keeps a flat directory
        # cp, not rsync: one spawn per tracked name, and rsync's startup is ~85x
        # cp's. -L follows the link deliberately here -- a script in ~/.local/bin
        # that is a symlink into a checkout should be backed up as its contents.
        #
        # cp's own status, checked -- `n` counted this name as collected
        # regardless of whether the copy actually landed, the same shape of
        # bug the two rsync calls in this file's caller were just closed
        # against.
        [[ -f "$live/$base" ]] || continue
        cp -pL "$live/$base" "$dest/" 2>/dev/null || return 1
        n=$((n + 1))
    done < <(git -C "$repo" ls-files -z -- "$sub" 2>/dev/null)
    # git's own status, checked -- a walk that stopped partway backed up
    # fewer names than the repo actually tracks, silently.
    wait "$!" || return 1
    # A declared path the repo tracks nothing under backs up nothing while
    # reporting "up to date" -- the phantom coverage verify exists to shout about.
    (( n > 0 )) || finding warn "$id" tracked-empty "nothing tracked under $sub: $(_tilde "$live") backs up nothing yet" "$live"
    return 0
}

collect_generated() {
    local id="$1" gen; gen="$(group_field "$id" generator)" || die "could not read group $id's generator from the manifest"
    mkdir -p "$STAGING/.generated"
    # Every command below has its own status checked, and refuses rather
    # than silently writing empty: `>` truncates/creates its target as
    # part of setting up the redirect, before the command on its left ever
    # runs, so an empty list from a failing command is not "not written,"
    # it is written empty -- a PoC (pacman replaced with something that
    # always exits 1) confirmed collect otherwise reports success while
    # staging all three package lists empty, and sync --commit publishing
    # that erases hundreds of real package names the repo already held.
    # Removed explicitly on refusal, so nothing is left behind for a later
    # run (or a careless glob) to mistake for real data.
    case "$gen" in
        packages)
            pacman -Qqe >"$STAGING/.generated/pkgs-explicit.txt" 2>/dev/null \
                || { rm -f "$STAGING/.generated/pkgs-explicit.txt"; die "could not list explicitly installed packages (pacman -Qqe failed)"; }
            pacman -Qqem >"$STAGING/.generated/pkgs-aur.txt" 2>/dev/null \
                || { rm -f "$STAGING/.generated/pkgs-aur.txt"; die "could not list foreign packages (pacman -Qqem failed)"; }
            pacman -Qqen >"$STAGING/.generated/pkgs-arch.txt" 2>/dev/null \
                || { rm -f "$STAGING/.generated/pkgs-arch.txt"; die "could not list native packages (pacman -Qqen failed)"; } ;;
        systemd)
            systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-user.txt"
            (( ${PIPESTATUS[0]} == 0 )) \
                || { rm -f "$STAGING/.generated/systemd-user.txt"; die "could not list enabled user units (systemctl --user failed)"; }
            systemctl list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-system.txt"
            (( ${PIPESTATUS[0]} == 0 )) \
                || { rm -f "$STAGING/.generated/systemd-system.txt"; die "could not list enabled system units (systemctl failed)"; } ;;
        # A group declared mode:gen with no generator field at all, or one
        # naming a generator this switch does not recognize, fell through
        # every branch above and reached the end having generated nothing
        # -- collect still counted this group as collected. A manifest
        # this cannot interpret is refused, not treated as a group with
        # nothing to generate.
        *) die "group $id is mode:gen but its generator ('$gen') is not one this tool knows how to run" ;;
    esac
    (( JSON )) || printf '  %s✓%s %s %s(generated)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$NC"
}

# ── sync ─────────────────────────────────────────────────────────────────────
# The four beats in one command: collect -> publish (staging into the repo
# tree) -> verify -> commit only if the tree is actually dirty and verify
# passes. Same philosophy as sync.sh: publish never runs alone without a
# human able to `git status`/`git diff` before anything is committed --
# --commit is opt-in, everything else always leaves the tree for review.
cmd_sync() {
    require_tools jq git rsync
    local repo="${OMABACKUP_REPO:-}" commit=0
    # sync owns --commit. A global flag loop would have to know every
    # subcommand's vocabulary, and would then accept --commit in silence from
    # `verify` and `status`; restore's --target/--dry-run will want the same.
    while (($#)); do
        case "$1" in
            --commit) commit=1; shift ;;
            *) die "unknown flag for sync: $1" ;;
        esac
    done
    [[ -n "$repo" && -d "$repo/.git" ]] || die "OMABACKUP_REPO must point at a git repo (got: ${repo:-unset})"

    JSON=0 cmd_collect >/dev/null || die "collect failed -- refusing to publish whatever staging is left in"
    local list="$OMABACKUP_STATE/last-publish"
    local n tpm
    # Nested inside publish_staging's own argument list, $(tracked_path_map)'s
    # exit status was never the thing `||` below checked -- only
    # publish_staging's was. A tracked_path_map that failed handed
    # publish_staging an empty table, indistinguishable from a manifest that
    # genuinely has no trackedRepoPath overrides, and publish proceeded on it.
    tpm="$(tracked_path_map)" || die "could not read the manifest's tracked-path table -- refusing to publish against an incomplete map"
    n="$(publish_staging "$STAGING" "$repo" "$tpm" "$list")" \
        || die "publish could not write into $(_tilde "$repo") -- refusing to commit a partial backup"
    printf '  %spublished%s %d files into %s\n\n' "$GREEN" "$NC" "$n" "$(_tilde "$repo")"

    local -a published=()
    [[ -s "$list" ]] && mapfile -d '' -t published <"$list"

    # A file published into a path the destination repo ignores was written to
    # somewhere it can never be committed from: the backup reports success and
    # stores nothing. `git add -A` skipped those in silence; a scoped `git add`
    # refuses the entire batch over one of them. Neither is the answer -- drop
    # them from what gets staged and say so, because it is a coverage hole, not
    # a git error. Found by backing up ~/.config/opencode/.gitignore, whose
    # rules then applied inside the dotfiles repo to its own siblings.
    #
    # Ignore rules do not apply to files the repo already tracks, so a tracked
    # path matching .gitignore stages normally and must not be dropped here.
    local -a written=() ignored=()
    local f
    if (( ${#published[@]} )); then
        local -A is_tracked=() is_ignored=()
        while IFS= read -r -d '' f; do is_tracked["$f"]=1; done \
            < <(git -C "$repo" ls-files -z 2>/dev/null)
        while IFS= read -r -d '' f; do
            [[ -n "${is_tracked[$f]:-}" ]] || is_ignored["$f"]=1
        done < <(printf '%s\0' "${published[@]}" | git -C "$repo" check-ignore -z --stdin 2>/dev/null)
        for f in "${published[@]}"; do
            if [[ -n "${is_ignored[$f]:-}" ]]; then ignored+=("$f"); else written+=("$f"); fi
        done
    fi
    if (( ${#ignored[@]} )); then
        finding warn publish repo-ignored \
            "${#ignored[@]} published, then dropped because the repo ignores them (e.g. ${ignored[0]})" \
            "${ignored[0]}"
    fi

    # Verify runs on every sync, once, before any decision about committing.
    # The incident this tool exists for is "nothing changed and the coverage
    # broke" (docs/CONTEXT.md), so returning early on a clean tree without
    # checking is precisely the failure being guarded against -- and the timer
    # (docs/DESIGN.md §11.2) runs with no audience, so broken coverage has to
    # become a failed unit rather than a green backup nobody reads. It runs
    # after publish, never before: the prescribed repair for a link that
    # stopped feeding the repo is to copy the live file in and relink, so
    # blocking publish would block the fix.
    local verified=1
    JSON=0 cmd_verify || verified=0

    if (( ! verified )); then
        printf '\n%somabackup: coverage failed -- not committing%s\n' "$RED" "$NC" >&2
        return 1
    fi

    # Scoped to what publish just wrote: a repo-wide status reports edits the
    # user left mid-review as though this tool had made them. The exit status
    # matters as much as the output -- a git that fails prints nothing, and
    # empty output is indistinguishable from a clean tree, so an unchecked
    # failure here became "up to date" and exit 0.
    local dirty=""
    if (( ${#written[@]} )); then
        dirty="$(git -C "$repo" status --porcelain -- "${written[@]}")" \
            || die "git status failed in $(_tilde "$repo")"
    fi
    if [[ -z "$dirty" ]]; then
        record_sync_success || printf '  %s!%s could not record this run; the next check may call it stale\n' "$YELLOW" "$NC"
        printf '\n  %sup to date%s -- nothing changed since the last sync\n' "$DIM" "$NC"
        return 0
    fi

    printf '\n%s\n' "$dirty" | sed 's/^/  /'

    if (( ! commit )); then
        record_sync_success || printf '  %s!%s could not record this run; the next check may call it stale\n' "$YELLOW" "$NC"
        printf '\n  review with %sgit -C %s status%s / %sdiff%s, then rerun with --commit\n' \
            "$CYAN" "$(_tilde "$repo")" "$NC" "$CYAN" "$NC"
        return 0
    fi

    # Every git call is checked. The script runs under `set -uo pipefail`
    # without -e, so an unchecked failure here fell straight through to
    # "committed" -- the one message a backup tool must never print falsely.
    #
    # Both `add` and `commit` carry the pathspec. Scoping only the add was not
    # enough: `git commit` with no pathspec commits the whole index, so anything
    # the user had already staged rode along under this tool's message. With the
    # pathspec, git builds the commit from HEAD plus these paths alone and
    # leaves the rest of the index exactly as the user left it.
    git -C "$repo" add -- "${written[@]}" \
        || die "git add failed in $(_tilde "$repo")"
    if git -C "$repo" diff --cached --quiet -- "${written[@]}"; then
        record_sync_success || printf '  %s!%s could not record this run; the next check may call it stale\n' "$YELLOW" "$NC"
        printf '  %sup to date%s -- nothing of ours left to commit\n' "$DIM" "$NC"
        return 0
    fi
    git -C "$repo" commit -q \
        -m "omabackup: sync $(date -u '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo now)" \
        -- "${written[@]}" \
        || die "git commit failed in $(_tilde "$repo")"
    record_sync_success || printf '  %s!%s could not record this run; the next check may call it stale\n' "$YELLOW" "$NC"
    printf '  %scommitted%s\n' "$GREEN" "$NC"
}

# ── install ──────────────────────────────────────────────────────────────────
# `omarchy plugin add` clones and enables a plugin and runs no hook from it --
# a sound refusal to execute code fetched from a URL, but it means the timers
# can never install themselves. A fresh install therefore gets the bar widget
# and the CLI and no automation whatsoever: the panel reports coverage
# beautifully and backs up nothing. This verb is the one manual step, and
# `verify` complains until it has been run.
SYSTEMCTL="${OMABACKUP_SYSTEMCTL:-systemctl}"
UNIT_DIR="$HOME/.config/systemd/user"
TIMER_UNITS=(omabackup-sync.timer omabackup-push.timer)
GH="${OMABACKUP_GH:-gh}"

# The interval systemd is actually running, asked of systemd. Repeating it in
# QML or in a constant here would be the same fact in two places, which is how
# four things in this project have already drifted apart.
timer_schedule() {
    local out
    out="$("$SYSTEMCTL" --user show "$1" -p TimersCalendar --value 2>/dev/null)" || return 1
    [[ -n "$out" ]] || return 1
    printf '%s' "$out" | sed -n 's/.*OnCalendar=\([^;]*\).*/\1/p' | sed 's/[[:space:]]*$//'
}

timer_schedule_cron() {
    local calendar
    calendar="$(timer_schedule "$1")" || return 1
    schedule_calendar_to_cron "$calendar"
}

scheduler_active() {
    local t
    for t in "${TIMER_UNITS[@]}"; do
        "$SYSTEMCTL" --user is-active "$t" >/dev/null 2>&1 || return 1
    done
    return 0
}

# A path is not a sed script and not a shell word. The first version built
# ExecStart with `sed "s#...#$OMABACKUP_ROOT#"`, so a `#` in the path was a sed
# syntax error and a space produced an ExecStart systemd parses as two
# arguments. Read the line in bash, single-quote the path when it needs it.
_rewrite_execstart() {
    local file="$1" line exe
    exe="$OMABACKUP_ROOT/bin/omabackup"
    # systemd single-quoting: the only character that cannot appear inside is
    # a single quote itself, and a path holding one is refused rather than
    # mangled into something that would run the wrong program.
    if [[ "$exe" == *"'"* ]]; then
        die "the tool path contains a single quote, which systemd cannot express: $exe"
    fi
    [[ "$exe" == *[[:space:]]* ]] && exe="'$exe'"
    while IFS= read -r line; do
        if [[ "$line" == ExecStart=* ]]; then
            # The arguments are whatever follows the marker. Taking them with
            # ${line##*/bin/omabackup } silently returned the WHOLE line when
            # the marker was absent -- a template line carrying no arguments
            # produced `ExecStart=<new> ExecStart=<old>`, a unit that cannot
            # start, written without anyone checking.
            [[ "$line" == *"/bin/omabackup"* ]] \
                || die "unit template has an ExecStart this does not understand: $line"
            local rest="${line#*/bin/omabackup}"
            rest="${rest# }"
            printf 'ExecStart=%s%s\n' "$exe" "${rest:+ $rest}"
        else
            printf '%s\n' "$line"
        fi
    done <"$file"
}

cmd_install() {
    reject_flags install "$@"
    local repo="${OMABACKUP_REPO:-}" u src
    [[ -n "$repo" && -d "$repo/.git" ]] \
        || die "OMABACKUP_REPO must point at the git repo that receives the backup (got: ${repo:-unset}).
  Run:  OMABACKUP_REPO=~/path/to/dotfiles omabackup install"

    src="$OMABACKUP_ROOT/systemd"
    [[ -d "$src" ]] || die "unit templates not found: $(_tilde "$src")"
    mkdir -p "$UNIT_DIR" || die "cannot create $(_tilde "$UNIT_DIR")"

    # ExecStart is rewritten to whichever copy of the tool is running install.
    # The templates name the installed plugin path, which is right for the
    # common case and wrong for every working copy -- and a timer wired to a
    # directory that does not exist fails in a way nobody would connect back
    # to here.
    for u in omabackup-sync.service omabackup-sync.timer \
             omabackup-push.service omabackup-push.timer; do
        [[ -f "$src/$u" ]] || die "missing unit template: $u"
        _rewrite_execstart "$src/$u" >"$UNIT_DIR/$u" || die "cannot write $(_tilde "$UNIT_DIR/$u")"
    done

    # Never clobber this: the user may have added their own variables, and it
    # is the one file here that is theirs rather than ours.
    mkdir -p "$HOME/.config/omabackup"
    if [[ -f "$HOME/.config/omabackup/env" ]]; then
        printf '  %skept%s %s %s(already configured)%s\n' \
            "$DIM" "$NC" "$(_tilde "$HOME/.config/omabackup/env")" "$DIM" "$NC"
    else
        printf 'OMABACKUP_REPO=%s\n' "$repo" >"$HOME/.config/omabackup/env" \
            || die "cannot write the environment file"
    fi

    "$SYSTEMCTL" --user daemon-reload || die "systemctl daemon-reload failed"
    "$SYSTEMCTL" --user enable --now "${TIMER_UNITS[@]}" >/dev/null 2>&1 \
        || die "could not enable the timers"

    printf '  %s✓%s installed and scheduled %s(sync every 15m, push hourly)%s\n' \
        "$GREEN" "$NC" "$DIM" "$NC"
    printf '  check with: %ssystemctl --user list-timers omabackup-\*%s\n' "$CYAN" "$NC"
}

# ── enable / disable ─────────────────────────────────────────────────────────
# The master switch. "Is omabackup on" means "are its timers running": with them
# stopped nothing collects, nothing commits and nothing is sent, and `verify`
# already reports exactly that.
#
# It stops and starts units, never removes them. Turning it back on has to be a
# switch, not a reinstall -- and the panel's toggle is the whole reason this
# verb exists, so it must be reversible from there.
cmd_enable() {
    local want="$1" sync_schedule push_schedule
    shift
    reject_flags "$want" "$@"
    [[ -d "$UNIT_DIR" ]] \
        || die "the timers are not installed yet -- run: omabackup install"

    if [[ "$want" == enable ]]; then
        "$SYSTEMCTL" --user enable --now "${TIMER_UNITS[@]}" >/dev/null 2>&1 \
            || die "could not start the timers"
        sync_schedule="$(timer_schedule_cron omabackup-sync.timer || printf 'unknown')"
        push_schedule="$(timer_schedule_cron omabackup-push.timer || printf 'unknown')"
        printf '  %s✓%s on %s(sync %s, push %s)%s\n' \
            "$GREEN" "$NC" "$DIM" "$sync_schedule" "$push_schedule" "$NC"
    else
        "$SYSTEMCTL" --user disable --now "${TIMER_UNITS[@]}" >/dev/null 2>&1 \
            || die "could not stop the timers"
        printf '  %soff%s %s-- nothing will run until: omabackup enable%s\n' \
            "$YELLOW" "$NC" "$DIM" "$NC"
    fi
}

# ── reload ───────────────────────────────────────────────────────────────────
# quickshell reads QML once, at startup, and watches nothing -- there is no
# reload flag. So updating the installed plugin is two ordered steps: write the
# files, then restart the shell. Done by hand they raced, repeatedly: the shell
# came back up a second before the pull finished writing and re-read the old
# file, so the update did not land while every sign said it had.
#
# The check is the point of this verb. Comparing the shell's start time against
# the newest plugin file is what turns "I restarted it" into "it is running
# this".
PLUGIN_DIR="${OMABACKUP_PLUGIN_DIR:-$HOME/.config/omarchy/plugins/brenoperucchi.omabackup}"
RESTART_SHELL="${OMABACKUP_RESTART_SHELL:-omarchy-restart-shell}"
# `omarchy-restart-shell`, never `omarchy-refresh-shell`: the second resets
# shell.json to Omarchy defaults, which would wipe the user's bar configuration
# including this widget. The names are one word apart.

_newest_plugin_file() {
    find "$PLUGIN_DIR" -type f -not -path '*/.git/*' -printf '%T@\n' 2>/dev/null \
        | sort -rn | head -1 | cut -d. -f1
}

# The quickshell processes, in one place. Both questions below used to run
# their own `pgrep -x quickshell | head -1`, which picks by process order: during
# a restart the old shell and the new one are both alive for a moment, the lowest
# pid is the OLD one, and "is the shell at least as new as the files" was then
# answered about the process being replaced. reload printed "the update did not
# land" for a restart that had landed.
_shell_pids() {
    if [[ -n "${OMABACKUP_SHELL_PIDS:-}" ]]; then "$OMABACKUP_SHELL_PIDS"; return; fi
    pgrep -x quickshell 2>/dev/null | sort -n
}

# <pid> -> the epoch second it started, or nothing.
_proc_started_at() {
    local pid="$1" when
    when="$(ps -o lstart= -p "$pid" 2>/dev/null)" || return 1
    [[ -n "$when" ]] || return 1
    date -d "$when" +%s 2>/dev/null
}

# The NEWEST shell, not an arbitrary one. The question this answers is whether
# something is running that is at least as new as the files just written, and
# the process that answers it is the youngest.
_shell_started_at() {
    if [[ -n "${OMABACKUP_SHELL_PROBE:-}" ]]; then "$OMABACKUP_SHELL_PROBE"; return; fi
    local pid at newest=0
    while read -r pid; do
        [[ -n "$pid" ]] || continue
        at="$(_proc_started_at "$pid")" || continue
        [[ "$at" =~ ^[0-9]+$ ]] || continue
        (( at > newest )) && newest="$at"
    done < <(_shell_pids)
    (( newest > 0 )) || return 1
    printf '%s' "$newest"
}

# <pid> -> "<pid>:<start time in clock ticks since boot>". Separate from
# _shell_identity so it can be asked about a process the test controls: the
# identity of whatever quickshell happens to be running is not something a spec
# can assert against.
_proc_identity() {
    local pid="$1" st
    [[ -r "/proc/$pid/stat" ]] || return 1
    st="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
    # comm can hold spaces and parentheses, so the line is cut after its last
    # ')' before being split: what remains starts at field 3, making starttime
    # -- field 22 -- the 20th.
    st="${st##*) }"
    st="$(printf '%s' "$st" | cut -d" " -f20)"
    [[ "$st" =~ ^[0-9]+$ ]] || return 1
    printf '%s:%s' "$pid" "$st"
}

_shell_identity() {
    if [[ -n "${OMABACKUP_SHELL_IDENTITY:-}" ]]; then "$OMABACKUP_SHELL_IDENTITY"; return; fi
    local pid one id=""
    while read -r pid; do
        [[ -n "$pid" ]] || continue
        one="$(_proc_identity "$pid")" || continue
        id+="$one "
    done < <(_shell_pids)
    [[ -n "$id" ]] || return 1
    printf '%s' "$id"
}

cmd_reload() {
    reject_flags reload "$@"
    [[ -d "$PLUGIN_DIR" ]] \
        || die "the plugin is not installed at $(_tilde "$PLUGIN_DIR")
  Install it with: omarchy plugin add https://github.com/brenoperucchi/omabackup.git --enable --yes"

    if [[ -d "$PLUGIN_DIR/.git" ]]; then
        git -C "$PLUGIN_DIR" pull --ff-only -q 2>/dev/null \
            || printf '  %s!%s could not pull; reloading what is on disk\n' "$YELLOW" "$NC"
    fi

    # `.service` files only, never `.timer` -- found by review (round
    # omabackup-22): `cmd_install` is the only thing that ever writes these
    # units, so an instance updated the supported way (`reload`, or
    # `omarchy plugin update`, which calls this) kept running its
    # pre-OMABACKUP_LOG_SKIP=1 units indefinitely, duplicating the journal
    # and the file log on every timer-triggered run. Re-running `install`
    # by hand already picks up the new template, but that is not the
    # documented update path. `.timer` is deliberately excluded: `install`
    # already overwrites it unconditionally from the template on every run,
    # which would discard a schedule set via `config set sync-schedule` --
    # not a new problem to fix here, but one this narrower refresh must not
    # accidentally reproduce for reload too.
    #
    # Written to a temp file in the same directory and moved into place
    # only once _rewrite_execstart has actually produced non-empty output
    # -- found by review (round omabackup-23): a plain `>` redirect
    # truncates the target FIRST, so a read/write failure partway (disk
    # full included) used to leave the live unit empty or partial while
    # `|| true` silently swallowed the error and reload still reported
    # success. A generation or daemon-reload failure now leaves the
    # previously-working unit untouched and prints a warning instead of
    # dying -- this is a best-effort refresh alongside reload's own real
    # job (verifying the shell restart), not something that should block it.
    if [[ -d "$UNIT_DIR" ]]; then
        local reload_src="$OMABACKUP_ROOT/systemd" reload_unit reload_tmp reload_failed=0
        for reload_unit in omabackup-sync.service omabackup-push.service; do
            if [[ -f "$reload_src/$reload_unit" && -f "$UNIT_DIR/$reload_unit" ]]; then
                reload_tmp="$UNIT_DIR/.omabackup-reload-$reload_unit.$$"
                # Explicit `( ... )` subshell, not a direct call: found by
                # review (round omabackup-24) that _rewrite_execstart calls
                # die() -- a real `exit` -- for a source path containing a
                # single quote or an unexpected ExecStart shape. Running in
                # the main shell, that would have killed `reload` outright,
                # skipping the warning below, the temp cleanup, AND
                # reload's own real job of verifying the shell restart. A
                # subshell contains the exit to just this one unit's
                # generation attempt.
                if ( _rewrite_execstart "$reload_src/$reload_unit" ) >"$reload_tmp" 2>/dev/null \
                    && [[ -s "$reload_tmp" ]]; then
                    chmod --reference="$UNIT_DIR/$reload_unit" "$reload_tmp" 2>/dev/null || chmod 644 "$reload_tmp"
                    mv -f -- "$reload_tmp" "$UNIT_DIR/$reload_unit" 2>/dev/null || reload_failed=1
                else
                    rm -f -- "$reload_tmp"
                    reload_failed=1
                fi
            fi
        done
        if (( reload_failed )); then
            printf '  %s!%s could not refresh an installed systemd unit; the running one is untouched\n' "$YELLOW" "$NC"
        else
            "$SYSTEMCTL" --user daemon-reload >/dev/null 2>&1 \
                || printf '  %s!%s systemctl daemon-reload failed after refreshing units\n' "$YELLOW" "$NC"
        fi
    fi

    local before files before_id
    before="$(_shell_started_at || echo 0)"
    before_id="$(_shell_identity || echo none)"
    files="$(_newest_plugin_file)"; files="${files:-0}"

    # A verb whose whole purpose is verification reported success two ways
    # while nothing had happened: an empty directory and a dead shell both read
    # as 0, and `0 >= 0` was true; and a restart command returning 1 still
    # passed whenever the running shell already predated the files.
    if ! "$RESTART_SHELL" >/dev/null 2>&1; then
        die "the restart command failed: $RESTART_SHELL"
    fi

    # Poll rather than sleep a guessed interval: the restart is asynchronous,
    # and a fixed sleep is what made this unreliable by hand.
    #
    # Thirty seconds, not ten. omarchy-restart-shell returns in about half a
    # second and the shell it starts usually appears within one -- but not
    # always, and twice in one afternoon reload printed "the update did not
    # land" for a restart that had landed, with the retry succeeding every
    # time. A window that expires early turns a slow restart into a false
    # report, which costs more than waiting does.
    local i after_at=0 after_id=none
    for i in $(seq 1 30); do
        sleep 1
        after_at="$(_shell_started_at || echo 0)"
        after_id="$(_shell_identity || echo none)"
        # Three conditions, not one. The shell has to be RUNNING, it has to
        # have restarted (a different start than before), and it has to be at
        # least as new as the files.
        [[ "$after_id" != none && "$after_id" != "$before_id" ]] \
            && (( after_at > 0 && after_at >= files )) && break
    done

    if (( after_at == 0 )); then
        printf '%somabackup: the shell is not running -- nothing is showing this version%s\n' \
            "$RED" "$NC" >&2
        printf '  start it with: %s%s%s\n' "$CYAN" "$RESTART_SHELL" "$NC" >&2
        return 1
    fi
    if [[ "$after_id" == "$before_id" ]]; then
        printf '%somabackup: the shell did not restart -- it is still the process from before%s\n' \
            "$RED" "$NC" >&2
        return 1
    fi

    local head; head="$(git -C "$PLUGIN_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    if (( after_at >= files )); then
        printf '  %s✓%s reloaded %s(%s is live)%s\n' "$GREEN" "$NC" "$DIM" "$head" "$NC"
        return 0
    fi
    printf '%somabackup: the old shell is still running -- the update did not land%s\n' \
        "$RED" "$NC" >&2
    printf '  plugin files: %s   shell started: %s\n' \
        "$(date -d "@$files" '+%H:%M:%S' 2>/dev/null)" \
        "$(date -d "@$after_at" '+%H:%M:%S' 2>/dev/null)" >&2
    printf '  try again, or restart it yourself: %s%s%s\n' "$CYAN" "$RESTART_SHELL" "$NC" >&2
    return 1
}

# ── bundle ───────────────────────────────────────────────────────────────────
# The artifact every destination other than `github` receives (DESIGN.md §3).
# Separate verb from `push` on purpose: building is cheap and local, sending is
# slow and fallible, and only one of them should be able to fail at 3am.
cmd_bundle() {
    require_tools jq git tar zstd timeout
    local repo="${OMABACKUP_REPO:-}" reused=0 path
    while (($#)); do
        case "$1" in
            *) die "unknown flag for bundle: $1" ;;
        esac
    done
    [[ -n "$repo" && -d "$repo/.git" ]] || die "OMABACKUP_REPO must point at a git repo (got: ${repo:-unset})"

    local cache="$OMABACKUP_STATE/bundles"
    # §11.4 is checked inside build_bundle now, so `push` gets the same proof
    # rather than only whoever typed `bundle`.
    #
    # Whether it was reused comes back FROM build_bundle now, not from
    # checking the cache path's existence before the call. A file already
    # sitting there is not the same as one build_bundle actually trusted: a
    # corrupted cache entry is detected, deleted and rebuilt from inside that
    # same call, and the existence check alone could not tell the two apart --
    # "reused" and "verified restorable" were both printed for a run that had
    # in fact just rebuilt the thing from scratch, in exactly the case where a
    # human most wants to know that it did.
    local outcome
    outcome="$(build_bundle "$repo" "$cache")" \
        || die "could not build a verifiable bundle from $(_tilde "$repo")"
    path="${outcome%$'\t'*}"; [[ "${outcome##*$'\t'}" == reused ]] && reused=1

    if (( JSON )); then
        jq -n --arg p "$path" --arg n "$(bundle_name "$repo")" \
              --argjson r "$([[ $reused == 1 ]] && echo true || echo false)" \
              --argjson b "$(stat -c %s "$path" 2>/dev/null || echo 0)" \
              '{schemaVersion:1, path:$p, publishName:$n, reused:$r, bytes:$b}'
    else
        printf '  %s%s%s %s %s(%s, verified restorable)%s\n' \
            "$GREEN" "$([[ $reused == 1 ]] && echo 'reused' || echo 'built')" "$NC" \
            "$(_tilde "$path")" "$DIM" "$(du -h "$path" | cut -f1)" "$NC"
    fi
}

# ── push ─────────────────────────────────────────────────────────────────────
# Separate verb from `sync` on purpose. Committing is local and fast; sending is
# slow and fallible, and the two must not share an exit code -- a NAS that is
# down at 3am cannot be allowed to look like a backup that failed to record.
#
# With no argument: every enabled destination whose backoff has expired, which
# is what the timer calls. With an argument: that one, ignoring backoff, because
# a human retrying on purpose should not serve out a penalty.
cmd_push() {
    require_tools jq git tar zstd timeout
    local repo="${OMABACKUP_REPO:-}" rc=0 id detail safe_detail bundle name
    local -a explicit=()
    while (($#)); do
        case "$1" in
            -*) die "unknown flag for push: $1" ;;
            *)  explicit+=("$1"); shift ;;
        esac
    done
    [[ -n "$repo" && -d "$repo/.git" ]] || die "OMABACKUP_REPO must point at a git repo (got: ${repo:-unset})"
    assert_destinations_understood
    if (( ${#explicit[@]} )); then
        for id in "${explicit[@]}"; do
            dest_target_understood "$id" || die "cannot push to that destination: ${id:-unnamed}"
        done
    fi
    # Before anything is built or sent, and covering github too: the git push
    # carries the same commit the bundle does, so gating only the bundle would
    # leave the default destination as the one hole (docs/DESIGN.md §6).
    assert_deny_understood "$SECRETS_DENY_FILE"
    report_secrets "$repo" "$SECRETS_DENY_FILE" || exit 1

    local -a targets=()
    if (( ${#explicit[@]} )); then
        targets=("${explicit[@]}")
    else
        mapfile -t targets < <(dest_ids)
        dest_has_github && targets+=(github)
    fi
    (( ${#targets[@]} )) || { printf '  %sno destinations configured%s\n' "$DIM" "$NC"; return 0; }

    # Built once and shared: content-addressed, so a tick with no new commit
    # reuses it and every destination receives the identical artifact. push
    # only needs the path; the reused/built flag build_bundle now also
    # returns is cmd_bundle's to report.
    bundle="$(build_bundle "$repo" "$OMABACKUP_STATE/bundles")" \
        || die "could not build a bundle from $(_tilde "$repo")"
    bundle="${bundle%$'\t'*}"
    name="$(bundle_name "$repo")"

    for id in "${targets[@]}"; do
        [[ -n "$id" ]] || continue
        if (( ! ${#explicit[@]} )) && dest_in_backoff "$id"; then
            printf '  %s·%s %-11s %sin backoff until %s%s\n' "$DIM" "$NC" "$id" "$DIM" \
                "$(date -d "@$(dest_state "$id" '.nextAttemptAt')" '+%H:%M' 2>/dev/null)" "$NC"
            continue
        fi
        if detail="$(push_destination "$id" "$bundle" "$name")"; then
            _dest_record_success "$id" "${detail:-0}"
            printf '  %s✓%s %-11s %s%s%s\n' "$GREEN" "$NC" "$id" "$DIM" \
                "$([[ "${detail:-0}" -gt 0 ]] 2>/dev/null && echo "sent, pruned ${detail}" || echo "sent")" "$NC"
        else
            _dest_record_failure "$id" "${detail:-unknown error}"
            safe_detail="$(tui_sanitize "${detail:-unknown error}")"
            printf '  %s✗%s %-11s %s\n' "$RED" "$NC" "$id" "$safe_detail"
            rc=1
        fi
    done
    return $rc
}

# _into_cleanup <into> <boundary>
# Removes <into> and any newly-empty ancestor directory up to, but not
# including, <boundary> -- the deepest ancestor that already existed
# before cmd_restore created anything under it (or <into> itself, when
# <into> already existed: the loop below then does nothing). rmdir -p
# alone is not safe here: it keeps climbing past whatever this specific
# call actually created, into directories that existed before and merely
# happened to be empty at this moment -- not this cleanup's to remove.
_into_cleanup() {
    local into="$1" boundary="$2" d="$into"
    [[ -n "$into" ]] || return 0
    while [[ "$d" != "$boundary" && -n "$d" && "$d" != "/" ]]; do
        rmdir "$d" 2>/dev/null || return 0
        d="$(dirname "$d")"
    done
}

# ── restore ──────────────────────────────────────────────────────────────────
_restore_tui_recovery() {
    local cli="$1" title="$2" detail="${3:-}" choice
    tui_header restore
    printf '\n%s\n' "$title"
    [[ -n "$detail" ]] && printf '%s\n' "$(_restore_tui_sanitize "$detail")"
    printf '\nWhat would you like to do?\n'
    printf '  1) Try again\n  2) Open backup settings\n  q) Cancel\n'
    while true; do
        printf 'Choose [1/2/q]: '
        tui_read_line choice || return 0
        case "$choice" in
            1) return 1 ;;
            # `env -u`, not a plain call: OMABACKUP_TUI_SUPERVISED (set by
            # bin/omabackup-tui on the whole subtree it launches) would
            # otherwise be inherited here too, suppressing this session's
            # own self-log -- but the wrapper only ever reports the OUTER
            # "restore (interactive)" action, so this genuinely separate
            # Settings visit opened from Restore's own recovery prompt
            # would then have no log record anywhere (found by review,
            # round omabackup-24).
            2) env -u OMABACKUP_TUI_SUPERVISED "$cli" config; return 2 ;;
            q|Q|$'\033') printf 'Restore cancelled.\n'; return 0 ;;
            *) printf 'Please choose 1, 2 or q.\n' ;;
        esac
    done
}

_restore_tui_sanitize() {
    # Keep this streaming: previews and applies can contain one line per
    # file, and slicing a Bash string one character at a time makes the
    # sanitizer quadratic. Strip byte-level CSI/C0/DEL first, then let a
    # stable UTF-8 locale recognize U+0080..U+009F as control code points.
    # This preserves ordinary UTF-8 continuation bytes even when the caller
    # inherited LC_ALL=C. LF is intentionally excluded because sed keeps line
    # breaks outside its pattern space.
    printf '%s' "$1" |
        LC_ALL=C sed -E \
            -e $'s/\x1b\\[[0-9;]*[A-Za-z]//g' \
            -e $'s/[\x01-\x09\x0b-\x1f\x7f]/?/g' |
        LC_ALL=C.UTF-8 sed -E 's/[[:cntrl:]]/?/g'
}

_restore_tui_sanitize_field() {
    local value
    value="$(_restore_tui_sanitize "$1")"
    # Metadata is rendered inline, unlike a child report. Do not let a
    # malformed destination id/path/date inject a second terminal line.
    value="${value//$'\n'/?}"
    printf '%s' "$value"
}

_restore_tui_cleanup_snapshot() {
    if [[ -n "${snapshot_dir:-}" ]]; then
        rm -rf -- "$snapshot_dir"
    fi
    snapshot_dir=""
    snapshot_artifact=""
}

cmd_restore_tui() {
    local cli="${OMABACKUP_ROOT}/bin/omabackup" doc rows choice index selected artifact source_artifact journal_source
    local destination path file created shown_destination shown_path shown_file shown_created shown_target hidden target target_path target_is_home home_path frozen_target current_target_path confirm plan_output apply_output rc recovery source_fd=-1 source_fd_path source_size snapshot_dir="" snapshot_artifact=""
    local -a target_args=()
    [[ -t 0 && -t 1 ]] || die "interactive restore needs a terminal; provide an artifact file"
    # The selected source is shared storage. Keep a private snapshot for the
    # whole review/apply interaction so a replacement at the original path
    # cannot make apply act on bytes different from the preview. The RETURN
    # trap is removed by its own handler, so it cannot leak into later CLI
    # functions after this TUI exits. Signals use the same cleanup because a
    # Ctrl-C is a normal way to leave an interactive terminal, not a reason to
    # strand a complete backup copy in /tmp.
    #
    # RETURN removes only itself, not INT/TERM/HUP too -- found by review
    # (round omabackup-24, confirmed independently by both reviewers): the
    # dispatch-level signal traps (bin/omabackup's own INT/TERM/HUP,
    # installed before this function ever runs) are never explicitly
    # saved here, so stripping all four back to bash's untrapped default on
    # RETURN reopened the exact false-"ok" bug the dispatch-level traps
    # exist to prevent, in the narrow window between this function
    # returning and the process actually exiting: an untrapped signal
    # there reaches the EXIT trap with $?=0 from before the signal, not the
    # signal's own 128+n convention. Leaving these three in place instead
    # is safe: _restore_tui_cleanup_snapshot is idempotent (a `local`
    # snapshot_dir out of scope after this function has returned reads as
    # unset, so it is simply a no-op), so a signal in that window still
    # exits with the correct 130/143/129 -- just without the more
    # descriptive "signal=INT" phrasing a session-scoped Ctrl-C gets
    # (bin/omabackup-tui already covers that case for the panel-launched
    # path; this is about a direct terminal invocation only).
    trap '_restore_tui_cleanup_snapshot; trap - RETURN' RETURN
    trap '_restore_tui_cleanup_snapshot; exit 130' INT
    trap '_restore_tui_cleanup_snapshot; exit 143' TERM
    trap '_restore_tui_cleanup_snapshot; exit 129' HUP

    while true; do
        if [[ -n "$snapshot_dir" ]]; then
            rm -rf -- "$snapshot_dir"
            snapshot_dir=""
            snapshot_artifact=""
        fi
        if ! doc="$(artifacts_json 2>&1)"; then
            _restore_tui_recovery "$cli" \
                "We could not read the backup locations." \
                "$doc"
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        if ! rows="$(jq -c '.destinations[] as $d | $d.artifacts[] |
            select(.valid == true) |
            select((.file | test("[\u0000-\u001f\u007f-\u009f]") | not)) |
            {destination:$d.id,path:$d.path,file:.file,createdAt:(.createdAt // "unknown")}' <<<"$doc")"; then
            _restore_tui_recovery "$cli" \
                "We could not read the backup list." \
                "The destination data is not readable right now."
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        hidden="$(jq -r '[.destinations[].artifacts[]
            | select(.valid == true)
            | select(.file | test("[\u0000-\u001f\u007f-\u009f]"))] | length' <<<"$doc" 2>/dev/null || printf '0')"
        if [[ -z "$rows" ]]; then
            if (( hidden > 0 )); then
                _restore_tui_recovery "$cli" \
                    "No usable backups found." \
                    "$hidden backup file name(s) were hidden because they contain terminal control characters. Restore one by path if you trust it."
            else
                _restore_tui_recovery "$cli" \
                    "No backups found." \
                    "Configure a backup folder or run a backup before restoring."
            fi
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi

        tui_header restore
        local -a entries=()
        while IFS= read -r selected; do entries+=("$selected"); done <<<"$rows"
        for index in "${!entries[@]}"; do
            destination="$(jq -r '.destination' <<<"${entries[$index]}")"
            path="$(jq -r '.path' <<<"${entries[$index]}")"
            file="$(jq -r '.file' <<<"${entries[$index]}")"
            created="$(jq -r '.createdAt' <<<"${entries[$index]}")"
            # Destination metadata and artifact names come from shared
            # storage. Keep their bytes intact for the real argv below, but
            # replace terminal controls in the human-facing list so a file
            # cannot clear or forge the restore prompts.
            shown_destination="$(_restore_tui_sanitize_field "$destination")"
            shown_path="$(_restore_tui_sanitize_field "$(_tilde "$path")")"
            shown_file="$(_restore_tui_sanitize_field "$file")"
            shown_created="$(_restore_tui_sanitize_field "$created")"
            printf '  %d) [%s] %s\n' "$((index + 1))" "$shown_destination" "$shown_file"
            printf '     %s  %s\n' "$shown_path" "$shown_created"
        done
        (( hidden > 0 )) && printf '\n  %d backup(s) hidden: unsafe file name.\n' "$hidden"
        while true; do
            printf '\nChoose a backup number (q to cancel): '
            tui_read_line choice || return 0
            case "$choice" in
                q|Q|$'\033') return 0 ;;
                ''|*[!0-9]*) printf 'Please choose a listed backup number or q.\n' ;;
                *)
                    # Keep the arithmetic expansion bounded. Bash arithmetic
                    # is signed and silently wraps an overlarge decimal, so
                    # an input such as 18446744073709551617 could otherwise
                    # become index 0 and select the first backup.
                    local numeric_choice="$choice"
                    while [[ ${#numeric_choice} -gt 1 && ${numeric_choice:0:1} == 0 ]]; do
                        numeric_choice="${numeric_choice:1}"
                    done
                    if (( ${#numeric_choice} > 9 )); then
                        printf 'There is no backup with that number. Choose 1-%d or q.\n' "${#entries[@]}"
                        continue
                    fi
                    index=$((10#$numeric_choice - 1))
                    if (( index >= 0 && index < ${#entries[@]} )); then
                        break
                    fi
                    printf 'There is no backup with that number. Choose 1-%d or q.\n' "${#entries[@]}"
                    ;;
            esac
        done
        selected="${entries[$index]}"
        path="$(jq -r '.path' <<<"$selected")"
        file="$(jq -r '.file' <<<"$selected")"
        artifact="$path/$file"
        source_artifact="$artifact"

        target_args=()
        while true; do
            printf '\nWhere should it go?\n'
            printf '  1) Preview folder (recommended): %s\n' "$(_tilde "$HOME/.local/state/omabackup/restore-preview")"
            printf '  2) This machine\x27s home: %s\n' "$(_tilde "$HOME")"
            printf '  3) Another folder\n'
            printf 'Choose [1/2/3/q]: '
            tui_read_line target || return 0
            case "$target" in
                q|Q|$'\033') printf 'Restore cancelled.\n'; return 0 ;;
                1)
                    target_path="$HOME/.local/state/omabackup/restore-preview"
                    target_args=(--into "$target_path")
                    break
                    ;;
                2)
                    target_path="$HOME"
                    break
                    ;;
                3)
                    printf 'Absolute target folder: (q to cancel) '; tui_read_line target_path || return 0
                    case "$target_path" in
                        q|Q|$'\033') printf 'Restore cancelled.\n'; return 0 ;;
                    esac
                    if target_path="$(_config_absolute_path "$target_path")"; then
                        target_args=(--into "$target_path")
                        break
                    fi
                    printf 'The target must be an absolute path without control characters.\n'
                    ;;
                *) printf 'Please choose 1, 2, 3 or q.\n' ;;
            esac
        done

        # Take the private copy only after the user has chosen the target and
        # immediately before preview. The source is shared storage: it may
        # disappear while the target menu is open, and a later replacement
        # must not change what the confirmation preview describes or what
        # apply consumes.
        snapshot_dir="$(mktemp -d)"
        source_fd_path="/proc/$$/fd"
        if [[ -z "$snapshot_dir" ]] \
            || [[ ! -f "$artifact" ]] \
            || ! exec {source_fd}<"$artifact" 2>/dev/null \
            || [[ ! -f "$source_fd_path/$source_fd" ]]; then
            if (( source_fd >= 0 )); then
                exec {source_fd}<&-
                source_fd=-1
            fi
            _restore_tui_recovery "$cli" \
                "This backup could not be previewed." \
                "The source may have changed or become unavailable. The restore was not applied."
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        # Copy through the already-open descriptor. A replacement of the
        # shared path after this point cannot make the snapshot contain a
        # different inode from the one whose identity is recorded below. Bash
        # cannot make the regular-file check and read open atomic; a hostile
        # writer can still win that microscopic race with a FIFO, but the
        # integrity guarantee here is the already-open regular inode.
        source_artifact="$(readlink -f -- "$source_fd_path/$source_fd" 2>/dev/null || printf '%s' "$source_artifact")"
        journal_source="$(_restore_tui_sanitize_field "$source_artifact")"
        source_size="$(stat -Lc %s "$source_fd_path/$source_fd" 2>/dev/null)" || source_size=""
        if [[ ! "$source_size" =~ ^[0-9]+$ ]] \
            || ! head -c "$source_size" <"$source_fd_path/$source_fd" >"$snapshot_dir/backup.tar.zst" 2>/dev/null \
            || [[ "$(stat -c %s "$snapshot_dir/backup.tar.zst" 2>/dev/null)" != "$source_size" ]]; then
            exec {source_fd}<&-
            source_fd=-1
            _restore_tui_recovery "$cli" \
                "This backup could not be previewed." \
                "The source may have changed or become unavailable. The restore was not applied."
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        exec {source_fd}<&-
        source_fd=-1
        snapshot_artifact="$snapshot_dir/backup.tar.zst"
        artifact="$snapshot_artifact"

        # Freeze the path before the preview and use that same canonical path
        # for apply. A menu selection is not a security boundary: a symlink
        # alias can point at HOME, and a mutable parent can otherwise change
        # between the preview and the write. The restore command rechecks
        # containment at each write too; this closes the larger TUI window and
        # makes the confirmation policy follow the resolved destination.
        target_is_home=0
        [[ "$target_path" == "$HOME" ]] && target_is_home=1
        [[ "$target_is_home" == 0 && -e "$target_path" && "$target_path" -ef "$HOME" ]] \
            && target_is_home=1
        if ! home_path="$(realpath -m -- "$HOME" 2>/dev/null)" \
            || ! frozen_target="$(realpath -m -- "$target_path" 2>/dev/null)" \
            || [[ -z "$home_path" || -z "$frozen_target" ]]; then
            _restore_tui_recovery "$cli" \
                "We could not resolve the restore target." \
                "The restore was not applied. Choose the target again and preview it once more."
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        target_path="$frozen_target"
        target_args=(--into "$target_path")
        [[ "$target_path" == "$home_path" ]] && target_is_home=1
        shown_target="$(_tilde "$target_path")"
        shown_target="$(_restore_tui_sanitize "$shown_target")"
        printf '\nChecking the selected backup against %s...\n' "$shown_target"
        plan_output="$("$cli" restore --journal-artifact "$journal_source" "$artifact" "${target_args[@]}" 2>&1)"; rc=$?
        if (( rc != 0 )); then
            _restore_tui_recovery "$cli" \
                "This backup could not be previewed." \
                "$(_restore_tui_sanitize "$plan_output")"
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        printf '%s\n' "$(_restore_tui_sanitize "$plan_output")"

        if (( target_is_home )); then
            printf '\nThis writes into the machine\x27s home and keeps replaced files in the restore journal.\n'
            while true; do
                printf 'Type RESTORE to apply, or press Enter to cancel: '
                tui_read_line confirm || return 0
                case "$confirm" in
                    RESTORE) break ;;
                    ''|n|N|q|Q|$'\033') printf 'Restore cancelled.\n'; return 0 ;;
                    *) printf 'Please type RESTORE to apply or N to cancel.\n' ;;
                esac
            done
        else
            while true; do
                printf '\nApply this plan to the selected folder? [y/N]: '
                tui_read_line confirm || return 0
                case "$confirm" in
                    y|Y|yes|YES) break ;;
                    ''|n|N|q|Q|$'\033') printf 'Restore cancelled.\n'; return 0 ;;
                    *) printf 'Please answer y to apply or n to cancel.\n' ;;
                esac
            done
        fi
        current_target_path="$(realpath -m -- "$target_path" 2>/dev/null)" || current_target_path=""
        if [[ -z "$current_target_path" || "$current_target_path" != "$target_path" ]]; then
            _restore_tui_recovery "$cli" \
                "The restore target changed while it was being reviewed." \
                "The restore was not applied. Choose the target again and preview it once more."
            recovery=$?
            case "$recovery" in
                0) return 0 ;;
                1|2) continue ;;
            esac
        fi
        apply_output="$("$cli" restore --journal-artifact "$journal_source" "$artifact" "${target_args[@]}" --apply 2>&1)"
        rc=$?
        if (( rc == 0 )); then
            printf '%s\n' "$(_restore_tui_sanitize "$apply_output")"
            return 0
        fi
        _restore_tui_recovery "$cli" \
            "The restore did not finish successfully." \
            "$(_restore_tui_sanitize "$apply_output")"
        recovery=$?
        case "$recovery" in
            0) return 0 ;;
            1|2) continue ;;
        esac
    done
}

cmd_restore() {
    local artifact="" apply=0 into="" journal_artifact=""
    while (( $# )); do
        case "$1" in
        --apply)  apply=1; shift ;;
        --into)   [[ -n "${2:-}" ]] || die "--into needs a directory"; into="$2"; shift 2 ;;
            # The TUI reviews a private snapshot, but the durable journal must
            # retain the shared bundle path the user selected. This is an
            # internal handoff flag; direct CLI restores keep using their own
            # artifact path automatically.
            --journal-artifact)
                      [[ -n "${2:-}" ]] || die "--journal-artifact needs a path"
                      [[ "$(_restore_tui_sanitize_field "$2")" == "$2" ]] \
                          || die "--journal-artifact must not contain terminal controls"
                      journal_artifact="$2"; shift 2 ;;
            # --groups and --json are real flags for this command, but the
            # global parser above already consumed them into $ONLY/$JSON
            # before this loop ever runs -- they cannot appear here. Naming
            # them in this case would be dead code pretending to handle
            # something it structurally cannot see.
            -*)       die "unknown flag for restore: $1" ;;
            *)        [[ -z "$artifact" ]] || die "restore takes one artifact, not two"
                      artifact="$1"; shift ;;
        esac
    done
    if [[ -z "$artifact" && -t 0 && -t 1 && $JSON -eq 0 ]]; then
        cmd_restore_tui
        return
    fi
    [[ -n "$artifact" ]] || die "restore needs an artifact: omabackup restore <file.tar.zst> (or run it in a terminal for the menu)"
    [[ -f "$artifact" ]] || die "no such artifact: $(_tilde "$artifact")"
    # The journal source is either the TUI's already-frozen, terminal-safe
    # label or the actual artifact path for a direct CLI restore.
    local journal_artifact_abs
    if [[ -n "$journal_artifact" ]]; then
        # The TUI resolved this identity before taking the snapshot. Do not
        # resolve it again after confirmation: the shared path may have been
        # replaced by a symlink, and the journal must describe the bundle that
        # was actually reviewed, not whatever the path points to now.
        journal_artifact_abs="$journal_artifact"
    else
        journal_artifact_abs="$(realpath -e "$artifact" 2>/dev/null || printf '%s' "$artifact")"
    fi
    local started_at; started_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    # realpath is what _restore_contained refuses on when it is missing --
    # correctly, since a containment check it cannot run is not a check. But
    # that failure is silent per file: every row would then be refused as
    # though it escaped, and "0 files would be restored" reads exactly like a
    # clean artifact with nothing to do. Checked up front, named, so a
    # recovery tty's incomplete coreutils is not mistaken for an empty backup.
    require_tools jq git tar zstd realpath timeout

    # Extracted once. The first version verified through verify_bundle, which
    # extracts into its OWN temp directory and discards it, then extracted the
    # SAME artifact file again here -- two reads of one file with a window
    # between them in which it could change. What is checked now is what is
    # used: extract, verify that exact directory, and only then read it.
    local x _extract_rc; x="$(mktemp -d)" || die "could not make a working directory"
    printf '  %schecking the artifact%s\n' "$DIM" "$NC" >&2
    _zstd_extract "$artifact" "$x"; _extract_rc=$?
    if (( _extract_rc != 0 )); then
        rm -rf "$x"
        # 124 is `timeout`'s own, specific exit code for "I intervened" --
        # found by review (round omabackup-28, `omabackup-rev-2`): every
        # OTHER extraction failure (corruption, the byte/member/depth
        # bombs) collapsed into this same generic message too, so a
        # legitimate restore from slow media that genuinely took longer
        # than OMABACKUP_RESTORE_TIMEOUT_SEC read identically to "this
        # artifact is corrupted or malicious" -- an alarming, wrong
        # conclusion for what might just be a slow USB drive or network
        # mount. Told apart here, with the one thing an operator can
        # actually do about it.
        if (( _extract_rc == 124 )); then
            die "extraction of $(_tilde "$artifact") exceeded the ${BUNDLE_EXTRACT_TIMEOUT_SEC}s time ceiling -- raise OMABACKUP_RESTORE_TIMEOUT_SEC if this artifact is legitimately large or the media is slow"
        fi
        die "could not extract $(_tilde "$artifact")"
    fi
    # 0: never run the artifact's own tool/bin/omabackup here. A PoC confirmed
    # that a crafted artifact can replace that binary and have it execute --
    # with the operator's full privileges, in plan mode, before any --apply --
    # since the artifact also controls its own SHA256SUMS and is therefore
    # self-consistent by construction. Data checks (checksums, git-bundle vs
    # worktree diff) still run; only the embedded-tool self-check is skipped.
    _verify_extracted "$x" 0 >/dev/null 2>&1 \
        || { rm -rf "$x"; die "this artifact does not verify -- refusing to restore from it"; }
    [[ -f "$x/manifest.json" ]] || { rm -rf "$x"; die "no manifest in $(_tilde "$artifact")"; }

    # The verdict, computed against the REAL machine running this command --
    # not --into's target. This went back and forth. version and channel are
    # unavoidably the real machine's: omarchy-version and
    # omarchy-channel-current are system commands, not $HOME-relative, and
    # --into cannot redirect them. An earlier version of this file computed
    # the watermark from --into's target to match it to those, on the
    # reasoning that a --into restore is "about wherever the restore actually
    # lands." That broke the more common use of --into worse than the bug it
    # fixed: --into pointed at an empty sandbox directory (no migrations
    # directory, because it is not an Omarchy home at all) read as watermark
    # 0, which is the PERMISSIVE "behind" case -- so previewing what --apply
    # would do against a scratch directory applied MORE than a real restore
    # onto the operator's own machine would have. version from one machine
    # and watermark from another is not any machine's real identity either
    # way; keeping all three on the operator's own machine is at least
    # internally consistent, and errs toward the safer verdict on the
    # far more common case (a disposable preview target) rather than the
    # rarer one (restoring onto another machine's mounted, already-populated
    # home, where booting into that machine to run the restore natively
    # answers the compatibility question correctly and this cannot).
    local verdict why
    # Captured before parsing, not <<<"$(...)" directly -- that loses
    # _restore_verdict's own exit status, and it now has one worth keeping:
    # it refuses outright when either side's migration state could not be
    # read at all, rather than silently treating "could not check" the same
    # as "fresh install." Two distinct statuses, not one message for both:
    # this machine's own state (1) and the artifact's, read from its manifest
    # (2), are different things to go fix -- a single "could not determine
    # this machine's" message sent someone to investigate a perfectly healthy
    # machine when an old artifact, built before this check existed, was what
    # actually needed rebuilding.
    local vout vrc; vout="$(_restore_verdict "$x/manifest.json")"; vrc=$?
    if (( vrc == 1 )); then
        rm -rf "$x"; die "could not determine this machine's own migration state -- refusing to judge compatibility blind (check $(_tilde "$(_expand '~/.local/state/omarchy/migrations')"): a filename there that is not a plain number is enough to cause this)"
    elif (( vrc == 2 )); then
        rm -rf "$x"; die "this artifact's own migration state could not be confirmed when it was built -- rebuild it on a healthy machine (check ~/.local/state/omarchy/migrations on the machine that built it)"
    fi
    IFS=$'\t' read -r verdict why <<<"$vout"

    # An early, partial pending record -- apply only, and best-effort (never
    # dies, same as every restore_record call). A review round pointed out
    # that the contract promises the journal is written "regardless of
    # outcome, even total failure," but every failure between here and the
    # fuller pending write later (manifest mode validation, --groups
    # filtering, restore_rows planning) used to `die` with no record ever
    # created -- the panel would see whatever the PREVIOUS --apply had left,
    # or nothing, either way indistinguishable from "this attempt never
    # happened." target is not known yet (that needs $HOME's override and
    # $into below) and is left null; the fuller write right before files
    # start moving overwrites this with the complete picture once it exists.
    if (( apply )); then
        restore_record "$(jq -n \
            --arg started "$started_at" --arg artifact "$journal_artifact_abs" \
            --arg verdict "$verdict" --arg why "$why" \
            '{schemaVersion:1, startedAt:$started, finishedAt:null,
              artifact:$artifact, target:null, verdict:$verdict, why:$why, ok:null}')"
    fi

    local HOME="${into:-$HOME}"
    # Made regardless of plan or apply: _restore_contained needs $HOME to
    # already exist (realpath -e) to resolve containment for EITHER one, and
    # the plan has to be able to say what would happen the same way apply
    # would act on it. into_created remembers whether this call is the one
    # that made it, though -- a plan run naming a --into target that did not
    # exist yet used to create it regardless, an observable write in the
    # one command that promises "nothing was written." Removed again, best-
    # effort, at the end of the plan branch below, if it is still exactly
    # what this call made: empty, and ours.
    local into_created=0 into_boundary=""
    if [[ -n "$into" ]]; then
        if [[ -d "$into" ]]; then
            into_boundary="$into"
        else
            into_created=1
            # The deepest ancestor that already exists, walked BEFORE
            # mkdir -p ever runs -- every _into_cleanup call below stops
            # there, never removing anything that existed before this
            # call. A bare `rmdir "$into"` only ever removed the FINAL
            # component mkdir -p created: a --into target nested under
            # parents that did not exist yet (--into a/b/target, none of
            # a, a/b, or a/b/target there before) left a/ and a/b/ behind
            # on every path that cleans up, not just the die sites --
            # including the ordinary plan-only run at the very end of this
            # function, which promises "nothing was written." A PoC (a
            # nested --into target against a real artifact) confirmed the
            # result: rc=0, the target itself absent, but its two parent
            # directories left on disk.
            local anc="$into"
            while [[ ! -e "$anc" && "$anc" != "/" && -n "$anc" ]]; do
                anc="$(dirname "$anc")"
            done
            into_boundary="$anc"
        fi
        # into_created used here too, not only at the three die sites
        # after this one -- mkdir -p can fail partway (an intermediate
        # component created, a later one refused) and still leave
        # something behind at or under $into, and this die skipped the
        # same cleanup every later one already gets.
        mkdir -p "$into" || {
            _into_cleanup "$into" "$into_boundary"
            rm -rf "$x"; die "could not make $(_tilde "$into")"
        }
    fi

    # Captured before the override two lines down replaces it -- this
    # machine's OWN, locally-installed groups.default.json, not the
    # artifact's. restore_rows uses it as a floor under `coupled`, never a
    # ceiling: an artifact is free to mark something coupled that this
    # machine's schema does not know about, but not to mark something
    # UNcoupled that this machine's own trusted schema says is.
    local operator_groups_file="$GROUPS_FILE"

    # Described by the manifest that made it. A restore driven by whatever
    # manifest this machine carries would look for groups the artefact never
    # had, and would place files by rules written after it.
    local GROUPS_FILE="$x/tool/groups.default.json"
    # Nothing has been written to $into by this point, on a plan OR an
    # apply run -- the same "empty and ours" reasoning the plan-only
    # cleanup below is built on applies equally here, before the plan/apply
    # branches ever split. A PoC (a --into target that did not exist yet,
    # and restore_rows made to fail) confirmed the gap: this command
    # returned 1, but the target directory it had just created stayed
    # behind, an observable write from a run that made none.
    [[ -f "$GROUPS_FILE" ]] || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "the artifact carries no manifest of its own"
    }
    # assert_manifest_understood validates mode against KNOWN_MODES for
    # THIS machine's own manifest, at collect time -- restore_rows never
    # ran the same check against the ARTIFACT's own tool/groups.default.json.
    # Every mode restore_rows recognizes is checked explicitly (gm==gen,
    # kind==tree/flat); anything else fell through to the ordinary
    # copy-restore path unconditionally. A PoC (a group declared
    # mode:future-mode, a semantics this build has never heard of) confirmed
    # the result: restore_rows planned and offered a plain `restore` row for
    # it anyway, as though an unknown mode were simply mode:copy -- an
    # artifact built by a newer version of this tool, using a mode this one
    # does not understand, would be applied by guesswork rather than refused.
    local badm; badm="$(jq -r --argjson m "$KNOWN_MODES" \
        '.groups[]? | select(.mode as $x | $m | index($x) | not) | "\(.id) (mode \(.mode))"' \
        "$GROUPS_FILE")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not check this artifact's own manifest for modes this build understands"
    }
    if [[ -n "$badm" ]]; then
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "this artifact's own manifest declares a mode this build does not understand: $badm"
    fi
    # Same reasoning as assert_manifest_understood's own duplicate-id check,
    # run here against the ARTIFACT's manifest specifically -- a review round's
    # PoC built exactly this: an artifact declaring an enabled group "g" and a
    # second object ALSO id:"g" but enabled:false. group_field/group_paths
    # (used throughout restore_rows below) matched both and merged them, so
    # the disabled duplicate's own paths still ended up restored as part of
    # the enabled group's plan. group_field/group_paths were fixed to filter
    # enabled themselves too, but an artifact is untrusted input regardless --
    # this refuses the ambiguity outright rather than depending on every
    # future caller of those two functions getting the filter right.
    local badd; badd="$(jq -r '.groups | group_by(.id) | .[] | select(length > 1) | .[0].id' \
        "$GROUPS_FILE")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not check this artifact's own manifest for duplicate group ids"
    }
    if [[ -n "$badd" ]]; then
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "this artifact's own manifest declares the same group id more than once: $badd"
    fi
    # Same reasoning as assert_manifest_understood's tab/newline path check,
    # run here against the ARTIFACT's manifest: restore_rows' row format and
    # the plan JSON built from it are both tab-framed, and a `live` value
    # carrying an embedded tab or newline (a legal filesystem byte, refused
    # here anyway because it is not a legal byte in this framing) desynced
    # what the plan reported from what --apply actually wrote.
    local badp; badp="$(jq -r '
        .groups[] | . as $g | ((.paths // [])[] | if type=="object" then .live else . end)
        | select(test("[\t\n]")) | $g.id' "$GROUPS_FILE")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not check this artifact's own manifest for unsafe path characters"
    }
    if [[ -n "$badp" ]]; then
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "this artifact's own manifest declares a path with a tab or newline in group(s): $(printf '%s' "$badp" | tr '\n' ' ')"
    fi
    # Deferred from the top-level check, which runs against this machine's own
    # manifest -- wrong file for restore. Checked here, now that $GROUPS_FILE
    # is the artifact's.
    local badg; badg="$(_assert_groups_filter_understood)" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "--groups names a group this artifact's manifest does not have: $badg"
    }

    local rows; rows="$(restore_rows "$x" "$verdict" "$operator_groups_file")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not plan against the artifact's own manifest"
    }

    # Both queries' own status is checked, not only their content: a review
    # round pointed out that a query that FAILS (not "the field is absent,"
    # which // "unknown" / // "0" already handle as a real default, but jq
    # itself erroring) previously left $bv/$bm empty, and an empty $bm still
    # passed straight through to the non-numeric-fallback guard below as
    # though it had been legitimately read as zero -- the exact "an unknown
    # failure quietly reads as a known-good value" shape this project treats
    # as its central defect class, one field over from where it was already
    # guarded.
    local bv bm
    bv="$(jq -r '.omarchy.version // "unknown"' "$x/manifest.json")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not read this artifact's own Omarchy version from its manifest"
    }
    bm="$(jq -r '.omarchy.migrationWatermark // "0"' "$x/manifest.json")" || {
        _into_cleanup "$into" "$into_boundary"
        rm -rf "$x"; die "could not read this artifact's own migration watermark from its manifest"
    }
    # Guarded the same way _restore_verdict guards its own copy. Unguarded, a
    # watermark that is not a bare integer -- read straight from a manifest
    # field nothing here controls -- reached --argjson as a literal and jq
    # refused it, with the refusal landing on stderr and the command exiting 0:
    # the JSON surface this feeds (the panel, eventually) got nothing and a
    # success code in the same breath.
    [[ "$bm" =~ ^[0-9]+$ ]] || bm=0

    # Printed once, before the plan/apply branches split -- not only on a plan,
    # and not at all in JSON mode (where verdict/why ride inside the object
    # each branch prints below). It used to live inside the plan-only, non-JSON
    # branch, so the run that actually changes the machine reported how many
    # files it touched and never why: the verdict and its explanation are the
    # report DESIGN.md §12.1/§12.2 asks for, and they are least dispensable on
    # the run that writes.
    if (( ! JSON )); then
        printf '\n  %sfrom%s Omarchy %s, migrated through %s\n' "$DIM" "$NC" "$bv" \
            "$(date -d "@$bm" '+%Y-%m-%d' 2>/dev/null || printf '%s' "$bm")"
        case "$verdict" in
            quarantine) printf '  %s!%s %s\n' "$YELLOW" "$NC" "$why" ;;
            *)          printf '  %s·%s %s\n' "$DIM" "$NC" "$why" ;;
        esac
    fi

    # new vs replaced is a question `restore_rows` never answers on its own --
    # its rows say WHAT would be written, not whether something is already
    # sitting at that destination. Checked here, once, against the exact same
    # $dest a plan or an apply would act on (this runs before either branch,
    # under the same $HOME=${into:-$HOME} override both use), so the count is
    # true of whichever one actually happens next. -L alongside -e: a
    # dangling symlink already at $dest is something a restore would still
    # replace, and -e alone is false for one.
    #
    # A snapshot, not a promise: for a PLAN this can go stale before an
    # operator ever runs the --apply it describes (the handoff is to a
    # separate terminal, on the operator's own schedule, possibly minutes
    # later) -- something could appear or disappear at $dest in between. Not
    # a safety gap: _restore_one makes its own -e/-L check at write time
    # regardless of what this counted, so nothing is ever overwritten (or not)
    # based on a stale read. This is informational only, and a UI should not
    # present it as a guarantee.
    local a g rel dest nr=0 nq=0 nrep=0 na=0 nheld=0 nesc=0 nnew=0 nreplaced=0
    while IFS=$'\t' read -r a g rel dest; do
        [[ -n "$a" ]] || continue
        case "$a" in
            restore)    nr=$((nr + 1))
                        if [[ -e "$dest" || -L "$dest" ]]; then nreplaced=$((nreplaced + 1))
                        else nnew=$((nnew + 1)); fi ;;
            quarantine) nq=$((nq + 1)) ;;
            report)     nrep=$((nrep + 1)) ;;
            ambiguous)  na=$((na + 1)) ;;
            held)       nheld=$((nheld + 1)) ;;
            escape)     nesc=$((nesc + 1)) ;;
        esac
    done <<<"$rows"

    # Blocked, not just counted: ambiguous and escape are the two row kinds
    # that mean this artifact and this target actively disagree (a flattened
    # collision, a destination outside the target home) -- the restore-panel
    # mockup round asked for a single signal a UI can gate a handoff CTA on,
    # rather than making every consumer re-derive "is this plan safe to act
    # on" from six separate counters itself.
    local blocked; blocked=$([[ $na -gt 0 || $nesc -gt 0 ]] && echo true || echo false)

    # Absolute, always -- $HOME here is already the effective target
    # (into:-$HOME, set above before either branch), so this is the same
    # canonicalization for a --into preview directory and for the real home;
    # a restore-picking UI showing this MUST say which machine's real home it
    # is about to touch, per the restore-panel mockup round.
    #
    # realpath -e deliberately RESOLVES symlinks -- a review round noted this
    # is a conscious choice, not an accident: on a machine where $HOME is
    # itself a symlink (/home/user -> /mnt/data/user), this field names the
    # real physical location the write lands on, not the nominal path a shell
    # would print. That is the more useful fact for a field whose whole
    # purpose is "which real place is about to be touched" -- the CLI command
    # a UI hands to the terminal still uses $HOME as typed, and the two can
    # cosmetically differ; they name the same place either way.
    local target_mode="home" target_path
    [[ -n "$into" ]] && target_mode="into"
    target_path="$(realpath -e "$HOME" 2>/dev/null || printf '%s' "$HOME")"

    if (( ! apply )); then
        if (( JSON )); then
            # Every jq call that contributes to the document is checked now --
            # a review round confirmed the gap directly: a jq wrapper made to
            # fail on only ONE of these (rows_json, the groups summary, or the
            # final assembly) made `restore --json` print NOTHING and still
            # exit 0. A consumer that trusts exit status over content -- which
            # is the whole point of using --json instead of scraping text --
            # would read that as "an empty, trivially successful plan," not as
            # the command having failed to report at all.
            local rows_json counts_json groups_json plan_json
            rows_json="$(printf '%s' "$rows" | jq -R -s '
                split("\n") | map(select(length > 0) | split("\t")
                | {action:.[0], group:.[1], repo:.[2], dest:.[3]})')" \
                || { rm -rf "$x"; _into_cleanup "$into" "$into_boundary"
                     die "could not serialize the plan's rows to JSON"; }
            counts_json="$(jq -n --argjson r "$nr" --argjson q "$nq" \
                --argjson h "$nheld" --argjson a "$na" --argjson g "$nrep" --argjson e "$nesc" \
                --argjson nn "$nnew" --argjson nrp "$nreplaced" \
                '{restore:$r, new:$nn, replaced:$nrp, quarantine:$q, held:$h,
                  ambiguous:$a, report:$g, escape:$e}')" \
                || { rm -rf "$x"; _into_cleanup "$into" "$into_boundary"
                     die "could not serialize the plan's counts to JSON"; }
            groups_json="$(printf '%s' "$rows_json" | jq '
                group_by(.group) | map({
                    id: .[0].group,
                    restore: (map(select(.action=="restore"))|length),
                    quarantine: (map(select(.action=="quarantine"))|length),
                    held: (map(select(.action=="held"))|length),
                    ambiguous: (map(select(.action=="ambiguous"))|length),
                    report: (map(select(.action=="report"))|length),
                    escape: (map(select(.action=="escape"))|length)})')" \
                || { rm -rf "$x"; _into_cleanup "$into" "$into_boundary"
                     die "could not serialize the plan's group summary to JSON"; }
            plan_json="$(jq -n --arg verdict "$verdict" --arg why "$why" --arg version "$bv" \
                --argjson watermark "$bm" --argjson blocked "$blocked" \
                --arg tmode "$target_mode" --arg tpath "$target_path" \
                --argjson counts "$counts_json" --argjson rows "$rows_json" --argjson groups "$groups_json" \
                '{schemaVersion:1, verdict:$verdict, why:$why, blocked:$blocked,
                  target:{mode:$tmode, path:$tpath},
                  from:{version:$version, migrationWatermark:$watermark},
                  counts:$counts, groups:$groups, rows:$rows}')" \
                || { rm -rf "$x"; _into_cleanup "$into" "$into_boundary"
                     die "could not build the plan's JSON document"; }
            printf '%s\n' "$plan_json"
            rm -rf "$x"
            return 0
        fi
        printf '\n'
        printf '  %s%s files would be restored%s' "$GREEN" "$nr" "$NC"
        (( nq )) && printf ', %s%s quarantined%s' "$YELLOW" "$nq" "$NC"
        (( nheld )) && printf ', %s%s held (migration markers)%s' "$DIM" "$nheld" "$NC"
        (( na )) && printf ', %s%s ambiguous%s' "$YELLOW" "$na" "$NC"
        (( nesc )) && printf ', %s%s refused (outside the target)%s' "$RED" "$nesc" "$NC"
        (( nrep )) && printf ', %s%s to read yourself%s' "$DIM" "$nrep" "$NC"
        printf '\n'
        while IFS=$'\t' read -r a g rel dest; do
            [[ -n "$a" ]] || continue
            case "$a" in
                restore)    printf '    %s→%s %-11s %s\n' "$GREEN" "$NC" "$g" "$(_tilde "$dest")" ;;
                quarantine) printf '    %s⊘%s %-11s %s %s(coupled, not applied)%s\n' \
                                "$YELLOW" "$NC" "$g" "$(_tilde "$dest")" "$DIM" "$NC" ;;
                held)       printf '    %s·%s %-11s %s %s(migration marker, not restored on a forward move)%s\n' \
                                "$DIM" "$NC" "$g" "$(_tilde "$dest")" "$DIM" "$NC" ;;
                ambiguous)  printf '    %s?%s %-11s %s %s(the repo flattens several directories into one)%s\n' \
                                "$YELLOW" "$NC" "$g" "$(_tilde "$dest")" "$DIM" "$NC" ;;
                escape)     printf '    %s✗%s %-11s %s %s(resolves outside the target home -- refused)%s\n' \
                                "$RED" "$NC" "$g" "$dest" "$DIM" "$NC" ;;
                report)     printf '    %s·%s %-11s %s %s(a list to act on, not a file to place)%s\n' \
                                "$DIM" "$NC" "$g" "$rel" "$DIM" "$NC" ;;
            esac
        done <<<"$rows"
        printf '\n  nothing was written. %somabackup restore %s --apply%s to do it\n' \
            "$CYAN" "$(_tilde "$artifact")" "$NC"
        rm -rf "$x"
        # rmdir, not rm -rf: only removes it if it is still exactly empty,
        # i.e. nothing else raced to use it since this call created it a few
        # lines up. Best-effort -- a failure here (already gone, no longer
        # empty, a permissions oddity) is not this command's problem to
        # report, and the promise this keeps is "created nothing," not
        # "guaranteed to remove everything ever placed at this path."
        _into_cleanup "$into" "$into_boundary"
        return 0
    fi

    # Unique even against itself. Named by mktemp rather than by the second,
    # since two restores in the same second used to share this directory -- and
    # a file replaced by both would have had its original backup overwritten by
    # the intermediate version, in the one place that exists to keep originals.
    # Created only here, in the apply branch: a plan run used to make this
    # directory too, so "nothing was written" was said after something already
    # had been.
    # started_at/journal_artifact_abs are already set, from the top of this
    # function -- startedAt names when this restore ATTEMPT began, not when
    # writing began, so an early preflight failure's pending record (below)
    # and this one agree on what "started" meant.
    local base
    mkdir -p "$OMABACKUP_STATE/restore" 2>/dev/null \
        || { rm -rf "$x"; die "could not make $(_tilde "$OMABACKUP_STATE/restore")"; }
    base="$(mktemp -d "$OMABACKUP_STATE/restore/$(date -u '+%Y%m%d-%H%M%S')-XXXX")" \
        || { rm -rf "$x"; die "could not make a directory to keep replaced files in"; }
    local backup="$base/replaced" quar="$base/quarantine"
    mkdir -p "$backup" || { rm -rf "$x"; die "could not make $(_tilde "$backup")"; }
    # $quar has to exist before the quarantine branch can check containment
    # against it -- realpath -e, deliberately, needs a real directory to
    # resolve, and one made lazily by mkdir -p alongside the write it was
    # meant to guard would have to exist already to pass that very check.
    mkdir -p "$quar" || { rm -rf "$x"; die "could not make $(_tilde "$quar")"; }

    # A PENDING record, written before a single file moves -- a review round
    # pointed out that without this, a process killed partway through the
    # loop below (the exact moment the panel's handoff-and-wait exists to
    # observe) left the PREVIOUS run's record in place, reporting an old
    # success as though it were this run's outcome. finishedAt/ok stay null
    # until the real one overwrites this after the loop; a reader that only
    # ever sees this pending shape (the process died before finishing) now
    # has an honest "incomplete," never a stale "done."
    restore_record "$(jq -n \
        --arg started "$started_at" --arg artifact "$journal_artifact_abs" \
        --arg tmode "$target_mode" --arg tpath "$target_path" \
        --arg verdict "$verdict" --arg why "$why" \
        '{schemaVersion:1, startedAt:$started, finishedAt:null,
          artifact:$artifact, target:{mode:$tmode, path:$tpath},
          verdict:$verdict, why:$why, ok:null}')"

    local ok=0 bad=0 qok=0 qbad=0
    while IFS=$'\t' read -r a g rel dest; do
        [[ -n "$a" ]] || continue
        case "$a" in
            restore)
                if _restore_one "$x" "$rel" "$dest" "$backup"; then ok=$((ok + 1))
                else bad=$((bad + 1))
                     printf '  %s✗%s %s\n' "$RED" "$NC" "$(_tilde "$dest")" >&2; fi ;;
            quarantine)
                # $g is a group id straight from the artifact's manifest, and
                # nothing about a group id was ever validated -- an artifact
                # naming one "../../../../../tmp/x" wrote there directly,
                # outside $quar entirely, with rc=0 and no escape row to catch
                # it: escape only ever guarded the live destination a `restore`
                # row computes, never this one.
                if _path_contained "$quar/$g/$rel" "$quar" \
                    && mkdir -p "$quar/$g/$(dirname "$rel")" 2>/dev/null \
                    && cp -Pp "$x/worktree/$rel" "$quar/$g/$rel" 2>/dev/null
                then qok=$((qok + 1))
                else qbad=$((qbad + 1))
                     printf '  %s✗%s could not quarantine %s/%s\n' "$RED" "$NC" "$g" "$rel" >&2; fi ;;
        esac
    done <<<"$rows"

    # Recorded regardless of how this run turns out to be reported below --
    # partially, or entirely, failed included. This is the ONLY way the panel
    # (which never runs --apply itself; it hands the operator a command for
    # their own terminal) can ever learn what happened once that terminal
    # closes. A restore that fails to save its own receipt still reports its
    # real outcome on stdout/exit status; restore_record swallows its own
    # failure rather than turning a state-directory write into the reason the
    # actual restore gets reported as having failed.
    local finished_at run_ok journal_doc; finished_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    run_ok=$([[ $bad -eq 0 && $qbad -eq 0 && $nesc -eq 0 && $na -eq 0 ]] && echo true || echo false)
    # journal_doc's own build is checked before restore_record ever sees it --
    # a review round found the inner jq -n's status thrown away entirely: a
    # wrapper failing that ONE call made restore_record receive an empty
    # string, which it happily wrote as a valid-looking (but empty) file,
    # `mv`'d into place with rc=0 -- a real, successful --apply left a journal
    # indistinguishable from "nothing here to read." The PENDING record
    # written before the loop above is deliberately left in place on this
    # path instead: an honest "started, outcome unknown" beats an empty file
    # that looks like a parseable non-answer.
    if journal_doc="$(jq -n \
        --arg started "$started_at" --arg finished "$finished_at" \
        --arg artifact "$journal_artifact_abs" --arg tmode "$target_mode" --arg tpath "$target_path" \
        --arg verdict "$verdict" --arg why "$why" \
        --argjson ok "$ok" --argjson bad "$bad" --argjson qok "$qok" --argjson qbad "$qbad" \
        --argjson held "$nheld" --argjson ambiguous "$na" --argjson escaped "$nesc" \
        --arg backup "$backup" --arg quar "$quar" --argjson runok "$run_ok" \
        '{schemaVersion:1, startedAt:$started, finishedAt:$finished,
          artifact:$artifact, target:{mode:$tmode, path:$tpath},
          verdict:$verdict, why:$why,
          restored:$ok, failed:$bad, quarantined:$qok, quarantineFailed:$qbad,
          held:$held, ambiguous:$ambiguous, escaped:$escaped,
          replacedAt:$backup, quarantineAt:$quar, ok:$runok}')" && [[ -n "$journal_doc" ]]
    then
        restore_record "$journal_doc"
    else
        printf 'omabackup: could not build the restore journal document -- the pending record from the start of this run was left in place\n' >&2
    fi

    if (( JSON )); then
        local apply_json
        apply_json="$(jq -n --arg verdict "$verdict" --arg why "$why" \
            --argjson ok "$ok" --argjson bad "$bad" --argjson qok "$qok" --argjson qbad "$qbad" \
            --argjson held "$nheld" --argjson ambiguous "$na" --argjson escaped "$nesc" \
            --arg backup "$backup" --arg quar "$quar" \
            '{schemaVersion:1, verdict:$verdict, why:$why,
              restored:$ok, failed:$bad, quarantined:$qok, quarantineFailed:$qbad,
              held:$held, ambiguous:$ambiguous, escaped:$escaped,
              replacedAt:$backup, quarantineAt:$quar}')" \
            || { rm -rf "$x"; die "restore wrote its files but could not build the JSON result document -- check the journal at $(_tilde "$OMABACKUP_STATE/$RESTORE_LAST_FILE_REL") for what actually happened"; }
        printf '%s\n' "$apply_json"
    else
        printf '  %s✓%s restored %s files\n' "$GREEN" "$NC" "$ok"
        (( bad )) && printf '  %s✗%s %s could not be written\n' "$RED" "$NC" "$bad" >&2
        (( qok )) && printf '  %s⊘%s %s coupled files held at %s\n' \
            "$YELLOW" "$NC" "$qok" "$(_tilde "$quar")"
        (( qbad )) && printf '  %s✗%s %s coupled files could not be quarantined -- they are neither restored nor held anywhere%s\n' \
            "$RED" "$NC" "$qbad" "" >&2
        # escape, ambiguous and held were counted before the plan/apply split
        # but only ever shown in the plan's own printout -- an apply run that
        # hit any of them said nothing, and rc stayed 0: the plan's warning and
        # the apply's silence about the very same rows disagreed.
        (( nesc )) && printf '  %s✗%s %s refused (outside the target home)\n' "$RED" "$NC" "$nesc" >&2
        (( na )) && printf '  %s?%s %s ambiguous (the repo flattens several directories into one)\n' \
            "$YELLOW" "$NC" "$na" >&2
        (( nheld )) && printf '  %s·%s %s migration marker(s) not restored, this being a forward move\n' \
            "$DIM" "$NC" "$nheld"
        printf '  %swhat was replaced is at %s%s\n' "$DIM" "$(_tilde "$backup")" "$NC"
    fi
    rm -rf "$x"
    # escape and ambiguous were counted before the split and shown in both the
    # plan and (since the round that added this) the apply summary, but never
    # factored into the exit status -- a restore where every single row was
    # refused as escape or ambiguous still exited 0, "restored 0 files," which
    # to anything scripted against this command reads identically to an
    # artifact that genuinely had nothing to restore.
    (( bad == 0 && qbad == 0 && nesc == 0 && na == 0 ))
}

cmd_status() {
    local ov oc om tv github_url; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"
    tv="$(_tool_version)"
    github_url="$(dest_github_push_url || true)"
    if (( JSON )); then
        # Destinations belong here, never in verify --json. verify's exit code
        # gates the commit (cmd_sync), so folding a stale NAS into it would let
        # a disconnected drive block the source of truth -- the inverse of §3's
        # "one destination failing does not invalidate the others". This
        # document reports recorded state and never probes the network, so the
        # panel can poll it as often as it likes.
        jq -n --arg v "$ov" --arg c "$oc" --arg m "$om" --arg s "$STAGING" \
              --argjson t "$(jq '.supportedTargets' "$GROUPS_FILE")" \
              --argjson d "$(destinations_json 2>/dev/null || echo '[]')" \
              --argjson sch "$(scheduler_active && echo true || echo false)" \
              --argjson stale "$(is_stale && echo true || echo false)" \
              --argjson lastsync "$(last_sync_stamp || echo null)" \
              --argjson age "$(last_sync_age || echo null)" \
              --argjson syncsched "$(timer_schedule omabackup-sync.timer | jq -R 'select(length>0)' || echo null)" \
              --argjson pushsched "$(timer_schedule omabackup-push.timer | jq -R 'select(length>0)' || echo null)" \
              --argjson synccron "$(timer_schedule_cron omabackup-sync.timer | jq -R 'select(length>0)' || echo null)" \
              --argjson pushcron "$(timer_schedule_cron omabackup-push.timer | jq -R 'select(length>0)' || echo null)" \
              --arg toolversion "$tv" \
              --arg repo "${OMABACKUP_REPO:-}" \
              --arg destfile "$DESTINATIONS_FILE" \
              --arg denyfile "$SECRETS_DENY_FILE" \
              --arg statedir "$OMABACKUP_STATE" \
              --arg githubUrl "$github_url" \
              --argjson githubActive "$( [[ -n "$github_url" ]] && echo true || echo false )" \
              --argjson lastrestore "$(restore_last_json || echo null)" \
              '{schemaVersion:1, tool:{version:$toolversion},
                omarchy:{version:$v,channel:$c,migrationWatermark:$m},
                supportedTargets:$t, staging:$s, destinations:$d,
                scheduler:{active:$sch, fix:"omabackup install",
                           sync:$syncsched, push:$pushsched,
                           syncCron:$synccron, pushCron:$pushcron},
                config:{repo:$repo, destinationsFile:$destfile,
                        denyList:$denyfile, state:$statedir,
                        github:{remote:"origin", configured:$githubActive,
                                active:$githubActive,
                                url:(if $githubUrl == "" then null else $githubUrl end)}},
                stale:$stale, lastSync:$lastsync, lastSyncAgeSec:$age,
                lastRestore:$lastrestore}'
    else
        printf '  Omarchy %s (%s) - migration watermark %s\n' "$ov" "$oc" "$om"
        printf '  restore range: %s\n' "$(jq -r '.supportedTargets|join(", ")' "$GROUPS_FILE")"
        printf '  groups: %s\n' "$(groups_ids | wc -l)"
        printf '  staging: %s\n' "$([ -d "$STAGING" ] && _tilde "$STAGING" || echo 'not collected yet')"
    fi
}

# Print the installed plugin version from the same manifest that status and
# the Omarchy plugin registry use. This is useful over SSH and gives the panel
# a stable, machine-readable version without adding a second version file.
cmd_version() {
    reject_flags version "$@"
    local tv; tv="$(_tool_version)"
    if (( JSON )); then
        jq -n --arg v "$tv" '{schemaVersion:1, version:$v}'
    else
        printf 'OmaBackup %s\n' "$tv"
    fi
}

# Internal only -- not printed in the usage text below. bin/omabackup-tui
# calls this on the exact CLI path it just ran, instead of sourcing
# lib/log.sh and deriving OMABACKUP_ROOT itself: the panel's own CLI
# resolution (Panel.qml's resolveProc) prefers PATH over the plugin
# directory, so a `dirname/dirname` derivation from $cli silently breaks
# on a machine where `omabackup` is actually on PATH -- passes every test,
# which always invokes this repo's own binary directly, and breaks only in
# the one production shape testing does not cover. Found by design review
# (herdr-ask round omabackup-10). Calling the CLI it already trusts avoids
# the derivation question entirely and keeps rotation/pruning to one
# implementation instead of two racing processes.
cmd_log_event() {
    (($# == 2 || $# == 3)) || die "usage: omabackup log-event ACTION OUTCOME [DETAIL]"
    # Calls _log_write directly, not _log_run_on_failure -- every caller of
    # this subcommand (bin/omabackup-tui's own _on_exit, and Panel.qml's
    # two panel-detected-failure sites) already decided its own outcome and
    # is rare by construction (one interactive session, or 900s of silence),
    # so the coalescing state machine (`.last-*` files, "only log a
    # transition") that verify/status need for constant polling does not
    # apply here and would only add unneeded state.
    _log_write "$1" "$2" "${3:-}"
}

# Internal only -- not printed in the usage text below. Panel.qml's
# busyTimeoutTimer (and an output-size guard) spawns this against a
# verify/status/sync/collect/switch process it launched wrapped in `setsid
# --`, because QuickShell.Io.Process itself has no group-kill: both its
# `running = false` and its `signal()` method call a bare, single-PID
# `kill(2)` (confirmed directly against quickshell-mirror/quickshell's own
# process.cpp, the source for the 0.3.1-1 build this machine has
# installed) -- so a timed-out `omabackup verify` that was itself blocked
# waiting on a `git` or `rsync` child left that child orphaned and still
# running after the panel gave up on it. Flagged in marketplace security
# review (https://github.com/omacom/omarchy-plugin-marketplace/issues/3968).
#
# Exposed as a subcommand rather than reimplemented in QML (design
# consultation, herdr-ask round omabackup-11, both reviewers independently
# converged on this): this project already spent several review rounds
# getting process-group signal handling right once, in
# bin/omabackup-tui's own _group_pgid_wait/_stop_group -- opening a SECOND
# implementation, in QML, with no test suite exercising it, invites a
# third. Confirmed live (headless `qs -p`, a throwaway probe script, no
# panel config involved) that QuickShell's own Process does NOT put its
# child in a new process group -- `ps -o pid=,pgid=` on a bare
# Process-launched `sh` showed the two numbers differ -- which is exactly
# why `setsid --` in front of the target command works (a caller that is
# not already a process-group leader is what makes `setsid` exec in
# place rather than fork, per its own manual page) and also why the guard
# below matters: any target that skipped `setsid` -- a wiring mistake, not
# a hypothetical -- shares the exact process group this subcommand itself
# was spawned into, and blasting that group would take down the panel
# along with it.
cmd_kill_group() {
    reject_flags kill-group "${@:2}"
    local pid="${1:-}"
    # ^[1-9][0-9]*$, not ^[0-9]+$ -- found by review (round omabackup-25):
    # `0` matched the old pattern and reached _kg_stop_group's fallback
    # branch as a plain `kill -TERM "$pid"`. kill(2) treats pid 0 as its
    # OWN special case, distinct from the -1 broadcast this file already
    # guards against: it signals every process in the CALLER's own
    # process group -- and the caller here, `omabackup kill-group` itself,
    # shares QuickShell's own group whenever it was invoked normally (the
    # exact premise that motivated `setsid --` in the first place).
    # Reproduced live in an isolated setsid session: `kill-group 0` killed
    # the whole group, script included -- confirmed the same way, not
    # merely reasoned about.
    #
    # Excludes 1 too, not just 0 -- `omabackup-rev`'s round-25 finding: a
    # target that skipped setsid (or any caller passing pid 1 by mistake)
    # would have `ps -o pgid= -p 1` report pgid 1, which _kg_stop_group's
    # own `pgid != 1` guard correctly refuses as a GROUP target -- but that
    # refusal falls through to the single-pid branch, which would then run
    # a bare `kill -TERM 1` against the real init/systemd process. Rejected
    # here, before either branch of _kg_stop_group ever runs.
    [[ "$pid" =~ ^[1-9][0-9]*$ && "$pid" != 1 ]] \
        || die "kill-group needs a numeric pid greater than 1"
    _kg_stop_group "$pid" TERM
}

# _kg_stop_group <pid> <signal> -- TERM (then KILL after ~1s if still
# alive) the process GROUP $pid names, trusting $pid AS that group's own
# id rather than rediscovering it via `ps -o pgid= -p "$pid"` first.
#
# That rediscovery step is what an earlier version of this function did,
# and it had a real gap -- found by review (round omabackup-26,
# `omabackup-rev`): `ps -p "$pid"` can only answer while a process with
# that exact pid is still alive. If the setsid-wrapped LEADER this pid
# names has already exited by the time this runs (this subcommand starts
# bash, sources several lib/*.sh files, then reaches this point -- not
# instant), `ps` finds nothing, and the old code fell through to a
# single-pid signal against an already-dead pid, silently reaching no one
# -- including any child the leader spawned and left behind, the exact
# descendant this whole mechanism exists to catch.
#
# The fix: every legitimate caller of this subcommand setsid-wraps its
# target first (see Panel.qml's own command: entries), which means $pid
# IS $pid's own process-group id at the moment it was captured, by
# construction -- not something that needs rediscovering. That group id
# keeps meaning the same thing even after the specific leader process
# exits, for as long as any OTHER member (an orphaned child) is still
# alive in it -- `kill -0 -- "-$pid"` asks exactly that question, and
# needs no still-alive leader to answer it.
#
# Still guarded, not blind trust: refuses `$pid` as a group id when it
# equals this process's OWN pgid (never blast the caller's own group) or
# is 0 or 1 (cmd_kill_group's own input validation already rejects both
# before this ever runs, but the check stays here too as the second half
# of defense in depth, matching this file's own established pattern for
# security-relevant guards). Anything that fails the group check --
# including the ordinary case of $pid simply not being a real group at
# all -- falls back to a plain single-pid signal, the same as it always
# did.
_kg_stop_group() {
    local pid="$1" signal="${2:-TERM}" own_pgid
    own_pgid="$(ps -o pgid= -p "$$" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$pid" != "$own_pgid" && "$pid" != 0 && "$pid" != 1 ]] \
            && kill -0 -- "-$pid" >/dev/null 2>&1; then
        kill -"$signal" -- "-$pid" >/dev/null 2>&1 || true
        for _ in {1..20}; do
            kill -0 -- "-$pid" >/dev/null 2>&1 || return 0
            sleep 0.05
        done
        kill -KILL -- "-$pid" >/dev/null 2>&1 || true
    else
        kill -"$signal" "$pid" >/dev/null 2>&1 || true
        for _ in {1..20}; do
            kill -0 "$pid" >/dev/null 2>&1 || return 0
            sleep 0.05
        done
        kill -KILL "$pid" >/dev/null 2>&1 || true
    fi
}

# ── artifacts ────────────────────────────────────────────────────────────────
# What `restore` could be pointed at. Exists because a restore-picking UI
# cannot list a `dir` destination itself -- Quickshell.Io.Process is the only
# I/O the panel is allowed, the same invariant status/verify already honor --
# and because "no artifacts here" and "could not tell" must never render the
# same way to a human about to trust one of these to restore their machine.
cmd_artifacts() {
    reject_flags artifacts "${@}"
    require_tools jq find zstd tar
    if (( JSON )); then
        artifacts_json
    else
        local doc; doc="$(artifacts_json)"
        local n; n="$(jq '.destinations | length' <<<"$doc")"
        if (( n == 0 )); then
            printf '  %sno dir destinations configured%s\n' "$DIM" "$NC"
            return 0
        fi
        # "-" for a null error, not "": read with IFS=$'\t' collapses
        # consecutive tabs the same way it collapses spaces (tab is one of
        # bash's IFS-whitespace characters even when IFS is set to it alone),
        # so an empty middle field here silently ate the delimiter and shifted
        # every field after it by one -- confirmed directly, count read back
        # empty for a destination with exactly one artifact.
        jq -r '.destinations[] |
            "\(.id)\t\(.path // "-")\t\(.state)\t\(.error // "-")\t\(.artifacts | length)"' <<<"$doc" \
        | while IFS=$'\t' read -r id path state err count; do
            [[ "$path" == "-" ]] && path=""
            [[ "$err" == "-" ]] && err=""
            case "$state" in
                ok)          printf '  %s%-11s%s %s %s(%s artifact%s)%s\n' \
                                 "$GREEN" "$id" "$NC" "$(_tilde "$path")" "$DIM" "$count" \
                                 "$([[ "$count" == 1 ]] || echo s)" "$NC" ;;
                empty)       printf '  %s%-11s%s %s %s(no artifacts yet)%s\n' \
                                 "$DIM" "$id" "$NC" "$(_tilde "$path")" "$DIM" "$NC" ;;
                unreachable) printf '  %s%-11s%s %s %sunreachable: %s%s\n' \
                                 "$RED" "$id" "$NC" "$(_tilde "$path")" "$RED" "$err" "$NC" ;;
                list-failed) printf '  %s%-11s%s %s %scould not list: %s%s\n' \
                                 "$RED" "$id" "$NC" "$(_tilde "$path")" "$RED" "$err" "$NC" ;;
            esac
            # Every artifact this destination reports, valid or not -- the
            # count above already includes invalid ones (a manifest that
            # cannot be read does not make the file disappear from the
            # destination), so the listing below must not silently drop them
            # either. A review round caught exactly this: "(2 artifacts)"
            # over a single visible row.
            jq -r --arg id "$id" \
                '.destinations[] | select(.id == $id) | .artifacts[] |
                if .valid then "    \(.file)\t\(.host // "?")\t\(.omarchy.version // "?")\t\(.createdAt // "?")\tok"
                else "    \(.file)\t-\t-\t-\tinvalid: \(.error // "unknown")" end' \
                <<<"$doc" 2>/dev/null | while IFS=$'\t' read -r f host ver created ok; do
                [[ -n "$f" ]] || continue
                if [[ "$ok" == ok ]]; then
                    printf '    %s%s%s  %s  omarchy %s  %s\n' "$DIM" "$f" "$NC" "$host" "$ver" "$created"
                else
                    printf '    %s%s%s  %s%s%s\n' "$DIM" "$f" "$NC" "$RED" "$ok" "$NC"
                fi
            done
        done
    fi
}

# ── entry point ──────────────────────────────────────────────────────────────
source "$OMABACKUP_ROOT/lib/probes.sh"
source "$OMABACKUP_ROOT/lib/plugin-capture.sh"
source "$OMABACKUP_ROOT/lib/publish.sh"
source "$OMABACKUP_ROOT/lib/bundle.sh"
source "$OMABACKUP_ROOT/lib/destinations.sh"
source "$OMABACKUP_ROOT/lib/secrets.sh"
source "$OMABACKUP_ROOT/lib/restore.sh"
source "$OMABACKUP_ROOT/lib/artifacts.sh"
source "$OMABACKUP_ROOT/lib/schedule.sh"
source "$OMABACKUP_ROOT/lib/tui.sh"
source "$OMABACKUP_ROOT/lib/log.sh"
source "$OMABACKUP_ROOT/lib/config.sh"

CMD="${1:-}"; shift || true

# An EXIT trap, not a post-call wrapper that logs after cmd_* returns: die()
# (above) calls `exit 1` directly, so a wrapper of that shape would never
# run for anything that fails via die -- which is most real failures in
# this codebase. Found by design review (herdr-ask round omabackup-10)
# against an earlier draft that logged this way.
#
# LOG_POLICY is decided in two passes, not one. This first pass, from $CMD
# alone, runs before ANY argument parsing (which can die() too) and applies
# OMABACKUP_LOG_SKIP immediately -- found by review (round omabackup-23,
# fixing an incomplete first attempt from round omabackup-22): parking
# every command at a single `failure` default until after parsing meant a
# `--groups`-parse-time die() on an `always`-policy command like `sync`
# stayed misclassified as `failure` -- coalesced against verify/status's
# unrelated state instead of logging every time the way `sync` is supposed
# to -- and OMABACKUP_LOG_SKIP checked only after parsing meant a
# systemd-timer run that somehow died during parsing still wrote to the
# file log despite the opt-out. A second pass below, once ARGS is known,
# only narrows this for config/restore's own sub-command distinctions,
# which $CMD alone cannot decide -- it never has to invent a policy from
# nothing the way a single post-parse assignment did.
_log_policy_for_cmd() {
    case "$1" in
        sync|push|collect|install|enable|disable|bundle|reload) printf always ;;
        verify|status|restore|config) printf failure ;;
        version|artifacts|help|log-event|kill-group|"") printf never ;;
        # Anything else reaches the final `die "unknown command"` below --
        # still a real failure worth logging under whatever the user typed.
        *) printf failure ;;
    esac
}
LOG_POLICY="$(_log_policy_for_cmd "$CMD")"
LOG_ACTION="$CMD"
[[ -n "${OMABACKUP_LOG_SKIP:-}" ]] && LOG_POLICY=never
_log_dispatch_signal=""
_log_dispatch_start=$EPOCHSECONDS
_log_dispatch_exit() {
    local rc="$1"
    case "$LOG_POLICY" in
        always)  _log_run_always "$LOG_ACTION" "$rc" "$(( EPOCHSECONDS - _log_dispatch_start ))" "$_log_dispatch_signal" ;;
        failure) _log_run_on_failure "$LOG_ACTION" "$rc" "$_log_dispatch_signal" ;;
    esac
}
trap '_log_dispatch_exit "$?"' EXIT
# Real signals, not just die()'s own `exit 1` -- found by review (round
# omabackup-22, reproduced live): with no trap of its own, an unhandled
# INT/TERM/HUP on a command run by hand (a Ctrl-C, or a closed terminal --
# outside any TUI wrapper) reaches the EXIT trap with whatever `$?` was
# set to BEFORE the signal arrived, which bash reports as 0 there. That
# means an interrupted `sync` used to log a false "ok" -- exactly the
# class of error this project treats as the worst a backup tool can make.
# Mirrors bin/omabackup-tui's own HUP/INT/TERM traps (129/130/143) so the
# panel-launched and the hand-run paths agree on what a signal means.
_log_dispatch_on_signal() {
    _log_dispatch_signal="$1"
    exit "$2"
}
trap '_log_dispatch_on_signal HUP 129' HUP
trap '_log_dispatch_on_signal INT 130' INT
trap '_log_dispatch_on_signal TERM 143' TERM

# Two levels: the loop below owns only what every command understands and
# hands the rest, in order, to the command itself. It used to consume and shift
# everything, which made `sync --commit` doubly impossible -- it died here as an
# unknown flag, and even past that the shifting left $# at zero, so cmd_sync
# was always called with an empty string and could never take the branch.
ARGS=()
while (($#)); do
    case "$1" in
        --json)   JSON=1; shift ;;
        # `shift 2` with one argument left fails, so $# never reaches zero and
        # the loop spins forever. A flag is never a value either, or
        # `--groups --commit` swallows the command's own flag in silence.
        --groups)
            (($# >= 2)) && [[ "$2" != -* ]] || die "--groups needs a value"
            ONLY="$2"; shift 2 ;;
        -h|--help) CMD=help; LOG_POLICY=never; LOG_ACTION=help; shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done

# A command with no flags of its own still has to refuse, or `verify --commit`
# would look like it did something.
reject_flags() { local c="$1"; shift; (($# == 0)) || die "unknown flag for $c: $1"; }

# Second pass: only narrows the coarse policy above for config/restore's
# own sub-command distinctions, which $CMD alone cannot decide. Everything
# else's policy is already final and immune to whatever these two branches
# do -- the `sync --groups` gap this replaced is closed by never leaving
# `sync` at a placeholder in the first place.
case "$CMD" in
    restore)
        if [[ " ${ARGS[*]} " == *" --apply "* ]]; then
            LOG_POLICY=always
        elif (( ${#ARGS[@]} == 0 )); then
            # Bare `restore` opens the interactive TUI directly -- a
            # DIFFERENT action name than a specific artifact preview/apply
            # call below (found by review: sharing "restore" let the outer
            # session's own eventual "ok" overwrite an inner preview's
            # "failed", or coalesce away a second same-day interruption
            # that has nothing to do with the first).
            LOG_ACTION="restore (interactive)"
            if [[ -n "${OMABACKUP_TUI_SUPERVISED:-}" ]]; then
                # Launched by bin/omabackup-tui, which already logs this
                # exact session via its own post-exit `log-event` call --
                # self-logging here too would double it (found by review).
                LOG_POLICY=never
            fi
        fi
        # else: an artifact path with no --apply (a preview call, whether
        # standalone or from inside the interactive TUI above) stays at
        # the coarse pass's `failure` -- a refused/failed preview (e.g.
        # "this artifact does not verify -- refusing to restore from it")
        # is one of the most useful lines this tool produces; only a
        # successful, read-only preview -- run on every backup browsed in
        # the Restore TUI -- is skipped.
        ;;
    config)
        case "${ARGS[0]:-}" in
            # `show`/`validate` are what the interactive TUI re-runs on
            # every single redraw; logging those would flood the log with
            # no new information.
            show|validate) LOG_POLICY=never ;;
            set|destination) LOG_POLICY=always; LOG_ACTION="config ${ARGS[0]}" ;;
            "")
                # Bare `config` opens the interactive TUI directly -- not
                # necessarily through the panel's bin/omabackup-tui
                # wrapper (found by review: the agreed scope is "any
                # command run by hand", which this was still missing).
                LOG_ACTION="config (interactive)"
                if [[ -n "${OMABACKUP_TUI_SUPERVISED:-}" ]]; then
                    # Same reasoning as restore above: the wrapper's own
                    # log-event call already covers this exact session.
                    LOG_POLICY=never
                fi
                ;;
        esac
        ;;
esac
# Known limitation, documented not fixed (round omabackup-24 review,
# omabackup-rev's P2): unlike `sync --groups`, which is classified
# `always` by the coarse pass above from $CMD alone, `config set --groups`
# and `restore --apply --groups` still need THIS second pass -- which
# only runs after the while-loop below has finished -- to be reclassified
# from the coarse `failure` default to `always`. A `--groups` value
# missing die()s inside that same loop, before this pass ever runs, so
# that one parse mistake is logged under `failure`'s coalescing instead of
# `always`: a first observation still writes once, but a REPEATED same
# mistake coalesces away instead of logging every time the way a `sync`
# parse failure now correctly does. Lower severity than a false "ok" --
# this reduces visibility on a repeated rare user mistake, it does not
# misreport an outcome -- and left for a dedicated pass rather than a
# quick patch to dispatch/signal-adjacent code at the end of a correction
# cycle already at its 2-round budget.
# Re-applied, not just relied on from the coarse pass above: neither
# branch above is reachable in practice with OMABACKUP_LOG_SKIP set (only
# the systemd units set it, and they only ever run sync/push), but
# `config set`/`destination` unconditionally assigning `always` would
# silently win over it if that ever changed.
[[ -n "${OMABACKUP_LOG_SKIP:-}" ]] && LOG_POLICY=never

# `log-event` is exempt from the manifest checks below -- found by review:
# it is the wrapper's own post-exit notification, called precisely when
# something (a missing manifest included) already went wrong, and dying
# here on that same missing manifest would silence the one call meant to
# report it. `kill-group` is exempt for the same shape of reason: it takes
# a bare pid, has nothing to do with backup groups (an unrelated meaning
# of "group" from the process kind this command actually kills), and is
# spawned by the panel specifically to recover from something already
# going wrong -- it must not itself refuse over a manifest problem that
# has nothing to do with the process it was asked to stop.
if [[ "$CMD" != log-event && "$CMD" != kill-group ]]; then
    [[ -f "$GROUPS_FILE" ]] || die "group manifest not found: $GROUPS_FILE"
    # restore validates --groups against the ARTIFACT's manifest, not this
    # machine's -- a group name valid for one is not necessarily valid for
    # the other, and checking here against the wrong file would refuse a
    # legitimate artifact-only group or accept a machine-only one that
    # means nothing to it.
    if [[ "$CMD" != restore ]]; then
        bad="$(_assert_groups_filter_understood)" \
            || die "--groups names a group this manifest does not have: $bad"
    fi
fi

case "$CMD" in
    version)  cmd_version "${ARGS[@]}" ;;
    verify)  reject_flags verify "${ARGS[@]}"; cmd_verify ;;
    collect) reject_flags collect "${ARGS[@]}"; cmd_collect ;;
    sync)    cmd_sync "${ARGS[@]}" ;;
    install) cmd_install "${ARGS[@]}" ;;
    reload)  cmd_reload "${ARGS[@]}" ;;
    enable)  cmd_enable enable "${ARGS[@]}" ;;
    disable) cmd_enable disable "${ARGS[@]}" ;;
    bundle)  cmd_bundle "${ARGS[@]}" ;;
    push)    cmd_push "${ARGS[@]}" ;;
    status)  reject_flags status "${ARGS[@]}"; cmd_status ;;
    restore) cmd_restore "${ARGS[@]}" ;;
    artifacts) cmd_artifacts "${ARGS[@]}" ;;
    config)    cmd_config "${ARGS[@]}" ;;
    log-event) cmd_log_event "${ARGS[@]}" ;;
    kill-group) cmd_kill_group "${ARGS[@]}" ;;
    ""|help)
        cat <<'USAGE'
omabackup <command> [--json] [--groups a,b]

  version   print the installed OmaBackup version
  status    Omarchy identity, restore range and groups
  reload    update the installed plugin and restart the shell onto it
  enable    start the timers -- the master switch
  disable   stop them; nothing runs until enable
  collect   collect the groups into staging (does not touch the repo)
  verify    check that the backup covers what the system actually reads
  artifacts list what a `dir` destination holds, with each one's own manifest
  restore   plan a restore from an artifact; no file opens a guided TUI
  config    show or safely edit machine-owned settings; no args opens its TUI

The full cycle is collect -> diff -> verify -> commit. `collect` and `verify`
are the first two; without them there is no diff for mode:copy groups and
nothing would ever be saved.
USAGE
        ;;
    *) die "unknown command: $CMD" ;;
esac
