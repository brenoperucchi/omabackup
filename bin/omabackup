#!/bin/bash
# omabackup -- dotfile backup with verified coverage and a declared restore
# range. The heavy lifting lives here, outside QML: an error inside quickshell
# takes down the bar, the dock and the menu at once, and restoring has to work
# when there is no shell at all.
#
# Usage: omabackup <collect|verify|status> [--json] [--groups a,b]

set -uo pipefail

OMABACKUP_ROOT="${OMABACKUP_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OMABACKUP_STATE="${OMABACKUP_STATE:-$HOME/.local/state/omabackup}"
GROUPS_FILE="${OMABACKUP_GROUPS:-$OMABACKUP_ROOT/groups.default.json}"
STAGING="$OMABACKUP_STATE/staging"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; DIM=$'\033[2m'; NC=$'\033[0m'

JSON=0; ONLY=""
FINDINGS=()   # level\tgroup\tcode\tmessage\tpath

die() { printf '%somabackup: %s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }

_tilde() { printf '%s' "${1/#$HOME/\~}"; }
_expand() { printf '%s' "${1/#\~/$HOME}"; }

finding() {
    FINDINGS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"${5:-}")
}

# ── group manifest ───────────────────────────────────────────────────────────
groups_ids() {
    jq -r --arg only "$ONLY" '
        .groups
        | map(select(.enabled != false))
        | map(select($only == "" or (.id | inside($only))))
        | .[].id' "$GROUPS_FILE"
}
group_field() { jq -r --arg id "$1" --arg f "$2" '.groups[] | select(.id==$id) | .[$f] // empty' "$GROUPS_FILE"; }
group_paths() {
    jq -r --arg id "$1" '.groups[] | select(.id==$id) |
        (.paths // [])[] | if type=="object" then .live else . end' "$GROUPS_FILE"
}
# The repo subdirectory a trackedOnly path should be checked against, e.g.
# ~/.local/bin -> scripts/local-bin. Empty when the entry has no override.
group_tracked_repo_path() {
    jq -r --arg id "$1" --arg live "$2" '.groups[] | select(.id==$id) |
        (.paths // [])[] | select(type=="object" and .live==$live) | .trackedRepoPath // empty' "$GROUPS_FILE"
}

# The staging -> repo mapping for every path the manifest gave a
# trackedRepoPath, as `<prefix-relative-to-HOME>\t<repo-path>` lines handed to
# publish_staging. The manifest is the single source of truth for where a
# tracked-only path lands: lib/publish.sh used to repeat one of these
# destinations as a literal and refuse the rest, which dropped the whole
# `scripts` group between staging and the repo without a word. `restore` needs
# the inverse of this table, and an inverse only exists if there is one table.
tracked_path_map() {
    local id p sub e
    while read -r id; do
        [[ -n "$id" ]] || continue
        while read -r p; do
            [[ -n "$p" ]] || continue
            sub="$(group_tracked_repo_path "$id" "$p")"
            [[ -n "$sub" ]] || continue
            e="$(_expand "$p")"
            printf '%s\t%s\n' "${e#$HOME/}" "$sub"
        done < <(group_paths "$id")
    done < <(groups_ids)
}

# Every path declared by any group, expanded. Probes use this to answer
# "is this file covered by anyone?".
all_declared_paths() {
    local p
    jq -r '(.groups[] | (.paths // [])[])' "$GROUPS_FILE" | while read -r p; do _expand "$p"; echo; done
}

# Deliberate exclusions: known dead weight, each with a versioned reason.
# Without this the checker starts out with a dozen warnings and teaches you to
# ignore it.
all_excluded_paths() {
    local p
    jq -r '(.excluded // [])[].path' "$GROUPS_FILE" | while read -r p; do _expand "$p"; echo; done
}

is_excluded() {
    local target="$1" ex
    while read -r ex; do
        [[ -n "$ex" ]] || continue
        [[ "$target" == "$ex" || "$target" == "$ex"/* ]] && return 0
    done < <(all_excluded_paths)
    return 1
}

is_covered() {
    local target="$1" decl
    while read -r decl; do
        [[ -n "$decl" ]] || continue
        [[ "$target" == "$decl" || "$target" == "$decl"/* ]] && return 0
    done < <(all_declared_paths)
    return 1
}

# ── verify ───────────────────────────────────────────────────────────────────
# A declared path that does not exist means the group reports "up to date" while
# covering zero bytes. That is how ~/.config/omarchy/current became a phantom
# after one of Omarchy's own migrations moved the directory.
probe_declared_paths() {
    local id p e
    while read -r id; do
        [[ -n "$id" ]] || continue
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || finding warn "$id" path-missing "declared but missing: $p" "$e"
        done < <(group_paths "$id")
    done < <(groups_ids)
}

# A mode:link path that stopped being a symlink stopped feeding the repo, in
# silence. The repair is NEVER `ln -sf`: that would discard the very edit that
# broke the link. See docs/DESIGN.md §11.2.
probe_link_integrity() {
    local id p e linked plain
    while read -r id; do
        [[ "$(group_field "$id" mode)" == "link" ]] || continue
        linked=0; plain=0
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" ]] || continue
            if [[ -L "$e" ]]; then
                linked=$((linked + 1))
            else
                plain=$((plain + 1))
            fi
        done < <(group_paths "$id")
        if (( linked > 0 && plain > 0 )); then
            finding fail "$id" link-broken "$plain of $((linked+plain)) stopped being links -- the repo stopped receiving" ""
        elif (( linked > 0 )); then
            finding pass "$id" linked "$linked paths linked to the repo" ""
        elif (( plain > 0 )); then
            finding info "$id" not-linked "$plain paths, link mode not applied yet" ""
        fi
    done < <(groups_ids)
}

omarchy_identity() {
    local v c m
    v="$(omarchy-version 2>/dev/null || echo unknown)"
    c="$(omarchy-channel-current 2>/dev/null || echo unknown)"
    m="$(find "$HOME/.local/state/omarchy/migrations" -maxdepth 1 -type f -name '*.sh' -printf '%f\n' 2>/dev/null \
         | sed 's/\.sh$//' | sort -n | tail -1)"
    printf '%s\t%s\t%s' "$v" "$c" "${m:-0}"
}

# Group-specific probes are dispatched from the group's `probe` field rather
# than called as a fixed block: a manifest that does not declare the `shell`
# group must not be failed for having no shell.json.
cmd_verify() {
    probe_declared_paths

    local id probe
    while read -r id; do
        [[ -n "$id" ]] || continue
        probe="$(group_field "$id" probe)"
        case "$probe" in
            hypr-lua)   probe_hypr ;;
            shell-json) probe_shell_json ;;
            plugins)    probe_plugins ;;
            migrations) probe_migrations ;;
            packages)   probe_packages ;;
            "")         ;;
            *)          finding warn "$id" probe-unknown "probe declared but not implemented: $probe" "" ;;
        esac
    done < <(groups_ids)

    probe_link_integrity
    report
}

report() {
    local pass=0 warn=0 fail=0 line lvl
    for line in "${FINDINGS[@]:-}"; do
        [[ -n "$line" ]] || continue
        lvl="${line%%$'\t'*}"
        case "$lvl" in pass) pass=$((pass+1));; warn) warn=$((warn+1));; fail) fail=$((fail+1));; esac
    done

    local ov oc om; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"

    if (( JSON )); then
        printf '%s\n' "${FINDINGS[@]:-}" | jq -R -s --arg v "$ov" --arg c "$oc" --arg m "$om" \
            --argjson pass "$pass" --argjson warn "$warn" --argjson fail "$fail" '
            split("\n") | map(select(length>0) | split("\t")
              | {level:.[0], group:.[1], code:.[2], message:.[3], path:(.[4] // "")})
            | {schemaVersion:1,
               omarchy:{version:$v, channel:$c, migrationWatermark:$m},
               ok:($fail == 0),
               counts:{pass:$pass, warn:$warn, fail:$fail},
               findings:.}'
    else
        printf '%som%s %s - channel %s - migration %s\n\n' "$DIM" "$NC" "$ov" "$oc" "$om"
        for line in "${FINDINGS[@]:-}"; do
            [[ -n "$line" ]] || continue
            IFS=$'\t' read -r lvl grp code msg _ <<<"$line"
            case "$lvl" in
                pass) printf '  %s✓%s %-11s %s\n' "$GREEN" "$NC" "$grp" "$msg" ;;
                info) printf '  %s·%s %-11s %s%s%s\n' "$DIM" "$NC" "$grp" "$DIM" "$msg" "$NC" ;;
                warn) printf '  %s!%s %-11s %s\n' "$YELLOW" "$NC" "$grp" "$msg" ;;
                fail) printf '  %s✗%s %-11s %s\n' "$RED" "$NC" "$grp" "$msg" ;;
            esac
        done
        printf '\n  %d ok - %s%d warning%s - %s%d failure%s\n' \
            "$pass" "$YELLOW" "$warn" "$NC" "$RED" "$fail" "$NC"
    fi
    (( fail == 0 ))
}

# ── collect ──────────────────────────────────────────────────────────────────
# Manifest fields the collector knows how to honor. A field that is declared but
# not implemented gets ignored in silence -- that is how the first version
# copied 6.6MB of third-party plugin code despite mode:triple, and 62MB of
# node_modules despite exclude. Same shape as the bug recorded in
# docs/CONTEXT.md §4: "a generic loop overrides specific handling".
KNOWN_FIELDS='["id","label","mode","coupled","critical","paths","probe","enabled","exclude","generator","allowList","note"]'
KNOWN_MODES='["link","copy","gen","triple"]'

assert_manifest_understood() {
    local bad line
    local path_fields='["live","trackedRepoPath"]'
    bad="$(jq -r --argjson k "$KNOWN_FIELDS" --argjson m "$KNOWN_MODES" --argjson pf "$path_fields" '
        [ (.groups[] | . as $g | (keys[] | select(. as $f | $k | index($f) | not)
            | "unknown field \(.) in group \($g.id)"))
        , (.groups[] | select(.mode as $x | $m | index($x) | not)
            | "unknown mode \(.mode) in group \(.id)")
        , (.groups[] | . as $g | ((.paths // [])[] | select(type=="object") | keys[]
            | select(. as $f | $pf | index($f) | not))
            | "unknown path field \(.) in group \($g.id)")
        ] | .[]' "$GROUPS_FILE")"
    [[ -z "$bad" ]] && return 0
    printf '%somabackup: the manifest declares what the collector cannot honor:%s\n' "$RED" "$NC" >&2
    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<<"$bad"
    exit 1
}

# A pattern like "node_modules/**" drops the contents but rsync keeps the empty
# directory. Empty directories in a backup are noise, so the form without /**
# goes along with it.
_emit_exclude() {
    local pat="$1"
    [[ -n "$pat" ]] || return 0
    printf -- '--exclude\n%s\n' "$pat"
    [[ "$pat" == */\*\* ]] && printf -- '--exclude\n%s\n' "${pat%/\*\*}"
    return 0
}

# _rsync_excludes <group-id> <transfer-root>
# rsync matches exclude patterns against paths relative to the root of the
# transfer, so the root is required to translate anything written as a full
# path. A group's own `exclude` entries are already relative ("node_modules/**")
# and pass through untouched; the manifest-wide `excluded` list is written as
# full paths and used to be handed over with only the leading `~/` stripped,
# which produced patterns like `.config/nvim/lazy-lock.json` that could never
# match under a root of `~/.config/nvim`. The file the manifest called
# "constant diff noise" was therefore backed up on every single run.
_rsync_excludes() {
    local id="$1" root="${2:-}" pat ex
    while read -r pat; do _emit_exclude "$pat"; done \
        < <(jq -r --arg id "$id" '.groups[]|select(.id==$id)|(.exclude // [])[]' "$GROUPS_FILE")
    [[ -n "$root" ]] || return 0
    root="${root%/}"
    while read -r pat; do
        [[ -n "$pat" ]] || continue
        ex="$(_expand "$pat")"
        # Only what actually lives under this transfer, anchored with a leading
        # slash so it cannot also match a same-named file deeper in the tree.
        [[ "$ex" == "$root"/* ]] || continue
        _emit_exclude "/${ex#"$root"/}"
    done < <(jq -r '(.excluded // [])[].path' "$GROUPS_FILE")
}

# Collects into staging, NEVER straight into the repo. This is the first of four
# beats (collect -> diff -> verify -> commit): without staging there is no diff
# for mode:copy groups, and the cycle would close on itself. See docs/DESIGN.md §11.1.
cmd_collect() {
    assert_manifest_understood
    # Staging represents "what should be backed up right now", not an
    # accumulating cache: without wiping it first, a path a group used to
    # declare (or a name a trackedOnly path used to match) lingers forever and
    # publish_staging happily republishes it. Proven by the desktop group's
    # first run, before trackedRepoPath existed, leaving 63 stray files behind
    # that a later, correct collect kept finding and republishing.
    rm -rf "$STAGING"
    mkdir -p "$STAGING"
    local id mode p e dest n=0
    while read -r id; do
        [[ -n "$id" ]] || continue
        mode="$(group_field "$id" mode)"
        case "$mode" in
            gen)    collect_generated "$id"; continue ;;
            triple) collect_triple "$id"; continue ;;
        esac

        local -a ex=()

        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || continue
            # A path both declared by a group and listed in `excluded` is the
            # manifest contradicting itself. The exclusion wins: translating
            # patterns only ever covered descendants of the transfer root, so
            # naming the root itself used to be resolved silently in favour of
            # copying the whole thing.
            if is_excluded "$e"; then
                finding info "$id" path-excluded "declared but excluded on purpose: $p" "$e"
                continue
            fi
            dest="$STAGING/${e#$HOME/}"
            mkdir -p "$(dirname "$dest")"
            # Per path, not per group: the exclude patterns have to be relative
            # to the directory rsync is about to walk.
            mapfile -t ex < <(_rsync_excludes "$id" "$e")
            # Tracked-only is a per-path decision, not a per-group one: a
            # group can mix a directory that should only pull already-tracked
            # names (desktop entries) with a plain file that should always
            # copy (mimeapps.list).
            if [[ -n "$(group_tracked_repo_path "$id" "$p")" ]]; then
                collect_tracked_only "$e" "$dest" "$id" "$p" || continue
            elif [[ -d "$e" && ! -L "$e" ]]; then
                rsync -a --exclude '.git/' "${ex[@]}" "$e/" "$dest/"
            else
                rsync -a "$e" "$dest"
            fi
            n=$((n + 1))
        done < <(group_paths "$id")
        (( JSON )) || printf '  %s✓%s %s\n' "$GREEN" "$NC" "$id"
    done < <(groups_ids)

    if (( JSON )); then
        jq -n --arg s "$STAGING" --argjson n "$n" '{schemaVersion:1, staging:$s, entries:$n}'
    else
        printf '\n  %d paths in %s\n' "$n" "$(_tilde "$STAGING")"
    fi
}

# The triple strategy: clean git -> URL+sha only; dirty git -> plus a patch;
# no remote -> full copy. Without it staging balloons with third-party code that
# already lives on GitHub, and the local customization (rosakodu.dock's
# slotSize) is lost.
collect_triple() {
    local id="$1" dir p pid n=0
    dir="$(_expand "$(group_paths "$id" | head -1)")"
    [[ -d "$dir" ]] || return 0
    mkdir -p "$STAGING/.plugins/patches" "$STAGING/.plugins/local"
    : >"$STAGING/.plugins/manifest.txt"
    for p in "$dir"/*/; do
        [[ -d "$p" ]] || continue
        pid="$(basename "$p")"; [[ "$pid" == .* ]] && continue
        capture_plugin "$p" "$STAGING/.plugins/patches" "$STAGING/.plugins/local" "$STAGING/.plugins/manifest.txt" >/dev/null
        n=$((n + 1))
    done
    (( JSON )) || printf '  %s✓%s %s %s(%d, triple strategy)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$n" "$NC"
}

# Directories like ~/.local/bin mix your own scripts with mise and npm binaries.
# Only what the destination repo already tracks comes back; with no repo
# configured there is nothing to infer, so it warns and skips instead of
# dragging in 15MB of shims.
#
# "Tracked" means tracked by git, asked of the index -- never `find` over the
# directory. Listing the directory counted anything that happened to land there
# (an editor backup, the output of an aborted run) as tracked, so junk in the
# repo pulled its live counterpart in and then perpetuated itself. Outside a git
# worktree the word has no meaning at all, so that warns and skips rather than
# quietly degrading back to the directory listing.
collect_tracked_only() {
    local live="$1" dest="$2" id="$3" declared="$4" repo="${OMABACKUP_REPO:-}" sub base f n=0
    if [[ -z "$repo" || ! -d "$repo" ]] || ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
        finding warn "$id" no-repo "trackedOnly needs OMABACKUP_REPO to be a git repo; skipped $(_tilde "$live")" "$live"
        (( JSON )) || printf '  %s!%s %s %s(trackedOnly without a git repo: skipped)%s\n' "$YELLOW" "$NC" "$(_tilde "$live")" "$DIM" "$NC"
        return 1
    fi
    sub="$(group_tracked_repo_path "$id" "$declared")"
    mkdir -p "$dest"
    # -z, always: without it git quotes anything outside ASCII, so a tracked
    # `ação.sh` comes back as "scripts/local-bin/a\303\247\303\243o.sh" -- quotes
    # included -- the direct-child test never matches, and the file quietly
    # stops being backed up.
    while IFS= read -r -d '' f; do
        [[ -n "$f" ]] || continue
        base="${f##*/}"
        [[ "$f" == "$sub/$base" ]] || continue   # direct children only: the repo keeps a flat directory
        [[ -f "$live/$base" ]] && { rsync -aL "$live/$base" "$dest/"; n=$((n + 1)); }
    done < <(git -C "$repo" ls-files -z -- "$sub" 2>/dev/null)
    # A declared path the repo tracks nothing under backs up nothing while
    # reporting "up to date" -- the phantom coverage verify exists to shout about.
    (( n > 0 )) || finding warn "$id" tracked-empty "nothing tracked under $sub: $(_tilde "$live") backs up nothing yet" "$live"
    return 0
}

collect_generated() {
    local id="$1" gen; gen="$(group_field "$id" generator)"
    mkdir -p "$STAGING/.generated"
    case "$gen" in
        packages)
            pacman -Qqe >"$STAGING/.generated/pkgs-explicit.txt" 2>/dev/null
            pacman -Qqem >"$STAGING/.generated/pkgs-aur.txt" 2>/dev/null
            pacman -Qqen >"$STAGING/.generated/pkgs-arch.txt" 2>/dev/null ;;
        systemd)
            systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-user.txt"
            systemctl list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-system.txt" ;;
    esac
    (( JSON )) || printf '  %s✓%s %s %s(generated)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$NC"
}

# ── sync ─────────────────────────────────────────────────────────────────────
# The four beats in one command: collect -> publish (staging into the repo
# tree) -> verify -> commit only if the tree is actually dirty and verify
# passes. Same philosophy as sync.sh: publish never runs alone without a
# human able to `git status`/`git diff` before anything is committed --
# --commit is opt-in, everything else always leaves the tree for review.
cmd_sync() {
    local repo="${OMABACKUP_REPO:-}" commit=0
    # sync owns --commit. A global flag loop would have to know every
    # subcommand's vocabulary, and would then accept --commit in silence from
    # `verify` and `status`; restore's --target/--dry-run will want the same.
    while (($#)); do
        case "$1" in
            --commit) commit=1; shift ;;
            *) die "unknown flag for sync: $1" ;;
        esac
    done
    [[ -n "$repo" && -d "$repo/.git" ]] || die "OMABACKUP_REPO must point at a git repo (got: ${repo:-unset})"

    JSON=0 cmd_collect >/dev/null
    local list="$OMABACKUP_STATE/last-publish"
    local n
    n="$(publish_staging "$STAGING" "$repo" "$(tracked_path_map)" "$list")" \
        || die "publish could not write into $(_tilde "$repo") -- refusing to commit a partial backup"
    printf '  %spublished%s %d files into %s\n\n' "$GREEN" "$NC" "$n" "$(_tilde "$repo")"

    local -a published=()
    [[ -s "$list" ]] && mapfile -d '' -t published <"$list"

    # A file published into a path the destination repo ignores was written to
    # somewhere it can never be committed from: the backup reports success and
    # stores nothing. `git add -A` skipped those in silence; a scoped `git add`
    # refuses the entire batch over one of them. Neither is the answer -- drop
    # them from what gets staged and say so, because it is a coverage hole, not
    # a git error. Found by backing up ~/.config/opencode/.gitignore, whose
    # rules then applied inside the dotfiles repo to its own siblings.
    #
    # Ignore rules do not apply to files the repo already tracks, so a tracked
    # path matching .gitignore stages normally and must not be dropped here.
    local -a written=() ignored=()
    local f
    if (( ${#published[@]} )); then
        local -A is_tracked=() is_ignored=()
        while IFS= read -r -d '' f; do is_tracked["$f"]=1; done \
            < <(git -C "$repo" ls-files -z 2>/dev/null)
        while IFS= read -r -d '' f; do
            [[ -n "${is_tracked[$f]:-}" ]] || is_ignored["$f"]=1
        done < <(printf '%s\0' "${published[@]}" | git -C "$repo" check-ignore -z --stdin 2>/dev/null)
        for f in "${published[@]}"; do
            if [[ -n "${is_ignored[$f]:-}" ]]; then ignored+=("$f"); else written+=("$f"); fi
        done
    fi
    if (( ${#ignored[@]} )); then
        finding warn publish repo-ignored \
            "${#ignored[@]} published, then dropped because the repo ignores them (e.g. ${ignored[0]})" \
            "${ignored[0]}"
    fi

    # Verify runs on every sync, once, before any decision about committing.
    # The incident this tool exists for is "nothing changed and the coverage
    # broke" (docs/CONTEXT.md), so returning early on a clean tree without
    # checking is precisely the failure being guarded against -- and the timer
    # (docs/DESIGN.md §11.2) runs with no audience, so broken coverage has to
    # become a failed unit rather than a green backup nobody reads. It runs
    # after publish, never before: the prescribed repair for a link that
    # stopped feeding the repo is to copy the live file in and relink, so
    # blocking publish would block the fix.
    local verified=1
    JSON=0 cmd_verify || verified=0

    if (( ! verified )); then
        printf '\n%somabackup: coverage failed -- not committing%s\n' "$RED" "$NC" >&2
        return 1
    fi

    # Scoped to what publish just wrote: a repo-wide status reports edits the
    # user left mid-review as though this tool had made them. The exit status
    # matters as much as the output -- a git that fails prints nothing, and
    # empty output is indistinguishable from a clean tree, so an unchecked
    # failure here became "up to date" and exit 0.
    local dirty=""
    if (( ${#written[@]} )); then
        dirty="$(git -C "$repo" status --porcelain -- "${written[@]}")" \
            || die "git status failed in $(_tilde "$repo")"
    fi
    if [[ -z "$dirty" ]]; then
        printf '\n  %sup to date%s -- nothing changed since the last sync\n' "$DIM" "$NC"
        return 0
    fi

    printf '\n%s\n' "$dirty" | sed 's/^/  /'

    if (( ! commit )); then
        printf '\n  review with %sgit -C %s status%s / %sdiff%s, then rerun with --commit\n' \
            "$CYAN" "$(_tilde "$repo")" "$NC" "$CYAN" "$NC"
        return 0
    fi

    # Every git call is checked. The script runs under `set -uo pipefail`
    # without -e, so an unchecked failure here fell straight through to
    # "committed" -- the one message a backup tool must never print falsely.
    #
    # Both `add` and `commit` carry the pathspec. Scoping only the add was not
    # enough: `git commit` with no pathspec commits the whole index, so anything
    # the user had already staged rode along under this tool's message. With the
    # pathspec, git builds the commit from HEAD plus these paths alone and
    # leaves the rest of the index exactly as the user left it.
    git -C "$repo" add -- "${written[@]}" \
        || die "git add failed in $(_tilde "$repo")"
    if git -C "$repo" diff --cached --quiet -- "${written[@]}"; then
        printf '  %sup to date%s -- nothing of ours left to commit\n' "$DIM" "$NC"
        return 0
    fi
    git -C "$repo" commit -q \
        -m "omabackup: sync $(date -u '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo now)" \
        -- "${written[@]}" \
        || die "git commit failed in $(_tilde "$repo")"
    printf '  %scommitted%s\n' "$GREEN" "$NC"
}

cmd_status() {
    local ov oc om; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"
    if (( JSON )); then
        jq -n --arg v "$ov" --arg c "$oc" --arg m "$om" --arg s "$STAGING" \
              --argjson t "$(jq '.supportedTargets' "$GROUPS_FILE")" \
              '{schemaVersion:1, omarchy:{version:$v,channel:$c,migrationWatermark:$m},
                supportedTargets:$t, staging:$s}'
    else
        printf '  Omarchy %s (%s) - migration watermark %s\n' "$ov" "$oc" "$om"
        printf '  restore range: %s\n' "$(jq -r '.supportedTargets|join(", ")' "$GROUPS_FILE")"
        printf '  groups: %s\n' "$(groups_ids | wc -l)"
        printf '  staging: %s\n' "$([ -d "$STAGING" ] && _tilde "$STAGING" || echo 'not collected yet')"
    fi
}

# ── entry point ──────────────────────────────────────────────────────────────
source "$OMABACKUP_ROOT/lib/probes.sh"
source "$OMABACKUP_ROOT/lib/plugin-capture.sh"
source "$OMABACKUP_ROOT/lib/publish.sh"

# Two levels: the loop below owns only what every command understands and
# hands the rest, in order, to the command itself. It used to consume and shift
# everything, which made `sync --commit` doubly impossible -- it died here as an
# unknown flag, and even past that the shifting left $# at zero, so cmd_sync
# was always called with an empty string and could never take the branch.
CMD="${1:-}"; shift || true
ARGS=()
while (($#)); do
    case "$1" in
        --json)   JSON=1; shift ;;
        # `shift 2` with one argument left fails, so $# never reaches zero and
        # the loop spins forever. A flag is never a value either, or
        # `--groups --commit` swallows the command's own flag in silence.
        --groups)
            (($# >= 2)) && [[ "$2" != -* ]] || die "--groups needs a value"
            ONLY="$2"; shift 2 ;;
        -h|--help) CMD=help; shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done

# A command with no flags of its own still has to refuse, or `verify --commit`
# would look like it did something.
reject_flags() { local c="$1"; shift; (($# == 0)) || die "unknown flag for $c: $1"; }

[[ -f "$GROUPS_FILE" ]] || die "group manifest not found: $GROUPS_FILE"

case "$CMD" in
    verify)  reject_flags verify "${ARGS[@]}"; cmd_verify ;;
    collect) reject_flags collect "${ARGS[@]}"; cmd_collect ;;
    sync)    cmd_sync "${ARGS[@]}" ;;
    status)  reject_flags status "${ARGS[@]}"; cmd_status ;;
    ""|help)
        cat <<'USAGE'
omabackup <command> [--json] [--groups a,b]

  status    Omarchy identity, restore range and groups
  collect   collect the groups into staging (does not touch the repo)
  verify    check that the backup covers what the system actually reads

The full cycle is collect -> diff -> verify -> commit. `collect` and `verify`
are the first two; without them there is no diff for mode:copy groups and
nothing would ever be saved.
USAGE
        ;;
    *) die "unknown command: $CMD" ;;
esac
