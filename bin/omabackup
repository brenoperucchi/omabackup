#!/bin/bash
# omabackup — backup de dotfiles com cobertura verificada e alcance de
# restauração declarado. O trabalho pesado mora aqui, fora do QML: um erro
# dentro do quickshell derruba a barra, o dock e o menu de uma vez, e a
# restauração precisa funcionar quando não há shell nenhum.
#
# Uso: omabackup <collect|verify|status> [--json] [--groups a,b]

set -uo pipefail

OMABACKUP_ROOT="${OMABACKUP_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
OMABACKUP_STATE="${OMABACKUP_STATE:-$HOME/.local/state/omabackup}"
GROUPS_FILE="${OMABACKUP_GROUPS:-$OMABACKUP_ROOT/groups.default.json}"
STAGING="$OMABACKUP_STATE/staging"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'; DIM=$'\033[2m'; NC=$'\033[0m'

JSON=0; ONLY=""
FINDINGS=()   # nível\tgrupo\tcódigo\tmensagem\tcaminho

die() { printf '%somabackup: %s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }

_tilde() { printf '%s' "${1/#$HOME/\~}"; }
_expand() { printf '%s' "${1/#\~/$HOME}"; }

finding() {
    FINDINGS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4"$'\t'"${5:-}")
}

# ── manifesto de grupos ──────────────────────────────────────────────────────
groups_ids() {
    jq -r --arg only "$ONLY" '
        .groups
        | map(select(.enabled != false))
        | map(select($only == "" or (.id | inside($only))))
        | .[].id' "$GROUPS_FILE"
}
group_field() { jq -r --arg id "$1" --arg f "$2" '.groups[] | select(.id==$id) | .[$f] // empty' "$GROUPS_FILE"; }
group_paths() { jq -r --arg id "$1" '.groups[] | select(.id==$id) | (.paths // [])[]' "$GROUPS_FILE"; }

# Todo caminho declarado por qualquer grupo, expandido. Usado pelas sondas pra
# responder "este arquivo está coberto por alguém?".
all_declared_paths() {
    local p
    jq -r '(.groups[] | (.paths // [])[])' "$GROUPS_FILE" | while read -r p; do _expand "$p"; echo; done
}

# Exclusões deliberadas: peso morto conhecido, com justificativa versionada.
# Sem isto o verificador nasce com uma dúzia de avisos e ensina a ser ignorado.
all_excluded_paths() {
    local p
    jq -r '(.excluded // [])[].path' "$GROUPS_FILE" | while read -r p; do _expand "$p"; echo; done
}

is_excluded() {
    local target="$1" ex
    while read -r ex; do
        [[ -n "$ex" ]] || continue
        [[ "$target" == "$ex" || "$target" == "$ex"/* ]] && return 0
    done < <(all_excluded_paths)
    return 1
}

is_covered() {
    local target="$1" decl
    while read -r decl; do
        [[ -n "$decl" ]] || continue
        [[ "$target" == "$decl" || "$target" == "$decl"/* ]] && return 0
    done < <(all_declared_paths)
    return 1
}

# ── verify ───────────────────────────────────────────────────────────────────
# Caminho declarado que não existe: o grupo reporta "em dia" cobrindo zero
# bytes. Foi assim que ~/.config/omarchy/current ficou fantasma depois de uma
# migração do próprio Omarchy mover o diretório.
probe_declared_paths() {
    local id p e
    while read -r id; do
        [[ -n "$id" ]] || continue
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || finding warn "$id" path-missing "declarado e não existe: $p" "$e"
        done < <(group_paths "$id")
    done < <(groups_ids)
}

# Um caminho em mode:link que deixou de ser symlink parou de alimentar o repo,
# em silêncio. O reparo NUNCA é `ln -sf`: isso apagaria a edição que quebrou o
# link. Ver design §11.2.
probe_link_integrity() {
    local id p e linked plain
    while read -r id; do
        [[ "$(group_field "$id" mode)" == "link" ]] || continue
        linked=0; plain=0
        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" ]] || continue
            if [[ -L "$e" ]]; then
                linked=$((linked + 1))
            else
                plain=$((plain + 1))
            fi
        done < <(group_paths "$id")
        if (( linked > 0 && plain > 0 )); then
            finding fail "$id" link-broken "$plain de $((linked+plain)) deixaram de ser link — o repo parou de receber" ""
        elif (( linked > 0 )); then
            finding pass "$id" linked "$linked caminhos ligados ao repo" ""
        elif (( plain > 0 )); then
            finding info "$id" not-linked "$plain caminhos, modo link ainda não aplicado" ""
        fi
    done < <(groups_ids)
}

omarchy_identity() {
    local v c m
    v="$(omarchy-version 2>/dev/null || echo unknown)"
    c="$(omarchy-channel-current 2>/dev/null || echo unknown)"
    m="$(find "$HOME/.local/state/omarchy/migrations" -maxdepth 1 -type f -name '*.sh' -printf '%f\n' 2>/dev/null \
         | sed 's/\.sh$//' | sort -n | tail -1)"
    printf '%s\t%s\t%s' "$v" "$c" "${m:-0}"
}

# As sondas específicas são despachadas pelo campo `probe` do grupo, não
# chamadas em bloco: um manifesto que não declara o grupo `shell` não deve
# ser reprovado por não ter shell.json.
cmd_verify() {
    probe_declared_paths

    local id probe
    while read -r id; do
        [[ -n "$id" ]] || continue
        probe="$(group_field "$id" probe)"
        case "$probe" in
            hypr-lua)   probe_hypr ;;
            shell-json) probe_shell_json ;;
            plugins)    probe_plugins ;;
            migrations) probe_migrations ;;
            packages)   probe_packages ;;
            "")         ;;
            *)          finding warn "$id" probe-unknown "sonda declarada e não implementada: $probe" "" ;;
        esac
    done < <(groups_ids)

    probe_link_integrity
    report
}

report() {
    local pass=0 warn=0 fail=0 line lvl
    for line in "${FINDINGS[@]:-}"; do
        [[ -n "$line" ]] || continue
        lvl="${line%%$'\t'*}"
        case "$lvl" in pass) pass=$((pass+1));; warn) warn=$((warn+1));; fail) fail=$((fail+1));; esac
    done

    local id; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"

    if (( JSON )); then
        printf '%s\n' "${FINDINGS[@]:-}" | jq -R -s --arg v "$ov" --arg c "$oc" --arg m "$om" \
            --argjson pass "$pass" --argjson warn "$warn" --argjson fail "$fail" '
            split("\n") | map(select(length>0) | split("\t")
              | {level:.[0], group:.[1], code:.[2], message:.[3], path:(.[4] // "")})
            | {schemaVersion:1,
               omarchy:{version:$v, channel:$c, migrationWatermark:$m},
               ok:($fail == 0),
               counts:{pass:$pass, warn:$warn, fail:$fail},
               findings:.}'
    else
        printf '%som%s %s · canal %s · migração %s%s\n\n' "$DIM" "$NC" "$ov" "$oc" "$om" ""
        for line in "${FINDINGS[@]:-}"; do
            [[ -n "$line" ]] || continue
            IFS=$'\t' read -r lvl grp code msg _ <<<"$line"
            case "$lvl" in
                pass) printf '  %s✓%s %-11s %s\n' "$GREEN" "$NC" "$grp" "$msg" ;;
                info) printf '  %s·%s %-11s %s%s%s\n' "$DIM" "$NC" "$grp" "$DIM" "$msg" "$NC" ;;
                warn) printf '  %s!%s %-11s %s\n' "$YELLOW" "$NC" "$grp" "$msg" ;;
                fail) printf '  %s✗%s %-11s %s\n' "$RED" "$NC" "$grp" "$msg" ;;
            esac
        done
        printf '\n  %d ok · %s%d aviso%s · %s%d falha%s\n' \
            "$pass" "$YELLOW" "$warn" "$NC" "$RED" "$fail" "$NC"
    fi
    (( fail == 0 ))
}

# ── collect ──────────────────────────────────────────────────────────────────
# Coleta para staging, NUNCA direto pro repo. É o primeiro dos quatro tempos
# (coletar → diffar → verificar → commitar): sem staging não existe diff para
# grupos em mode:copy, e o ciclo se fecharia em si mesmo. Ver design §11.1.
# Campos do manifesto que o coletor sabe honrar. Um campo declarado e não
# implementado é ignorado em silêncio — que foi como a primeira versão copiou
# 6,6MB de plugin de terceiro apesar do mode:triple, e 62MB de node_modules
# apesar do exclude. Mesmo padrão do bug catalogado no contexto §4:
# "loop genérico atropela lógica específica".
KNOWN_FIELDS='["id","label","mode","coupled","critical","paths","probe","enabled","exclude","trackedOnly","generator","allowList","note"]'
KNOWN_MODES='["link","copy","gen","triple"]'

assert_manifest_understood() {
    local bad line
    bad="$(jq -r --argjson k "$KNOWN_FIELDS" --argjson m "$KNOWN_MODES" '
        [ (.groups[] | . as $g | (keys[] | select(. as $f | $k | index($f) | not)
            | "campo desconhecido \(.) no grupo \($g.id)"))
        , (.groups[] | select(.mode as $x | $m | index($x) | not)
            | "mode desconhecido \(.mode) no grupo \(.id)")
        ] | .[]' "$GROUPS_FILE")"
    [[ -z "$bad" ]] && return 0
    printf '%somabackup: o manifesto declara o que o coletor não honra:%s\n' "$RED" "$NC" >&2
    while IFS= read -r line; do printf '  %s\n' "$line" >&2; done <<<"$bad"
    exit 1
}

# Um caminho fora de qualquer grupo é peso morto ou esquecimento; um caminho
# excluído de propósito não é copiado.
# Um padrão "node_modules/**" tira o conteúdo mas o rsync mantém o diretório
# vazio. Diretório vazio no backup é ruído, então a forma sem /** vai junto.
_emit_exclude() {
    local pat="$1"
    [[ -n "$pat" ]] || return 0
    printf -- '--exclude\n%s\n' "$pat"
    [[ "$pat" == */\*\* ]] && printf -- '--exclude\n%s\n' "${pat%/\*\*}"
    return 0
}

_rsync_excludes() {
    local id="$1" pat
    while read -r pat; do _emit_exclude "$pat"; done \
        < <(jq -r --arg id "$id" '.groups[]|select(.id==$id)|(.exclude // [])[]' "$GROUPS_FILE")
    while read -r pat; do _emit_exclude "${pat/#\~\//}"; done \
        < <(jq -r '(.excluded // [])[].path' "$GROUPS_FILE")
}

cmd_collect() {
    assert_manifest_understood
    mkdir -p "$STAGING"
    local id mode p e dest n=0
    while read -r id; do
        [[ -n "$id" ]] || continue
        mode="$(group_field "$id" mode)"
        case "$mode" in
            gen)    collect_generated "$id"; continue ;;
            triple) collect_triple "$id"; continue ;;
        esac

        local -a ex=(); mapfile -t ex < <(_rsync_excludes "$id")
        local tracked_only; tracked_only="$(group_field "$id" trackedOnly)"

        while read -r p; do
            [[ -n "$p" ]] || continue
            e="$(_expand "$p")"
            [[ -e "$e" || -L "$e" ]] || continue
            dest="$STAGING/${e#$HOME/}"
            mkdir -p "$(dirname "$dest")"
            if [[ "$tracked_only" == "true" ]]; then
                collect_tracked_only "$e" "$dest" || continue
            elif [[ -d "$e" && ! -L "$e" ]]; then
                rsync -a --exclude '.git/' "${ex[@]}" "$e/" "$dest/"
            else
                rsync -a "$e" "$dest"
            fi
            n=$((n + 1))
        done < <(group_paths "$id")
        (( JSON )) || printf '  %s✓%s %s\n' "$GREEN" "$NC" "$id"
    done < <(groups_ids)

    if (( JSON )); then
        jq -n --arg s "$STAGING" --argjson n "$n" '{schemaVersion:1, staging:$s, entries:$n}'
    else
        printf '\n  %d caminhos em %s\n' "$n" "$(_tilde "$STAGING")"
    fi
}

# A estratégia tripla: git limpo → só URL+sha; git sujo → +patch; sem remote →
# cópia integral. Sem isto o staging engorda com código de terceiro que já vive
# no GitHub, e a customização local (o slotSize do rosakodu.dock) se perde.
collect_triple() {
    local id="$1" dir p pid kind n=0
    dir="$(_expand "$(group_paths "$id" | head -1)")"
    [[ -d "$dir" ]] || return 0
    mkdir -p "$STAGING/.plugins/patches" "$STAGING/.plugins/local"
    : >"$STAGING/.plugins/manifest.txt"
    for p in "$dir"/*/; do
        [[ -d "$p" ]] || continue
        pid="$(basename "$p")"; [[ "$pid" == .* ]] && continue
        kind="$(capture_plugin "$p" "$STAGING/.plugins/patches" "$STAGING/.plugins/local" "$STAGING/.plugins/manifest.txt")"
        n=$((n + 1))
    done
    (( JSON )) || printf '  %s✓%s %s %s(%d, estratégia tripla)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$n" "$NC"
}

# Diretórios como ~/.local/bin misturam script próprio com binário de mise e npm.
# Só volta o que o repo de destino já rastreia; sem repo configurado, não se
# adivinha — avisa e pula, em vez de arrastar 15MB de shim.
collect_tracked_only() {
    local live="$1" dest="$2" repo="${OMABACKUP_REPO:-}" base f n=0
    if [[ -z "$repo" || ! -d "$repo" ]]; then
        finding warn scripts no-repo "trackedOnly precisa de OMABACKUP_REPO; $(_tilde "$live") pulado" "$live"
        (( JSON )) || printf '  %s!%s %s %s(trackedOnly sem repo: pulado)%s\n' "$YELLOW" "$NC" "$(_tilde "$live")" "$DIM" "$NC"
        return 1
    fi
    mkdir -p "$dest"
    while read -r f; do
        base="$(basename "$f")"
        [[ -f "$live/$base" ]] && { rsync -aL "$live/$base" "$dest/"; n=$((n + 1)); }
    done < <(find "$repo" -maxdepth 1 -type f 2>/dev/null)
    return 0
}

collect_generated() {
    local id="$1" gen; gen="$(group_field "$id" generator)"
    mkdir -p "$STAGING/.generated"
    case "$gen" in
        packages)
            pacman -Qqe >"$STAGING/.generated/pkgs-explicit.txt" 2>/dev/null
            pacman -Qqem >"$STAGING/.generated/pkgs-aur.txt" 2>/dev/null
            pacman -Qqen >"$STAGING/.generated/pkgs-arch.txt" 2>/dev/null ;;
        systemd)
            systemctl --user list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-user.txt"
            systemctl list-unit-files --state=enabled --no-legend 2>/dev/null \
                | awk '{print $1}' >"$STAGING/.generated/systemd-system.txt" ;;
    esac
    (( JSON )) || printf '  %s✓%s %s %s(gerado)%s\n' "$GREEN" "$NC" "$id" "$DIM" "$NC"
}

cmd_status() {
    local id; IFS=$'\t' read -r ov oc om <<<"$(omarchy_identity)"
    if (( JSON )); then
        jq -n --arg v "$ov" --arg c "$oc" --arg m "$om" --arg s "$STAGING" \
              --argjson t "$(jq '.supportedTargets' "$GROUPS_FILE")" \
              '{schemaVersion:1, omarchy:{version:$v,channel:$c,migrationWatermark:$m},
                supportedTargets:$t, staging:$s, stagingExists:($s|test(".")) }'
    else
        printf '  Omarchy %s (%s) · marca-d%ságua %s\n' "$ov" "$oc" "'" "$om"
        printf '  alcance de restauração: %s\n' "$(jq -r '.supportedTargets|join(", ")' "$GROUPS_FILE")"
        printf '  grupos: %s\n' "$(groups_ids | wc -l)"
        printf '  staging: %s\n' "$([ -d "$STAGING" ] && _tilde "$STAGING" || echo 'ainda não coletado')"
    fi
}

# ── entrada ──────────────────────────────────────────────────────────────────
source "$OMABACKUP_ROOT/lib/probes.sh"
source "$OMABACKUP_ROOT/lib/plugin-capture.sh"

CMD="${1:-}"; shift || true
while (($#)); do
    case "$1" in
        --json)   JSON=1; shift ;;
        --groups) ONLY="${2:-}"; shift 2 ;;
        -h|--help) CMD=help; shift ;;
        *) die "flag desconhecida: $1" ;;
    esac
done

[[ -f "$GROUPS_FILE" ]] || die "manifesto de grupos não encontrado: $GROUPS_FILE"

case "$CMD" in
    verify)  cmd_verify ;;
    collect) cmd_collect ;;
    status)  cmd_status ;;
    ""|help)
        cat <<'USAGE'
omabackup <comando> [--json] [--groups a,b]

  status    identidade do Omarchy, alcance de restauração e grupos
  collect   coleta os grupos para o staging (não toca no repo)
  verify    checa se o backup cobre o que o sistema de fato lê

O ciclo completo é coletar → diffar → verificar → commitar. `collect` e
`verify` são os dois primeiros; sem eles não existe diff para os grupos em
mode:copy e nada seria salvo.
USAGE
        ;;
    *) die "comando desconhecido: $CMD" ;;
esac
