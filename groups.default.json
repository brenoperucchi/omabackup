{
  "schemaVersion": 1,
  "_comment": [
    "mode:    link = the live file IS the repo (no sync step)",
    "         copy = Omarchy rewrites this; stage a copy",
    "         gen  = derived from the system, not a copied file",
    "         triple = plugins only: URL+sha, plus a patch when dirty, full copy without a remote",
    "coupled: true  = tied to the Omarchy version; quarantined on a target outside supportedTargets",
    "         false = restores on any version"
  ],
  "supportedTargets": [
    "3.*",
    "4.*"
  ],
  "excluded": [
    {
      "path": "~/.local/state/omarchy/current/theme",
      "reason": "the theme ships with the Omarchy package; restored from theme.name + omarchy-theme-set. 18MB of wallpaper."
    },
    {
      "path": "~/.local/state/nvim",
      "reason": "lazy.nvim cache, undo history and lockfile; rebuilt by :Lazy sync."
    },
    {
      "path": "~/.config/nvim/lazy-lock.json",
      "reason": "regenerated by lazy.nvim on every sync; constant diff noise."
    }
  ],
  "groups": [
    {
      "id": "compositor",
      "label": "Hyprland",
      "mode": "copy",
      "coupled": true,
      "critical": true,
      "paths": [
        "~/.config/hypr"
      ],
      "probe": "hypr-lua"
    },
    {
      "id": "shell",
      "label": "Omarchy shell",
      "mode": "copy",
      "coupled": true,
      "critical": true,
      "paths": [
        "~/.config/omarchy/shell.json"
      ],
      "probe": "shell-json"
    },
    {
      "id": "plugins",
      "label": "Shell plugins",
      "mode": "triple",
      "coupled": true,
      "critical": true,
      "paths": [
        "~/.config/omarchy/plugins"
      ],
      "probe": "plugins"
    },
    {
      "id": "state",
      "label": "Omarchy state",
      "mode": "copy",
      "coupled": true,
      "critical": true,
      "paths": [
        "~/.local/state/omarchy/toggles",
        "~/.local/state/omarchy/migrations",
        "~/.local/state/omarchy/current/theme.name",
        "~/.local/state/omarchy/current/background"
      ],
      "probe": "migrations"
    },
    {
      "id": "shellrc",
      "label": "User shell",
      "mode": "link",
      "coupled": false,
      "critical": true,
      "paths": [
        "~/.bashrc",
        "~/.bash_profile",
        "~/.inputrc",
        "~/.XCompose"
      ]
    },
    {
      "id": "terminal",
      "label": "Terminal",
      "mode": "link",
      "coupled": false,
      "critical": false,
      "paths": [
        "~/.config/alacritty",
        "~/.config/ghostty",
        "~/.config/kitty",
        "~/.config/tmux",
        "~/.config/starship.toml"
      ]
    },
    {
      "id": "editor",
      "label": "Editors",
      "mode": "link",
      "coupled": false,
      "critical": false,
      "paths": [
        "~/.config/nvim",
        "~/.config/opencode"
      ],
      "exclude": [
        "lazy/**",
        "mason/**",
        "node_modules/**",
        ".git/**"
      ]
    },
    {
      "id": "desktop",
      "label": "Desktop",
      "mode": "copy",
      "coupled": false,
      "critical": false,
      "paths": [
        {
          "live": "~/.local/share/applications",
          "trackedRepoPath": "dotfiles/.local-share-applications"
        },
        "~/.config/mimeapps.list",
        "~/.config/user-dirs.dirs"
      ]
    },
    {
      "id": "scripts",
      "label": "Personal scripts",
      "mode": "copy",
      "coupled": false,
      "critical": false,
      "paths": [
        {
          "live": "~/.local/bin",
          "trackedRepoPath": "scripts/local-bin"
        },
        {
          "live": "~/bin",
          "trackedRepoPath": "scripts/bin"
        }
      ]
    },
    {
      "id": "packages",
      "label": "Packages",
      "mode": "gen",
      "coupled": false,
      "critical": true,
      "generator": "packages",
      "probe": "packages"
    },
    {
      "id": "systemd",
      "label": "Services",
      "mode": "gen",
      "coupled": false,
      "critical": false,
      "generator": "systemd"
    },
    {
      "id": "secrets",
      "label": "Secrets",
      "mode": "copy",
      "coupled": false,
      "critical": false,
      "enabled": false,
      "allowList": [
        "~/.config/rclone/rclone.conf"
      ],
      "note": "age -p is interactive: no timer can refresh this group (docs/DESIGN.md §11.4)"
    }
  ]
}
