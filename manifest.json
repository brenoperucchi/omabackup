{
  "schemaVersion": 1,
  "id": "brenoperucchi.omabackup",
  "name": "OmaBackup",
  "version": "0.4.1",
  "author": "brenoperucchi",
  "license": "MIT",
  "description": "Dotfile backup that tells you when it stopped covering what the system reads, and refuses to restore onto versions it does not know.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaBackup",
    "description": "Backup state: coverage, destinations and restore range",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 900
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Coverage check interval (seconds)",
        "min": 60,
        "max": 86400,
        "step": 60,
        "defaultValue": 900
      }
    ]
  }
}
