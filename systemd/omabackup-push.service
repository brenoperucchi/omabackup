[Unit]
# Separate unit from sync, deliberately. Committing is local and fast; sending
# is slow and fallible. A NAS that is unplugged or an expired GitHub credential
# must not turn the coverage timer red, because a unit whose red means two
# different things is worse than two units -- it trains you to ignore the one
# alarm this project exists to make you not ignore.
Description=OmaBackup: send the backup bundle to its destinations
Documentation=https://github.com/brenoperucchi/omabackup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/omabackup/env
# See omabackup-sync.service's own comment: this run already has a real log
# via journalctl, so it opts out of the file log to avoid duplicating it.
Environment=OMABACKUP_LOG_SKIP=1
ExecStart=%h/.config/omarchy/plugins/brenoperucchi.omabackup/bin/omabackup push

# Flagged by marketplace security review (2026-09-06): with no timeout here,
# an unavailable or hostile configured remote could hold this scheduled
# service indefinitely. `_push_github` (lib/destinations.sh) now bounds the
# `git push` step itself with its own internal timeout, but this is the
# outer, destination-agnostic ceiling covering the whole `push` invocation
# -- every configured destination, not just github -- and it is what
# actually stops systemd from treating the unit as still legitimately
# starting forever. 300s is generous for a slow NAS or a slow remote on top
# of _push_github's own 120s default, while still being a real, finite
# ceiling rather than none at all.
TimeoutStartSec=300

Nice=10
IOSchedulingClass=idle
