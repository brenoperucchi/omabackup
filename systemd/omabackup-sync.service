[Unit]
# The primary mechanism (docs/DESIGN.md §11.2). The QML plugin is its face, not
# its engine: the panel polls `verify --json` read-only, and everything that
# writes happens here, where a failure is visible in `systemctl --user --failed`
# whether or not the shell is running.
Description=OmaBackup: collect, verify and commit dotfile coverage
Documentation=https://github.com/brenoperucchi/omabackup

[Service]
Type=oneshot
# The CLI parses ~/.config/omabackup/env itself through its allow-list. Do not
# import it here: EnvironmentFile would inject every key before the CLI could
# reject policy overrides. The CLI re-pins PATH unconditionally; this is the
# scheduler's matching defence-in-depth default.
Environment=PATH=/usr/bin:/bin
# This run already has a real log -- `journalctl --user -u
# omabackup-sync.service` -- so it opts out of lib/log.sh's own file log,
# which exists for what has no log anywhere else (an interactive TUI
# session, a manual invocation). Without this, the two would duplicate
# every timer-triggered run.
Environment=OMABACKUP_LOG_SKIP=1
ExecStart=%h/.config/omarchy/plugins/brenoperucchi.omabackup/bin/omabackup sync --commit

# `sync` exits non-zero when coverage fails, and that is the whole point: the
# unit goes red and stays red. A backup that reports success while the system
# reads files it does not hold is the failure this project was built after.
SuccessExitStatus=0

Nice=10
IOSchedulingClass=idle
